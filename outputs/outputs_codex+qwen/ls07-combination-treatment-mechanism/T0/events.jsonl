{"type":"item.started","item":{"id":"item_109","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$code = @'\"'\nimport warnings; warnings.filterwarnings(\\\"ignore\\\")\nimport csv, math\nimport pandas as pd, numpy as np\nfrom scipy.stats import hypergeom\n\n# --- inputs ---\ngmt = {}\nfor l in open(\\\"inputs/Reactome_2022.gmt\\\", encoding=\\\"utf-8\\\"):\n    if not l.strip(): continue\n    p = l.rstrip(\\\"\\\\n\\\").split(\\\"\\\\t\\\")\n    gmt[p[0]] = set(p[2:])\nbg = set(x.strip() for x in open(\\\"inputs/Reactome_2022.background.txt\\\", encoding=\\\"utf-8\\\") if x.strip())\n\ndres = pd.read_csv(\\\"output/deseq2_results.csv\\\", index_col=0)\ndegs = dres[(dres[\\\"padj\\\"] < 0.05) & (dres[\\\"log2FoldChange\\\"].abs() >= 1.0)]\nq = set(degs.index) & bg\nprint(\\\"query size in universe k =\\\", len(q))\n\n# --- independent hypergeometric p for every overlapping term + BH ---\nrows = []\nfor term, genes in gmt.items():\n    cat = genes & bg\n    hits = q & cat\n    if not hits: continue\n    x, m, k, M = len(hits), len(cat), len(q), len(bg)\n    p = hypergeom.sf(x - 1, M, m, k)\n    rows.append((term, x, m, p))\nps = np.array([r[3] for r in rows])\norder = np.argsort(ps)\nadj = np.empty_like(ps)\nn = len(ps)\nfor rank_idx, oi in enumerate(order):\n    pass\n# BH\nps_sorted = ps[order]\nadj_sorted = np.minimum.accumulate((ps_sorted / (np.arange(1, n + 1) / n))[::-1])[::-1]\nadj_sorted = np.clip(adj_sorted, 0, 1)\nadj = np.empty(n); adj[order] = adj_sorted\nindep = {rows[i][0]: (rows[i][1], rows[i][2], ps[i], adj[i]) for i in range(n)}\n\ntab = pd.read_csv(\\\"output/pathway_enrichment.csv\\\")\nprint(\\\"CSV rows:\\\", len(tab), \\\"| independent overlapping terms:\\\", len(indep))\nassert len(tab) == len(indep)\n\nmism = 0\nfor _, r in tab.iterrows():\n    x_m = r[\\\"Overlap\\\"].split(\\\"/\\\")\n    x, m = int(x_m[0]), i