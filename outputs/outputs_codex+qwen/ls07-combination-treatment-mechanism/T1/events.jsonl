{"type":"item.started","item":{"id":"item_106","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport json\nimport pandas as pd\nfrom scipy.stats import hypergeom\n\nr = pd.read_csv('output/de_results.csv')\nde = r[(r.padj < 0.05) & (r.log2FoldChange.abs() >= 1)]\nq = set(de.gene_symbol)\n\nbg = [l.strip() for l in open('inputs/Reactome_2022.background.txt') if l.strip()]\nbgset = set(bg)\nN = len(bgset)\nq_in_bg = q & bgset\nk = len(q_in_bg)\n\nterms = {}\nfor line in open('inputs/Reactome_2022.gmt', encoding='utf-8'):\n    p = line.rstrip('\\\\n').split('\\\\t')\n    terms[p[0]] = set(g for g in p[2:] if g)\n\nrows = []\nfor t, genes in terms.items():\n    cat = genes & bgset\n    hits = q_in_bg & cat\n    x = len(hits)\n    if x < 1: continue\n    m = len(cat)\n    rows.append((t, f'{x}/{m}', hypergeom.sf(x - 1, N, m, k)))\nrows.sort(key=lambda z: (z[2], z[0]))\nm_tests = len(rows)\nps = [z[2] for z in rows]\nadj = [0.0]*m_tests\nprev = 1.0\nfor i in range(m_tests-1, -1, -1):\n    prev = min(prev, ps[i]*m_tests/(i+1))\n    adj[i] = min(1.0, prev)\n\ntab = pd.read_csv('output/pathway_enrichment.csv')\ntab2 = tab.sort_values(['P-value','Term']).reset_index(drop=True)\nassert len(tab) == m_tests == 275\n\nbad = 0\nfor i, (t, ov, p) in enumerate(rows):\n    row = tab2.iloc[i]\n    if row['Term'] \"'!= t: bad += 1; print('\"'TERM', t, row['Term']); continue\n    if abs(float(row['P-value']) - p) > max(1e-12, p*1e-6):\n        bad += 1; print('P', t, row['P-value'], p)\n    if abs(float(row['Adjusted P-value']) - adj[i]) > max(1e-12, adj[i]*1e-6):\n        bad += 1; print('ADJ', t, row['Adjusted P-value'], adj[i])\n    if row['Overlap'] \"'!= ov:\n        bad += 1; print('\"'OV', t, row['Overlap'], ov)\nassert bad == 0\nprint('PASS: 275/275 terms match independent hypergeometric + BH recomputation')\n\n# overlap gene identities for top term\nt0 = rows[0][0]\nhits = sorted(q_in_bg & (terms[t0] & bgset))\nprint('top term:', t0, '| overlap genes:', hits)\n\n# odds-ratio and combined-score spot check (Enrichr formula, bu=0.5)\nx, m = 2, 8\noddr = ((x+0.5)*(N-m-k+x+0.5))/((m-x+0.5)*(k-x+0.5))\ncs = -1 * __import__('numpy').log(rows[0][2]) * oddr\nr0 = tab[tab['Term']==t0].iloc[0]\nprint('odds ratio csv', float(r0['Odds Ratio']), 'recomputed', oddr)\nprint('combined csv', float(r0['Combined Score']), 'recomputed', cs)\nassert abs(float(r0['Odds Ratio'])-oddr) < 1e-9 and abs(float(r0['Combined Score'])-cs) < 1e-9\n\nmc = json.load(open('output/mechanism_call.json', encoding='utf-8'))\nreq = ['task','comparison','primary_mechanism','primary_mechanism_detail',\n       'mechanism_evidence','top_pathways','method','causation_note','generated_at']\nassert all(x in mc for x in req)\nprint('PASS: mechanism_call schema; primary =', mc['primary_mechanism'])\nman = json.load(open('output/resource_manifest.json', encoding='utf-8'))\nassert man['term_count']==1818 and man['background_gene_count']==10489\nassert man['verification']['network_used'] is False\nprint('PASS: resource_manifest')\nhdr = open('output/pathway_enrichment.csv', encoding='utf-8').readline().strip()\nassert hdr == 'Term,Overlap,P-value,Adjusted P-value,Odds Ratio,Combined Score,Genes'\nprint('PASS: csv header')\nprint('ALL VALIDATION CHECKS PASSED')\n'@ | Set-Content -Encoding utf8 _tools\\\\validate.py; \"'$sp = '\"'C:\\\\Users\\\\CHENYU~1\\\\DOCUME~1\\\\ChatGPT\\\\生命科~1\\\\LIFESC~1\\\\outputs\\\\OUTPUT~1\\\\LS07-C~2\\\\T1\\\\WORKSP~1'; & \\\"\"'$sp'\"\\\\py312\\\\python.exe\\\" _tools\\\\validate.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
