 = term.lower()\n    for fam, kws in FAMILIES:\n        if any(k in t for k in kws):\n            return fam\n    return \"Other\"\n\ntop = tab.head(15).copy()\ntop[\"family\"] = [classify(t) for t in top[\"Term\"]]\nsigf = sig.copy()\nsigf[\"family\"] = [classify(t) for t in sigf[\"Term\"]]\nif len(sigf):\n    fam_counts = sigf[\"family\"].value_counts()\n    fam_best_p = sigf.groupby(\"family\")[\"Adjusted P-value\"].min()\n    primary_fam = fam_best_p.sort_values().index[0]\nelse:\n    fam_counts = pd.Series(dtype=int)\n    fam_best_p = pd.Series(dtype=float)\n    primary_fam = top[\"family\"].iloc[0]\n\ntop_list = []\nfor _, r in tab.head(10).iterrows():\n    top_list.append({\n        \"term\": r[\"Term\"],\n        \"overlap\": r[\"Overlap\"],\n        \"p_value\": float(r[\"P-value\"]),\n        \"adjusted_p_value\": float(r[\"Adjusted P-value\"]),\n        \"odds_ratio\": float(r[\"Odds Ratio\"]),\n        \"combined_score\": float(r[\"Combined Score\"]),\n        \"genes\": r[\"Genes\"].split(\";\") if isinstance(r[\"Genes\"], str) else [],\n        \"family\": classify(r[\"Term\"]),\n    })\n\nmechanism = {\n    \"task\": \"ls07-combination-treatment-mechanism\",\n    \"comparison\": f\"{TREAT} vs {CONTROL}\",\n    \"primary_mechanism\": primary_fam,\n    \"mechanism_evidence\": {\n        \"n_de_genes\": int(len(de_genes)),\n        \"n_up\": int(len(up)),\n        \"n_down\": int(len(down)),\n        \"de_criteria\": {\"padj_cutoff\": PADJ_CUTOFF,\n                        \"abs_log2fc_cutoff\": L2FC_CUTOFF},\n        \"n_significant_pathways\": int(len(sig)),\n        \"significant_family_counts\": {k: int(v) for k, v in fam_counts.items()},\n    },\n    \"top_pathways\": top_list,\n    \"method\": {\n        \"de\": f\"pydeseq2 {gp.__name__ and __import__('\"'pydeseq2').__version__} \\\"\n              \\\"(DESeq2-style NB GLM), contrast condition \\\"\n              f\\\"{TREAT} vs {CONTROL}\\\",\n        \\\"enrichment\\\": (\\\"gseapy 1.1.4 enrichr, local offline mode; one-sided \\\"\n                       \\\"Fisher exact test against supplied background universe; \\\"\n                       \\\"Benjamini-Hochberg FDR\\\"),\n        \\\"gene_set_library\\\": in_manifest[\\\"resource_name\\\"] + \\\" (frozen GMT)\\\",\n        \\\"background_universe\\\": (\\\"Reactome_2022.background.txt \\\"\n                                f\\\"({len(background)} genes)\\\"),\n    },\n    \\\"causation_note\\\": (\\\"Pathway enrichment identifies over-represented annotated \\\"\n                       \\\"gene sets among differentially expressed genes; it is \\\"\n                       \\\"associative evidence and does not by itself demonstrate \\\"\n                       \\\"causal mechanism.\\\"),\n    \\\"generated_at\\\": datetime.now(timezone.utc).isoformat(timespec=\\\"seconds\\\"),\n}\njson.dump(mechanism, open(os.path.join(BASE, \\\"mechanism_call.json\\\"), \\\"w\\\",\n                          encoding=\\\"utf-8\\\"), indent=2, ensure_ascii=False)\n\n# ------------------------------------------------------ resource manifest\nout_manifest = dict(in_manifest)\nout_manifest[\\\"verification\\\"] = {\n    \\\"verified_at\\\": datetime.now(timezone.utc).isoformat(timespec=\\\"seconds\\\"),\n    \\\"gmt_sha256_verified\\\": True,\n    \\\"background_sha256_verified\\\": True,\n    \\\"mapping_sha256_verified\\\": True,\n    \\\"term_count_verified\\\": True,\n    \\\"background_gene_count_verified\\\": True,\n    \\\"gmt_gene_union_equals_background\\\": True,\n    \\\"recomputed_sha256\\\": sha,\n    \\\"software\\\": {\n        \\\"python\\\": platform.python_version(),\n        \\\"gseapy\\\": gp.__version__,\n        \\\"pydeseq2\\\": __import__(\\\"pydeseq2\\\").__version__,\n        \\\"numpy\\\": np.__version__,\n        \\\"pandas\\\": pd.__version__,\n    },\n    \\\"network_used\\\": False,\n    \\\"policy_compliance\\\": (\\\"No pathway library or identifier mapping was \\\"\n                          \\\"