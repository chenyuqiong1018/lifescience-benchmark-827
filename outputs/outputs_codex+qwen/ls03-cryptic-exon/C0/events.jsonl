+L\n        key=(tag,i)\n        if covers_L and covers_R:\n            cats['spanning_both']+=1; spanning.append((tag,i,p,mm)); jl_reads.add(key); jr_reads.add(key)\n        elif covers_L:\n            cats['J_left_only']+=1; jl_reads.add(key)\n        elif covers_R:\n            cats['J_right_only']+=1; jr_reads.add(key)\n        else:\n            cats['CE_body_or_exon_only']+=1\nprint(cats)\nprint('J_left total reads:',len(jl_reads),' J_right total reads:',len(jr_reads))\nprint('spanning reads:')\nfor t,i,p,mm in spanning: print('  ',t,i,'pos',p,'mm',mm)\n# save read indices\nimport pickle\nwith open('tmp/gng10_reads.pkl','wb') as f:\n    pickle.dump({'jl':sorted(jl_reads),'jr':sorted(jr_reads),'spanning':spanning,'alldone':{t:(ok.tolist(),bp.tolist(),bm.tolist()) for t,(ok,bp,bm) in alldone.items()}},f)\n'@ | Set-Content -Encoding UTF8 tmp/probe23.py; python tmp/probe23.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
