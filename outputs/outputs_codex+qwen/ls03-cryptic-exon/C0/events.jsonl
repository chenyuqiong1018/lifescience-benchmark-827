    hk = np.concatenate(hk_list)
    hp = np.concatenate(hp_list)
    u, inv, c = np.unique(hk, return_inverse=True, return_counts=True)
    keep = c <= CAP
    order = np.argsort(inv, kind="stable")
    starts = np.searchsorted(np.sort(inv), np.arange(len(u) + 1))
    pos_dict = {}
    for i in np.where(keep)[0]:
        pos_dict[int(u[i])] = hp[order[starts[i]:starts[i + 1]]].astype(np.int64)
    log(f"[index] kept {len(pos_dict)} k-mers with <= {CAP} genomic copies "
        f"({time.time()-T0:.0f}s)")
    return pos_dict


# ---------------------------------------------------------------------- #
# 3. screening + placement
# ---------------------------------------------------------------------- #
def keys_at(mat, off, k=K):
    sub = mat[:, off:off + k]
    bad = (sub == 4).any(1)
    kkey = np.zeros(mat.shape[0], dtype=np.uint64)
    for j in range(k):
        kkey |= sub[:, j].astype(np.uint64) << np.uint64(2 * (k - 1 - j))
    kkey[bad] = (1 << 64) - 1
    return kkey


def screen(rseq, pos_dict):
    n = rseq.shape[0]
    rseq_rc = np.where(rseq == 4, 4, 3 - rseq)[:, ::-1].astype(np.uint8).copy()
    SENT = (1 << 64) - 1

    def do(mat):
        h = np.zeros((n, len(OFFS)), dtype=np.int8)
        for oi, off in enumerate(OFFS):
            ks = keys_at(mat, off)
            col = np.zeros(n, dtype=np.int8)
            get = pos_dict.get
            for i in range(n):
                kk = int(ks[i])
                if kk == SENT:
                    continue
                p = get(kk)
                if p is not None:
                    h[i, oi] = min(len(p), 30)
        return h

    h1 = do(rseq)
    h2 = do(rseq_rc)
    s1 = (h1 >= 1).sum(1)
    s2 = (h2 >= 1).sum(1)
    keep = np.where((s1 >= 2) | (s2 >= 2))[0]
    log(f"[screen] kept {len(keep)} reads for placement ({time.time()-T0:.0f}s)")
    return keep, s1, s2, rseq_rc


def seed_positions(row, pos_dict):
    out = []
    for off in OFFS:
        k = 0
        ok = True
        for j in range(K):
            v = row[off + j]
            if v == 4:
                ok = False
                break
            k = (k << 2) | int(v)
        if not ok:
            continue
        p = pos_dict.get(k)
        if p is not None and len(p) <= CAP:
            out.append((off, p))
    return out


def all_placements(row, pos_dict, gcode, arL):
    """Return list of (type, mm, x, y): C=contig at x; J=junction intron (x,y)."""
    G = len(gcode)
    length = len(row)
    seeds = seed_positions(row, pos_dict)
    if len(seeds) < 2:
        return []
    diags = defaultdict(int)
    for off, ps in seeds:
        for pp in ps:
            diags[int(pp) - off] += 1
    top = sorted(diags.items(), key=lambda x: -x[1])
    placements = []
    for d, v in top:
        if v < 3:
            break
        if 0 <= d and d + length <= G:
            mm = int((gcode[d:d + length] != row).sum())
            if mm <= MAXMM:
                placements.append(("C", mm, d, None))
    cand = [d for d, v in top if v >= 1][:10]
    seen = defaultdict(int)
    for i in range(len(cand)):
        for j in range(len(cand)):
            if i == j:
                continue
            d1, d2 = cand[i], cand[j]
            if d1 < 0 or d2 < 0 or d1 + length > G or d2 + length > G:
                continue
            avals = np.arange(MIN_ANCHOR, length - MIN_ANCHOR + 1)
            cols = arL[None, :]
            M = np.where(cols < avals[:, None],
                         gcode[d1:d1 + length][None, :],
                         gcode[d2:d2 + length][None, :])
            mm = (M != row[None, :]).sum(1)
            good = np.where(mm <= MAXMM)[0]
            for gi in good:
                a = int(avals[gi])
                s, e = d1 + a + 1, d2 + a            # 1-based inclusive intron
                if MIN_INTRON <= e - s + 1 <= MAX_INTRON:
                    if (s, e) not in seen or int(mm[gi]) < seen[(s, e)]:
                        seen[(s, e)] = int(mm[gi])
    for (s, e), mm in seen.items():
        placements.append(("J", mm, s, e))
    placements.sort(key=lambda x: x[1])
    return placements


def place_reads(rseq, rseq_rc, keep, s1, s2, pos_dict, gcode):
    length = rseq.shape[1]
    arL = np.arange(length)
    C_uniq = {}                    # idx -> (strand, pos, mm)
    J_uniq = defaultdict(list)     # (s, e, strand) -> [idx]
    ambig = nomap = 0
    for n, idx in enumerate(keep):
        idx = int(idx)
        rows = [(1, rseq[idx])]
        if s2[idx] >= 2:
            rows.append((-1, rseq_rc[idx]))
        allp = []
        for strand, row in rows:
            for typ, mm, x, y in all_placements(row, pos_dict, gcode, arL):
                allp.append((strand, typ, mm, x, y))
        if not allp:
            nomap += 1
            continue
        bestmm = min(p[2] for p in allp)
        best = [p for p in allp if p[2] == bestmm]
        clusters = []
        for st, typ, mm, x, y in best:
            placed = False
            if typ == "C":
                for cl in clusters:
                    if cl[0] == "C" and cl[1] == st and abs(cl[2] - x) <= 3:
                        cl[3].append((x, y, mm))
                        placed = True
                        break
                if not placed:
                    clusters.append(["C", st, x, [(x, y, mm)]])
            else:
                for cl in clusters:
                    if cl[0] == "J" and cl[1] == st and abs(cl[2] - x) <= 4 and abs(cl[3] - y) <= 4:
                        cl[4].append((x, y, mm))
                        placed = True
                        break
                if not placed:
                    clusters.append(["J", st, x, y, [(x, y, mm)]])
        if len(clusters) != 1:
            ambig += 1
            continue
        cl = clusters[0]
        if cl[0] == "C":
            C_uniq[idx] = (cl[1], int(cl[2]), bestmm)
        else:
            J_uniq[(int(cl[2]), int(cl[3]), cl[1])].append(idx)
        if n % 10000 == 0:
            log(f"[place] {n}/{len(keep)} ({time.time()-T0:.0f}s)")
    log(f"[place] contig={len(C_uniq)} junction clusters={len(J_uniq)} "
        f"ambiguous={ambig} nomap={nomap} ({time.time()-T0:.0f}s)")
    return C_uniq, J_uniq


# ---------------------------------------------------------------------- #
# 4. canonicalisation (GT-AG)
# ---------------------------------------------------------------------- #
def canonical_junc(s, e, strand, gcode):
    G = len(gcode)
    cands = []
    for ds in range(-3, 4):
        for de in range(-3, 4):
            ss, ee = s + ds, e + de
            if ss < 2 or ee > G:
                continue
            d = BASE[gcode[ss - 1]] + BASE[gcode[ss]]
            a = BASE[gcode[ee - 2]] + BASE[gcode[ee - 1]]
            if strand == 1:
                if d == "GT" and a == "AG":
                    cands.append((ss, ee))
            else:
                if d == "CT" and a == "AC":
                    cands.append((ss, ee))
    return cands


def canonicalize(J_uniq, gcode):
    J_reads = defaultdict(list)
    for (s, e, st), idxs in J_uniq.items():
        canon = canonical_junc(s, e, st, gcode)
        if len(canon) == 1:
            cs, ce = canon[0]
        else:
            cs, ce = s, e
        J_reads[(int(cs), int(ce), st)].extend(idxs)
    return J_reads


# ---------------------------------------------------------------------- #
# 5. annotation
# ---------------------------------------------------------------------- #
def load_annotation():
    introns = set()
    trans_exons = defaultdict(list)
    genes = {}
    path = os.path.join(WS, "inputs/reference/ensembl112_protein_coding_exons.tsv.gz")
    with gzip.open(path, "rt") as f:
        f.readline()
        for line in f:
            p = line.rstrip("'"\\n\").split(\"\\t\")
            ensg, enst, gname, chrom, s, e, strand, ttype = p
            s, e = int(s), int(e)
            trans_exons[(chrom, enst)].append((s, e, strand, ensg))
            key = (chrom, ensg)
            if key not in genes:
                genes[key] = {\"name\": gname, \"strand\": strand, \"exons\": []}
            genes[key][\"exons\"].append((s, e))
    for (chrom, enst), exs in trans_exons.items():
        ee = sorted(set((a, b) for a, b, _, _ in exs))
        for i in range(len(ee) - 1):
            introns.add((chrom, ee[i][1] + 1, ee[i + 1][0] - 1))
    return introns, trans_exons, genes


# ---------------------------------------------------------------------- #
# 6. cryptic-exon candidate search
# ---------------------------------------------------------------------- #
def find_candidates(J_reads, introns, genes, chrom):
    # novel junction clusters only
    nov = defaultdict(list)
    for (s, e, st), reads in J_reads.items():
        if (chrom, s, e) not in introns:
            nov[st].append((s, e, len(reads)))
    exon_iv = []
    for (c, ensg), gi in genes.items():
        if c "'!= chrom:
            continue
        for s, e in gi["exons"]:
            exon_iv.append((s, e, gi["name"]))
    exon_iv.sort()
    ex_starts = np.array([x[0] for x in exon_iv])

    def overlaps_exon(s, e):
        lo = int(np.searchsorted(ex_starts, s - 1_000_000))
        for j in range(lo, len(exon_iv)):
            a, b, g = exon_iv[j]
            if a > e:
                break
            if b >= s:
                return g
        return None

    cands = []
    for st, lst in nov.items():
        lst.sort()
        for i in range(len(lst)):
            for j in range(i + 1, len(lst)):
                s1, e1, n1 = lst[i]
                s2, e2, n2 = lst[j]
                if e1 < s2 and s2 - e1 <= PAIR_MAXGAP and n1 >= MIN_JUNC_READS and n2 >= MIN_JUNC_READS:
                    cs, ce = e1 + 1, s2 - 1
                    ov = overlaps_exon(cs, ce)
                    if ov is not None:
                        continue
                    host = [v["name"] for (c, _), v in genes.items()
                            if c == chrom and min(a for a, b in v["exons"]) <= cs
                            and max(b for a, b in v["exons"]) >= ce]
                    cands.append({"strand": st, "left": (s1, e1, n1),
                                  "right": (s2, e2, n2), "start": cs, "end": ce,
                                  "host_genes": sorted(set(host))})
    cands.sort(key=lambda c: -(c["left"][2] + c["right"][2]))
    return cands


def pick_host_gene(cand, trans_exons, chrom):
    """Prefer the gene whose transcript exon boundaries match the junction ends."""
    best, bestscore = None, -1
    for (c, enst), exs in trans_exons.items():
        if c != chrom:
            continue
        strand = exs[0][2]
        ensg = exs[0][3]
        ee = sorted(set((a, b) for a, b, _, _ in exs))
        score = 0
        for a, b in ee:
            if b == cand["left"][0] - 1:     # exon ends right before left intron
                score += 1
            if a == cand["right"][1] + 1:    # exon starts right after right intron
                score += 1
        if score > bestscore:
            bestscore = score
            best = (ensg, enst, strand, ee)
    return best, bestscore


# ---------------------------------------------------------------------- #
# 7. splice-site refinement via spliced-reference alignment
# ---------------------------------------------------------------------- #
def scan_ref(mat, T, arL, length, maxmm=MAXMM):
    n = mat.shape[0]
    npos = len(T) - length + 1
    bestpos = np.full(n, -1, dtype=np.int32)
    bestmm = np.full(n, 99, dtype=np.int32)
    chunk = 10000
    for s0 in range(0, n, chunk):
        s1 = min(n, s0 + chunk)
        sub = mat[s0:s1]
        mm_all = np.empty((npos, s1 - s0), dtype=np.int32)
        for p in range(npos):
            mm_all[p] = (T[p:p + length][None, :] != sub).sum(1)
        b = mm_all.argmin(0)
        bm = mm_all[b, np.arange(s1 - s0)]
        bestpos[s0:s1] = np.where(bm <= maxmm, b, -1)
        bestmm[s0:s1] = bm
    return bestpos, bestmm


def refine_candidate(cand, rseq, rseq_rc, gcode, chrom):
    """Enumerate canonical splice-site variants; choose the one whose spliced
    product is supported by the most reads (especially reads spanning both
    junctions)."""
    st = cand["strand"]
    s1, e1, _ = cand["left"]
    s2, e2, _ = cand["right"]
    arL = np.arange(rseq.shape[1])
    length = rseq.shape[1]
    FLANK = 150
    variants = []
    for de1 in range(-3, 4):
        ee1 = e1 + de1
        # acceptor check
        d = BASE[gcode[ee1 - 2]] + BASE[gcode[ee1 - 1]]
        if (st == 1 and d != "AG") or (st == -1 and d != "CT"):
            continue
        for ds2 in range(-3, 4):
            ss2 = s2 + ds2
            dn = BASE[gcode[ss2 - 1]] + BASE[gcode[ss2]]
            if (st == 1 and dn != "GT") or (st == -1 and dn != "AC"):
                continue
            cs, ce = ee1 + 1, ss2 - 1
            if ce - cs + 1 < 10:
                continue
            variants.append((ee1, ss2, cs, ce))
    log(f"[refine] {len(variants)} canonical splice variants")
    best = None
    for ee1, ss2, cs, ce in variants:
        # reference: upstream exon flank + CE + downstream exon flank
        if st == 1:
            up = gcode[s1 - 1 - FLANK:s1 - 1]
            down = gcode[e2:e2 + FLANK]
        else:
            # minus-strand gene: build on forward coords then RC
            up = gcode[e2:e2 + FLANK]
            down = gcode[s1 - 1 - FLANK:s1 - 1]
        T = np.concatenate([up, gcode[cs - 1:ce], down])
        if st == -1:
            T = np.where(T == 4, 4, 3 - T)[::-1].astype(np.uint8)
        B0, B1 = len(up), len(up) + (ce - cs + 1)
        spanning = 0
        sup_l = sup_r = 0
        for mat in (rseq, rseq_rc):
            bp, bm = scan_ref(mat, T, arL, length)
            ok = np.where((bp >= 0) & (bm <= MAXMM))[0]
            for i in ok:
                p = int(bp[i])
                cL = p < B0 < p + length
                cR = p < B1 < p + length
                sup_l += cL
                sup_r += cR
                spanning += cL and cR
        log(f"[refine]   introns ({s1},{ee1}) & ({ss2},{e2}) CE {cs}-{ce}: "
            f"span={spanning} supL={sup_l} supR={sup_r}")
        key = (spanning, sup_l + sup_r)
        if best is None or key > best[0]:
            best = (key, {"intron_left": (s1, ee1), "intron_right": (ss2, e2),
                          "start": cs, "end": ce, "spanning": spanning,
                          "sup_left": sup_l, "sup_right": sup_r,
                          "ref": (T, B0, B1)})
    return best[1]


# ---------------------------------------------------------------------- #
# 8. gene-level quantification
# ---------------------------------------------------------------------- #
def quantify_gene(ensg, enst, strand, exons_sorted, refined, rseq, rseq_rc, gcode):
    length = rseq.shape[1]
    arL = np.arange(length)
    exseqs = [gcode[a - 1:b] for a, b in exons_sorted]
    # locate host intron containing the CE
    cs, ce = refined["start"], refined["end"]
    host_i = None
    for i in range(len(exons_sorted) - 1):
        iv_s = exons_sorted[i][1] + 1
        iv_e = exons_sorted[i + 1][0] - 1
        if iv_s <= cs and ce <= iv_e:
            host_i = i
            break
    cry_parts = exseqs[:host_i + 1] + [gcode[cs - 1:ce]] + exseqs[host_i + 1:]
    can_parts = exseqs
    Rcry = np.concatenate(cry_parts)
    Rcan = np.concatenate(can_parts)
    b_cry = [0]
    for part in cry_parts:
        b_cry.append(b_cry[-1] + len(part))
    b_can = [0]
    for part in can_parts:
        b_can.append(b_can[-1] + len(part))
    counts = {"total": 0, "cry_junc": 0, "can_junc": 0,
              "J_left": set(), "J_right": set(), "J_canon_intron": set(),
              "J_other": set(), "spanning": set()}
    for tag, mat in (("fwd", rseq), ("rc", rseq_rc)):
        pc, mc = scan_ref(mat, Rcry, arL, length)
        pn, mn = scan_ref(mat, Rcan, arL, length)
        for i in range(mat.shape[0]):
            bc, bn = int(mc[i]), int(mn[i])
            if bc > MAXMM and bn > MAXMM:
                continue
            counts["total"] += 1
            if bc <= bn:
                p, bounds, parts = int(pc[i]), b_cry, cry_parts
                # boundaries crossed
                crossed = [k for k in range(1, len(bounds) - 1)
                           if p < bounds[k] < p + length]
                if not crossed:
                    continue
                counts["cry_junc"] += 1
                # host intron boundaries: left junction = boundary host_i+1,
                # right junction = boundary host_i+2
                for k in crossed:
                    if k == host_i + 1:
                        counts["J_left"].add((tag, i))
                    elif k == host_i + 2:
                        counts["J_right"].add((tag, i))
                    else:
                        counts["J_other"].add((tag, i))
                if host_i + 1 in crossed and host_i + 2 in crossed:
                    counts["spanning"].add((tag, i))
            else:
                p, bounds = int(pn[i]), b_can
                crossed = [k for k in range(1, len(bounds) - 1)
                           if p < bounds[k] < p + length]
                if not crossed:
                    continue
                counts["can_junc"] += 1
                for k in crossed:
                    if k == host_i + 1:
                        counts["J_canon_intron"].add((tag, i))
                    else:
                        counts["J_other"].add((tag, i))
    return counts, Rcry, b_cry, host_i


# ---------------------------------------------------------------------- #
# main
# ---------------------------------------------------------------------- #
def main():
    rseq, gcode, chrom, gstr = load_inputs()
    length = rseq.shape[1]
    log(f"[load] {rseq.shape[0]} reads x {length} bp; reference {chrom} "
        f"({len(gcode)} bp)")

    pos_dict = build_index(rseq, gcode)
    keep, s1, s2, rseq_rc = screen(rseq, pos_dict)
    C_uniq, J_uniq = place_reads(rseq, rseq_rc, keep, s1, s2, pos_dict, gcode)
    J_reads = canonicalize(J_uniq, gcode)

    introns, trans_exons, genes = load_annotation()
    log(f"[annotation] introns={len(introns)} transcripts={len(trans_exons)} "
        f"genes={len(genes)}")

    # classify all junction clusters
    jrows = []
    for (s, e, st), reads in sorted(J_reads.items()):
        novel = (chrom, s, e) not in introns
        jrows.append({"chrom": chrom, "start": s, "end": e, "strand": st,
                      "reads": len(reads), "novel": novel, "role": "",
                      "idxs": reads})

    cands = find_candidates(J_reads, introns, genes, chrom)
    log(f"[candidates] cryptic-exon candidates (interval free of annotated "
        f"exons): {len(cands)}")
    for c in cands[:10]:
        log(f"  strand {c['"'strand']:+d} {c['left'][:2]} ({c['left'][2]} reads) / \"
            f\"{c['right'][:2]} ({c['right'][2]} reads) -> interval \"
            f\"{c['start']}-{c['end']} hosts={c['host_genes']}\")
    if not cands:
        raise SystemExit(\"no cryptic-exon candidate found\")

    cand = cands[0]
    host, score = pick_host_gene(cand, trans_exons, chrom)
    ensg, enst, strand, exons_sorted = host
    gene_name = genes[(chrom, ensg)][\"name\"]
    log(f\"[host] gene {gene_name} ({ensg}, {enst}) boundary-match score {score}\")

    refined = refine_candidate(cand, rseq, rseq_rc, gcode, chrom)
    log(f\"[refine] best: CE {refined['start']}-{refined['end']} \"
        f\"junctions {refined['intron_left']} & {refined['intron_right']} \"
        f\"spanning={refined['spanning']} supL={refined['sup_left']} \"
        f\"supR={refined['sup_right']}\")

    counts, Rcry, b_cry, host_i = quantify_gene(
        ensg, enst, strand, exons_sorted, refined, rseq, rseq_rc, gcode)
    jl = len(counts[\"J_left\"]); jr = len(counts[\"J_right\"])
    span = len(counts[\"spanning\"])
    log(f\"[quant] {gene_name}: total={counts['total']} \"
        f\"J_left={jl} J_right={jr} both={span} \"
        f\"canonical-intron-spanning={len(counts['J_canon_intron'])} \"
        f\"other-junctions={len(counts['J_other'])}\")

    # cryptic-exon coverage
    B0, B1 = b_cry[host_i + 1], b_cry[host_i + 2]
    cov = np.zeros(B1 - B0, dtype=np.int32)
    for tag, mat in ((\"fwd\", rseq), (\"rc\", rseq_rc)):
        bp, bm = scan_ref(mat, Rcry, np.arange(length), length)
        for i in np.where((bp >= 0) & (bm <= MAXMM))[0]:
            p = int(bp[i])
            lo, hi = max(p, B0), min(p + length, B1)
            if hi > lo:
                cov[lo - B0:hi - B0] += 1
    n_cov = int((cov > 0).sum())

    # ------------------------------------------------------------------ #
    # outputs
    # ------------------------------------------------------------------ #
    outdir = os.path.join(WS, \"output\")
    os.makedirs(outdir, exist_ok=True)

    cs, ce = refined[\"start\"], refined[\"end\"]
    l_intron = refined[\"intron_left\"]
    r_intron = refined[\"intron_right\"]

    evidence = (
        f\"{counts['total']} uniquely-mapped {gene_name} reads; all map to the \"
        f\"cryptic isoform (0 reads span the constitutive intron \"
        f\"{exons_sorted[host_i][1]+1}-{exons_sorted[host_i+1][0]-1}); \"
        f\"{span} reads span both novel junctions (full exon inclusion); \"
        f\"exon body covered at {int(cov.min())}-{int(cov.max())}x \"
        f\"(mean {cov.mean():.1f}x) by {jl + jr - span} junction-overlapping reads\"
    )

    with open(os.path.join(outdir, \"cryptic_exon.tsv\"), \"w\") as f:
        f.write(\"gene\\tchrom\\tstart\\tend\\tleft_junction_reads\\tright_junction_reads\\texpression_evidence\\n\")
        f.write(f\"{gene_name}\\t{chrom}\\t{cs}\\t{ce}\\t{jl}\\t{jr}\\t{evidence}\\n\")

    # junction table: refine counts for the host-gene junctions
    refined_juncs = {
        (chrom, l_intron[0], l_intron[1]): (\"cryptic_exon_left\", jl),
        (chrom, r_intron[0], r_intron[1]): (\"cryptic_exon_right\", jr),
    }
    # other junctions of the host gene from quantification
    other_gene_junc = len(counts[\"J_other\"])
    seen_refined = set()
    with open(os.path.join(outdir, \"junctions.tsv\"), \"w\") as f:
        f.write(\"chrom\\tintron_start\\tintron_end\\tstrand\\treads\\tnovel\\tgene\\trole\\tnotes\\n\")
        rows = []
        for r in jrows:
            key = (r[\"chrom\"], r[\"start\"], r[\"end\"])
            if key in refined_juncs:
                role, cnt = refined_juncs[key]
                seen_refined.add(key)
