{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport time, pickle\nimport numpy as np\nfrom collections import Counter, defaultdict\nt0=time.time()\ndef log(*a): print(*a, flush=True)\nK=16; L=107\nrseq=np.load('tmp/rseq.npy')\ngcode=np.load('tmp/gcode.npy')\nwith open('tmp/pos_dict.pkl','rb') as f: pos_dict=pickle.load(f)\nkeep=np.load('tmp/keep.npy')\nh1=np.load('tmp/h1.npy'); h2=np.load('tmp/h2.npy')\nOFFS=[0,15,30,45,60,75,91]\nar107=np.arange(L)\nG=len(gcode)\n\ndef rc_row(row):\n    return np.array([3-v if v<4 else 4 for v in row[::-1]],dtype=np.uint8)\n\ndef seed_positions(row):\n    # returns list of (offset, [positions]) for seeds that hit with <=20 copies\n    out=[]\n    for off in OFFS:\n        k=0; ok=True\n        for j in range(K):\n            v=row[off+j]\n            if v==4: ok=False; break\n            k=(k<<2)|int(v)\n        if not ok: continue\n        p=pos_dict.get(k)\n        if p is not None and len(p)<=20:\n            out.append((off,p))\n    return out\n\ncontig=[]\njunct=defaultdict(lambda: [0,Counter(),[]])  # (s,e,strand)->[count, split Counter, [read idx]]\nunresolved=[]\nmmhist=Counter()\n\ndef resolve(idx, row, strand):\n    seeds=seed_positions(row)\n    if len(seeds)<2: return False\n    diags=defaultdict(int)\n    diagpos=defaultdict(list)\n    for off,ps in seeds:\n        for pp in ps:\n            d=int(pp)-off\n            diags[d]+=1\n            diagpos[d].append((off,int(pp)))\n    top=sorted(diags.items(),key=lambda x:-x[1])\n    # contig try\n    best=None\n    for d,v in top[:3]:\n        if v<3: break\n        if 0<=d and d+L<=G:\n            mm=int((gcode[d:d+L]\"'!=row).sum())\n            if mm<=3 and (best is None or mm<best[0]):\n                best=(mm,d)\n    if best is not None:\n        mm,d=best\n        contig.append((idx,strand,int(d),mm))\n        mmhist[mm]+=1\n        return True\n    # split try over diagonal pairs\n    cand_diags=[d for d,v in top if v>=1][:6]\n    bestS=None\n    for i in range(len(cand_diags)):\n        for j in range(len(cand_diags)):\n            if i==j: continue\n            d1=cand_diags[i]; d2=cand_diags[j]\n            if d1<0 or d2<0 or d1+L>G+1000 or d2+L>G+1000: continue\n            # build matrix rows for a in 16..91\n            avals=np.arange(16,92)\n            cols=ar107[None,:]\n            rowL=gcode[d1:d1+L] if d1+L<=G else None\n            rowR=gcode[d2:d2+L] if d2+L<=G else None\n            if rowL is None or rowR is None: continue\n            M=np.where(cols<avals[:,None], rowL[None,:], rowR[None,:])\n            mm=(M!=row[None,:]).sum(1)\n            amin=int(mm.argmin())\n            if mm[amin]<=2:\n                a=int(avals[amin])\n                intron_len=(d2+a)-(d1+a)\n                if 1<=intron_len<=150000:\n                    if bestS is None or mm[amin]<bestS[0]:\n                        bestS=(int(mm[amin]),d1,d2,a,strand)\n    if bestS is not None:\n        mm,d1,d2,a,strand_=bestS\n        s=d1+a+1; e=d2+a  # 1-based inclusive intron\n        key=(s,e,strand_)\n        junct[key][0]+=1\n        junct[key][1][a]+=1\n        if len(junct[key][2])<50: junct[key][2].append(idx)\n        return True\n    return False\n\nfor n, idx in enumerate(keep):\n    idx=int(idx)\n    ok=False\n    if h1[idx].max()>=3 or (h1[idx]>=1).sum()>=3:\n        ok=resolve(idx, rseq[idx], 1)\n    if not ok and (h2[idx].max()>=3 or (h2[idx]>=1).sum()>=3):\n        ok=resolve(idx, rc_row(rseq[idx]), -1)\n    if not ok:\n        unresolved.append(idx)\n    if n%4000==0: log(f'\"'{n}/{len(keep)}', f'{time.time()-t0:.1f}s')\n\nlog('contig:',len(contig),' mm hist:',dict(sorted(mmhist.items())))\nlog('junctions:',len(junct),' unresolved:',len(unresolved))\ntopj=sorted(junct.items(),key=lambda x:-x[1][0])[:25]\nfor k,v in topj:\n    print('junc',k,'reads',v[0],'splits',dict(v[1]))\nwith open('tmp/results.pkl','wb') as f:\n    pickle.dump({'contig':contig,'junct':{k:(v[0],dict(v[1]),v[2]) for k,v in junct.items()},'unresolved':unresolved},f)\nlog('done', f'{time.time()-t0:.1f}s')\n'@ | Set-Content -Encoding UTF8 tmp/probe9.py; python tmp/probe9.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
