{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport gzip, pickle\nfrom collections import defaultdict, Counter\n\n# ---- load annotation ----\nintrons=set()                 # (chrom, start, end) 1-based inclusive\ngenes=defaultdict(lambda: {'strand':None,'exons':[],'trans':set(),'ensg':''})\nwith gzip.open('inputs/reference/ensembl112_protein_coding_exons.tsv.gz','rt') as f:\n    header=f.readline().rstrip('\\\\n').split('\\\\t')\n    rows=[]\n    for line in f:\n        p=line.rstrip('\\\\n').split('\\\\t')\n        rows.append(p)\nprint('anno rows',len(rows))\n# normalize chrom names: annotation uses '9'; we'll store both forms\ndef norm_chrom(c):\n    return c\ntrans_exons=defaultdict(list)  # (chrom,transcript)->[(s,e),...]\ngene_info={}\nfor p in rows:\n    ensg,enst,gname,chrom,s,e,strand,ttype=p\n    s=int(s); e=int(e)\n    trans_exons[(chrom,enst)].append((s,e))\n    gene_info.setdefault((chrom,ensg),{'name':gname,'strand':strand,'exons':[]})\n    gene_info[(chrom,ensg)]['exons'].append((s,e))\n# build introns per transcript\nfor (chrom,enst),exs in trans_exons.items():\n    exs.sort()\n    for i in range(len(exs)-1):\n        introns.add((chrom, exs[i][1]+1, exs[i+1][0]-1))\nprint('introns:',len(introns))\nwith open('tmp/introns.pkl','wb') as f: pickle.dump(introns,f)\nwith open('tmp/geneinfo.pkl','wb') as f: pickle.dump(gene_info,f)\n\n# ---- classify junction clusters ----\nwith open('tmp/results4.pkl','rb') as f: res=pickle.load(f)\nJ=res['J_reads']\nnovel=[]; annotated=[]\nfor (s,e,st),reads in J.items():\n    key=('9',s,e)\n    if key in introns: annotated.append(((s,e,st),len(reads)))\n    else: novel.append(((s,e,st),len(reads)))\nnovel.sort(key=lambda x:-x[1]); annotated.sort(key=lambda x:-x[1])\nprint('novel clusters:',len(novel),' annotated:',len(annotated))\np