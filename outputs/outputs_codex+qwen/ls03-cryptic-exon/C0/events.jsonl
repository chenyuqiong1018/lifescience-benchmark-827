{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport gzip, pickle\nimport numpy as np\nfrom collections import defaultdict\n\n# annotation: exons and introns\nexon_iv=[]   # (chrom,s,e)\nintrons=set()\ntrans_exons=defaultdict(list)\ngene_span={}\nwith gzip.open('inputs/reference/ensembl112_protein_coding_exons.tsv.gz','rt') as f:\n    f.readline()\n    for line in f:\n        p=line.rstrip('\\\\n').split('\\\\t')\n        ensg,enst,gname,chrom,s,e,strand,ttype=p\n        s=int(s); e=int(e)\n        exon_iv.append((chrom,s,e,gname))\n        trans_exons[(chrom,enst)].append((s,e))\n        key=(chrom,ensg)\n        if key not in gene_span: gene_span[key]=[s,e,gname,strand]\n        else:\n            gene_span[key][0]=min(gene_span[key][0],s); gene_span[key][1]=max(gene_span[key][1],e)\nfor (chrom,enst),exs in trans_exons.items():\n    exs.sort()\n    for i in range(len(exs)-1):\n        introns.add((chrom,exs[i][1]+1,exs[i+1][0]-1))\n\nexon_iv9=[(s,e,g) for c,s,e,g in exon_iv if c=='9']\nexon_iv9.sort()\nstarts=np.array([x[0] for x in exon_iv9]); ends=np.array([x[1] for x in exon_iv9])\ndef overlaps_annotated_exon(s,e):\n    # any annotated exon overlapping [s,e]\n    i=np.searchsorted(starts,e,'right')-1\n    # check all exons with start<=e and end>=s  (linear scan near region is fine via bounded window)\n    lo=np.searchsorted(starts,s-1000000,'left')\n    for j in range(lo,len(exon_iv9)):\n        a,b,g=exon_iv9[j]\n        if a>e: break\n        if b>=s: return True,g\n    return False,None\n\nwith open('tmp/results4.pkl','rb') as f: res=pickle.load(f)\nJ=res['J_reads']\n# candidate pairs same strand, ordered, gap <100kb\nnov={}\nfor (s,e,st),reads in J.items():\n    if ('9',s,e) not in introns:\n        nov.setdefault(st,[]).append((s,e,len(reads)))\ncands=[]\nfor st,lst in nov.items():\n    lst.sort()\n    for i in range(len(lst)):\n        for j in range(i+1,len(lst)):\n            s1,e1,n1=lst[i]; s2,e2,n2=lst[j]\n            if e1 < s2 and s2-e1 <= 100000 and n1>=3 and n2>=3:\n                cands.append((st,s1,e1,n1,s2,e2,n2))\nprint('candidate pairs:',len(cands))\nhits=[]\nfor st,s1,e1,n1,s2,e2,n2 in cands:\n    cs,ce=e1+1,s2-1\n    ov,gname=overlaps_annotated_exon(cs,ce)\n    # gene containment\n    genes_here=[v for k,v in gene_span.items() if k[0]=='9' and v[0]<=cs and v[1]>=ce]\n    gnames=sorted({v[2] for v in genes_here})\n    print('strand %+d  L=%d-%d(%d reads) R=%d-%d(%d reads) interval %d-%d len %d exon_overlap=%s genes=%s'%(\n        st,s1,e1,n1,s2,e2,n2,cs,ce,ce-cs+1,(gname if ov else None),gnames))\n'@ | Set-Content -Encoding UTF8 tmp/probe18.py; python tmp/probe18.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
