iags)):\n        for j in range(len(cand_diags)):\n            if i==j: continue\n            d1=cand_diags[i]; d2=cand_diags[j]\n            if d1<0 or d2<0 or d1+L>G or d2+L>G: continue\n            avals=np.arange(16,92)\n            cols=ar107[None,:]\n            rowL=gcode[d1:d1+L]; rowR=gcode[d2:d2+L]\n            M=np.where(cols<avals[:,None], rowL[None,:], rowR[None,:])\n            mm=(M!=row[None,:]).sum(1)\n            amin=int(mm.argmin())\n            if mm[amin]<=3:\n                a=int(avals[amin])\n                ilen=(d2+a)-(d1+a)\n                if 1<=ilen<=200000:\n                    if bestS is None or mm[amin]<bestS[0]:\n                        bestS=(int(mm[amin]),d1,d2,a,strand)\n    if bestS is not None:\n        mm,d1,d2,a,_=bestS\n        s=d1+a+1; e=d2+a\n        key=(s,e,strand)\n        junct[key][0]+=1\n        junct[key][1][a]+=1\n        junct[key][2].append(idx)\n        return True\n    return False\n\nfor n,idx in enumerate(keep):\n    idx=int(idx)\n    ok=False\n    if s1[idx]>=2:\n        ok=resolve(idx, rseq[idx], 1)\n    if not ok and s2[idx]>=2:\n        ok=resolve(idx, rc_row(rseq[idx]), -1)\n    if not ok: unresolved.append(idx)\n    if n%8000==0: log(f'\"'{n}/{len(keep)}', f'{time.time()-t0:.1f}s')\n\nlog('contig:',len(contig),' mm hist:',dict(sorted(mmhist.items())))\nlog('junction keys:',len(junct),' unresolved:',len(unresolved))\ntopj=sorted(junct.items(),key=lambda x:-x[1][0])[:30]\nfor k,v in topj:\n    print('junc',k,'reads',v[0],'splits',dict(sorted(v[1].items())))\nwith open('tmp/results2.pkl','wb') as f:\n    pickle.dump({'contig':contig,'junct':{k:(v[0],dict(v[1]),v[2]) for k,v in junct.items()},'unresolved':unresolved,'keep':keep},f)\nlog('done', f'{time.time()-t0:.1f}s')\n'@ | Set-Content -Encoding UTF8 tmp/probe11.py; python tmp/probe11.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
