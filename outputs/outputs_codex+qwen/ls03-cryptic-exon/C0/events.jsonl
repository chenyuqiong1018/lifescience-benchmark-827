        for de in range(-3, 4):\n            ss, ee = s + ds, e + de\n            if ss < 2 or ee > G:\n                continue\n            d = BASE[gcode[ss - 1]] + BASE[gcode[ss]]\n            a = BASE[gcode[ee - 2]] + BASE[gcode[ee - 1]]\n            if strand == 1:\n                if d == \"GT\" and a == \"AG\":\n                    cands.append((ss, ee))\n            else:\n                if d == \"CT\" and a == \"AC\":\n                    cands.append((ss, ee))\n    return cands\n\n\ndef canonicalize(J_uniq, gcode):\n    J_reads = defaultdict(list)\n    for (s, e, st), idxs in J_uniq.items():\n        canon = canonical_junc(s, e, st, gcode)\n        cs, ce = canon[0] if len(canon) == 1 else (s, e)\n        J_reads[(int(cs), int(ce), st)].extend(idxs)\n    return J_reads\n'\"'@ | Add-Content -Encoding UTF8 output/analysis.py; Write-Output (\\\"part2 ok \\\" + (Get-Item output/analysis.py).Length)\"","aggregated_output":"part2 ok 12257\r\n","exit_code":0,"status":"completed"}}
