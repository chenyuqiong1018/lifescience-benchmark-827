{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"python -c \\\"\nimport numpy as np\npts=[]\nfor line in open('inputs/protein.shape.q1.pdb'):\n    if line.startswith('ATOM') and line[12:16].strip()=='CA':\n        pts.append((float(line[30:38]),float(line[38:46]),float(line[46:54])))\np=np.array(pts)\n# plane fit z = a*x + b*y + c\nA=np.c_[p[:,0],p[:,1],np.ones(len(p))]\ncoef,res,_,_=np.linalg.lstsq(A,p[:,2],rcond=None)\npred=A@coef\nprint('plane fit resid std (z~ax+by+c):',round(pred.std(),1),'coef a,b=',np.round(coef[:2],2))\nA2=np.c_[p[:,0],p[:,2],np.ones(len(p))]\ncoef2,_,_,_=np.linalg.lstsq(A2,p[:,1],rcond=None)\nprint('plane fit resid std (y~ax+cz):',round((A2@coef2).std(),1))\nA3=np.c_[p[:,1],p[:,2],np.ones(len(p))]\ncoef3,_,_,_=np.linalg.lstsq(A3,p[:,0],rcond=None)\nprint('plane fit resid std (x~ay+bz):',round((A3@coef3).std(),1))\nprint('stds x,y,z:',np.round(p.std(0),1))\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
