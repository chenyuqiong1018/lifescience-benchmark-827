{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"python -c \\\"\nimport numpy as np, matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nfrom matplotlib.figure import Figure\nfrom scipy import ndimage\n\ndef parse_pdb(path):\n    chains={}\n    for line in open(path):\n        if not line.startswith('ATOM'): continue\n        if line[12:16].strip()\"'!='\"'CA': continue\n        ch=line[21]\n        chains.setdefault(ch,[]).append((float(line[30:38]),float(line[38:46]),float(line[46:54])))\n    return {k:np.array(v) for k,v in chains.items()}\n\ndef rasterize_lines(chains, a, b, size=220, lw=6):\n    pts=np.vstack(list(chains.values()))\n    lo=pts[:,[a,b]].min(0); hi=pts[:,[a,b]].max(0)\n    fig=Figure(figsize=(4,4),dpi=60)\n    ax=fig.add_axes([0,0,1,1]); ax.set_axis_off()\n    for arr in chains.values():\n        q=arr[:,[a,b]]\n        ax.plot(q[:,0],q[:,1],'-',lw=lw,color='k')\n    ax.set_xlim(lo[0]-5,hi[0]+5); ax.set_ylim(lo[1]-5,hi[1]+5)\n    ax.set_aspect('equal')\n    fig.canvas.draw()\n    buf=np.asarray(fig.canvas.buffer_rgba())[...,0]\n    mask=buf<128\n    return mask\n\ndef norm_mask(mask,size=200):\n    ys,xs=np.nonzero(mask)\n    m2=np.zeros((size,size),bool)\n    h=ys.max()-ys.min()+1; w=xs.max()-xs.min()+1\n    sub=mask[ys.min():ys.max()+1, xs.min():xs.max()+1]\n    scale=(size-20)/max(h,w)\n    from scipy.ndimage import zoom\n    z=zoom(sub,scale,order=0)\n    oh,ow=z.shape\n    y0=(size-oh)//2; x0=(size-ow)//2\n    m2[y0:y0+oh,x0:x0+ow]=z\n    return m2\n\ndef letter_mask(ch,size=200):\n    fig=Figure(figsize=(4,4),dpi=60)\n    ax=fig.add_axes([0,0,1,1]); ax.set_axis_off()\n    ax.text(0.5,0.5,ch,fontsize=260,ha='center',va='center',family='DejaVu Sans')\n    fig.canvas.draw()\n    buf=np.asarray(fig.canvas.buffer_rgba())[...,3]\n    return norm_mask(b