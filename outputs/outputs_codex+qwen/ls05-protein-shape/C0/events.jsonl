ound(results[c],4)) for c in order])\n'@ | Set-Content -Encoding utf8 match_letters.py; python match_letters.py\"","aggregated_output":"B 0.0357\r\nD 0.0357\r\nF 0.0357\r\nH 0.0357\r\nJ 0.0357\r\nL 0.0357\r\nN 0.0357\r\nP 0.0357\r\nR 0.0357\r\nT 0.0357\r\nV 0.0357\r\nX 0.0357\r\nZ 0.0357\r\nRANKING: [('B', np.float64(0.0357)), ('D', np.float64(0.0357)), ('F', np.float64(0.0357)), ('H', np.float64(0.0357)), ('J', np.float64(0.0357)), ('L', np.float64(0.0357)), ('N', np.float64(0.0357)), ('P', np.float64(0.0357)), ('R', np.float64(0.0357)), ('T', np.float64(0.0357)), ('V', np.float64(0.0357)), ('X', np.float64(0.0357)), ('Z', np.float64(0.0357))]\r\n","exit_code":0,"status":"completed"}}
