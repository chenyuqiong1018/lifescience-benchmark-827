{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport numpy as np\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\nX = np.load('ca_coords.npy'); chains = np.load('ca_chains.npy'); resids = np.load('ca_resids.npy')\nXc = X - X.mean(0)\nU, S, Vt = np.linalg.svd(Xc, full_matrices=False)\nP = Xc @ Vt.T\nx, y, z = P[:,0], P[:,1], P[:,2]\nchlist = sorted(set(chains))\ncmap = plt.get_cmap('tab10')\n\nfig = plt.figure(figsize=(20, 12))\n# Left: backbone trace, color by chain, with N->C arrows\nax = fig.add_subplot(2, 3, 1)\nfor i, ch in enumerate(chlist):\n    m = np.where(chains == ch)[0]\n    order = m[np.argsort(resids[m])]\n    ax.plot(x[order], y[order], '-', lw=2.5, color=cmap(i))\n    ax.text(x[order[0]], y[order[0]], f'{ch}N', fontsize=9)\n    ax.text(x[order[-1]], y[order[-1]], f'{ch}C', fontsize=9)\nax.set_title('Backbone trace, PC1-PC2'); ax.set_aspect('equal')\n\n# Middle: hexbin zoom center\nax = fig.add_subplot(2, 3, 2)\nax.hexbin(x, y, gridsize=90, cmap='magma', mincnt=1)\nax.set_xlim(-60, 80); ax.set_ylim(-60, 80)\nax.set_title('Center zoom'); ax.set_aspect('equal')\n\n# 3D view along different axes using scatter with depth shading\nfor j, (elev, azim, t) in enumerate([(90, -90, 'view along PC3 (plan)'), (0, 0, 'view along PC2'), (0, 90, 'view along PC1')]):\n    ax = fig.add_subplot(2, 3, 4 + j, projection='3d')\n    ax.scatter(P[:,0], P[:,1], P[:,2], s=3, c=P[:,2], cmap='viridis')\n    ax.view_init(elev=elev, azim=azim)\n    ax.set_title(t)\nplt.tight_layout()\nplt.savefig('output/inspect.png', dpi=120)\nprint('saved')\n\n# arm angle analysis: find centroid, then radial histogram of mass\nfrom collections import defaultdict\ncx, cy = np.median(x), np.median(y)\ndx, dy = x - cx, y - cy\nr = np.hypot(dx, dy)\nth = np.degrees(np.arctan2(dy, dx))\nfar = r > 40\nhist, edges = np.histogram(th[far], bins=36, range=(-180, 180))\nprint('radial mass histogram (deg from centroid, r>40):')\nfor h, e0, e1 in zip(hist, edges[:-1], edges[1:]):\n    print(f'{e0:6.0f}..{e1:6.0f}: {h}')\n'@ | Set-Content -Encoding utf8 render3.py; python render3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
