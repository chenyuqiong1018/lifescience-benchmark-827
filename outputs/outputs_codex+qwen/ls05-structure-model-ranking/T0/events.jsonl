{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"python -c \\\"\nimport csv, os\n\nws = '.'\n# 1. Required artifacts exist\nfor p in ['output/model_ranking.csv', 'output/analysis.py', 'output/report.md']:\n    assert os.path.isfile(p), p\n\n# 2. Exact schema\nrows = list(csv.reader(open('output/model_ranking.csv', newline='')))\nassert rows[0] == ['rank','model_id','global_score','interface_score','critical_residue_risk','decision'], rows[0]\ndata = rows[1:]\nassert len(data) == 3, len(data)  # exactly 3 input models, no extra rows\nassert [r[0] for r in data] == ['1','2','3']\n\n# 3. Cross-check against inputs (independent recomputation)\nmet = {r['model_id']: r for r in csv.DictReader(open('inputs/model_metrics.csv', newline=''))}\nerr = list(csv.DictReader(open('inputs/residue_errors.csv', newline='')))\nrisk = {}\nfor r in err:\n    lo, hi = max(int(r['residue_start']),181), min(int(r['residue_end']),240)\n    if hi >= lo:\n        risk[r['model_id']] = risk.get(r['model_id'], 0.0) + (hi-lo+1)*float(r['mean_error_a'])\ntot = {m: 0 for m in met}\nfor r in err:\n    lo, hi = max(int(r['residue_start']),181), min(int(r['residue_end']),240)\n    if hi >= lo: tot[r['model_id']] += hi-lo+1\nrisk = {m: risk.get(m,0.0)/tot[m] if tot[m] else None for m in met}\n\ndef key(mid):\n    m = met[mid]\n    return (0 if m['chain_mapping_complete']=='true' else 1, -float(m['tm_score']), -float(m['lddt']),\n            float(m['rmsd_a']), -int(m['aligned_residues']), risk[mid], mid)\nexpect_order = sorted(met, key=key)\nassert [r[1] for r in data] == expect_order, ([r[1] for r in data], expect_order)\n\nallowed = {'preferred','alternate','reject_incomplete_mapping'}\nfor rk, mid, gs, ifs, cr, dec in data:\n    m = met[mid]\n    assert gs == m['tm_score'], (mid, gs)\n    assert ifs == ('1' if m['chain_mapping_complete']=='true' else '0'), (mid, ifs)\n    assert float(cr) == risk[mid], (mid, cr, risk[mid])\n    assert dec in allowed\n    complete = m['chain_mapping_complete']=='true'\n    if not complete: assert dec == 'reject_incomplete_mapping'\n    elif rk == '1': assert dec == 'preferred'\n    else: assert dec == 'alternate'\nassert sum(1 for r in data if r[5]=='preferred') == 1\nprint('SCHEMA+VALIDATION PASS')\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
