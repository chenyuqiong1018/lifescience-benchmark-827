ll_id'].to_numpy()[:-1] == df['cell_id'].to_numpy()[1:])\nc0, t1 = c0[same_cell], t1[same_cell]\nt0 = df['transcription'].to_numpy()[:-1][same_cell]\nprint('P(trans(t+1)=1 | contact(t))   = %.4f  (n=%d)' % (t1[c0==1].mean(), (c0==1).sum()))\nprint('P(trans(t+1)=1 | no contact(t))= %.4f  (n=%d)' % (t1[c0==0].mean(), (c0==0).sum()))\nc1 = df['contact'].to_numpy()[1:][same_cell]\nprint('P(contact(t) | trans(t-1)=1)   = %.4f' % (c1[t0==1].mean()))\nprint('P(contact(t) | trans(t-1)=0)   = %.4f' % (c1[t0==0].mean()))\nprint('P(trans(t+1)=1 | trans(t)=1)   = %.4f' % (t1[t0==1].mean()))\nprint('P(trans(t+1)=1 | trans(t)=0)   = %.4f' % (t1[t0==0].mean()))\nprint('transcription burst length mean: %.3f' % (1/(1 - t1[t0==1].mean()) if t1[t0==1].mean()<1 else float('nan')))\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
