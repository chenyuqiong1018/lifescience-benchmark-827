{"type":"item.started","item":{"id":"item_98","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$patch = @'\"'\nimport re\np = \\\"output/analysis.py\\\"\ns = open(p, encoding=\\\"utf-8-sig\\\").read()\n\n# --- edit 1: mismatch QC block after alignment-rate log ---\nanchor1 = '''    log(f\\\"alignment: {int(usable1.sum() + usable2.sum()):,}/{2 * npairs:,} \\\"\n        f\\\"reads placed with >=2 seeds ({aln_rate:.3%})\\\")\n'''\nadd1 = anchor1 + '''\n    # read-level mismatch QC on a subsample of placed reads: exposes the\n    # bimodal read population (clean reads vs noisy reads with many errors)\n    idx_q = np.nonzero(usable1)[0][:20000]\n    pos_q = a1[\\\"start\\\"][idx_q]\n    mm = np.array([int((c1[i] \"'!= refc[p0:p0 + READ_LEN]).sum())\n                   for i, p0 in zip(idx_q, pos_q)])\n    clean_frac = float((mm <= 2).mean())\n    noisy = mm[mm > 2]\n    noisy_mean = float(noisy.mean()) if noisy.size else 0.0\n    log(f\"read QC subsample ({len(idx_q):,}): {clean_frac:.1%} clean reads; \"\n        f\"noisy reads carry ~{noisy_mean:.1f} mismatches each\")\n'\"'''\nassert s.count(anchor1) == 1\ns = s.replace(anchor1, add1)\n\n# --- edit 2: qc reads section gains the subsample block ---\nanchor2 = '''            \\\"mean_genome_depth_x\\\": round(starts_all.size * READ_LEN / acgt, 3),\n        },'''\nadd2 = '''            \\\"mean_genome_depth_x\\\": round(starts_all.size * READ_LEN / acgt, 3),\n            \\\"qc_subsample_mapped_reads\\\": {\n                \\\"n\\\": int(len(idx_q)),\n                \\\"clean_reads_fraction_le2mm\\\": round(clean_frac, 4),\n                \\\"noisy_reads_mean_mismatches\\\": round(noisy_mean, 2),\n                \\\"note\\\": (\\\"bimodal read population; noisy reads are spread \\\"\n                         \\\"genome-wide (no regional bias), the >=2-seed rule \\\"\n                         \\\"keeps placements reliable\\\")},\n        },'''\nassert s.count(anchor2) == 1\ns = s.replace(anchor2, add2)\n\n# --- edit 3: null for unmappable bins in the 100kb CN profile ---\nanchor3 = '''            \\\"depth_cn_profile_100kb\\\": [round(float(x), 3) for x in cn_big],'''\nadd3 = '''            \\\"depth_cn_profile_100kb\\\": [\n                round(float(x), 3) if map_big[i] else None\n                for i, x in enumerate(cn_big)],'''\nassert s.count(anchor3) == 1\ns = s.replace(anchor3, add3)\n\n# --- edit 4: report data section gains a read-quality bullet ---\nanchor4 = '''- Insert size: median {qc['insert_size']['median_bp']:.0f} bp\n  (MAD {qc['insert_size']['mad_bp']:.0f} bp).'''\nadd4 = anchor4 + '''\n- Read quality (subsample of {qc['reads']['qc_subsample_mapped_reads']['n']:,}\n  placed reads): {qc['reads']['qc_subsample_mapped_reads']['clean_reads_fraction_le2mm']:.1%}\n  clean; the remainder carry ~{qc['reads']['qc_subsample_mapped_reads']['noisy_reads_mean_mismatches']:.0f}\n  mismatches (simulator noise), spread genome-wide, so regional depth is not\n  biased. Unmappable reference (N-gaps/centromere) is excluded from all\n  depth calculations (shows as null in the CN profile).'''\nassert s.count(anchor4) == 1\ns = s.replace(anchor4, add4)\n\nopen(p, \\\"w\\\", encoding=\\\"utf-8\\\").write(s)\nprint(\\\"all 4 edits applied\\\")\n'@\nSet-Content -LiteralPath output\\\\_patch2.py -Value \"'$patch -Encoding utf8\npython -X utf8 output'\"\\\\_patch2.py\npython -m py_compile output\\\\analysis.py; Write-Host \\\"compile ok\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
