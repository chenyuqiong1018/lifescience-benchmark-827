ds:\\\", sum(len(v) for v in recs.values()))\nprint(\\\"pairs:\\\", len(recs))\n\npairs_both = pairs_one = 0\nproper = 0\ninserts = []\norien = collections.Counter()\nclip_reads = []\nposlist = []\nfor qname, r in recs.items():\n    if 0 in r and 0x80 in r:\n        pairs_both += 1\n        a, b = r[0], r[0x80]\n        if a[\\\"flag\\\"] & 2: proper += 1\n        if a[\\\"rname\\\"] == b[\\\"rname\\\"] == \\\"chr22\\\":\n            left, right = (a, b) if a[\\\"pos\\\"] <= b[\\\"pos\\\"] else (b, a)\n            fr = (left[\\\"flag\\\"] & 16 == 0) and (right[\\\"flag\\\"] & 16 \"'!= 0)\n            rf = (left[\"flag\"] & 16 != 0) and (right[\"flag\"] & 16 == 0)\n            orien[\"FR\" if fr else (\"RF\" if rf else \"same-strand/other\")] += 1\n            if fr and (left[\"flag\"] & 2):\n                ins = right[\"end\"] - left[\"pos\"] + 1\n                inserts.append(ins)\n                poslist.append((left[\"pos\"], right[\"end\"]))\n    elif len(r) == 1:\n        pairs_one += 1\n    for k, rec in r.items():\n        cl, cr = rec[\"clip\"]\n        if cl >= 20 or cr >= 20:\n            clip_reads.append((rec[\"rname\"], rec[\"pos\"], rec[\"end\"], cl, cr, rec[\"flag\"] & 16 != 0))\n\nprint(\"pairs both aligned:\", pairs_both, \" one mate only:\", pairs_one)\nprint(\"proper pairs:\", proper)\nprint(\"orientation (both on chr22):\", dict(orien))\nif inserts:\n    ins_sorted = sorted(inserts)\n    med = statistics.median(ins_sorted)\n    mad = statistics.median([abs(x - med) for x in ins_sorted])\n    q = lambda p: ins_sorted[min(len(ins_sorted)-1, int(p*len(ins_sorted)))]\n    print(f\"FR proper inserts: n={len(inserts)} median={med} MAD={mad} p1={q(0.01)} p5={q(0.05)} p95={q(0.95)} p99={q(0.99)} max={ins_sorted[-1]}\")\n    big = [i for i in inserts if i > med + 10*max(mad,1) + 1000]\n    print(\"inserts > median+10MAD+1000:\", len(big))\nprint(\"soft-clipped reads (>=20bp):\", len(clip_reads))\n\n# depth in 100kb bins\nBIN = 100000\nnbins = (hdr_len + BIN - 1)//BIN\ncov = [0]*nbins\nfor qname, r in recs.items():\n    for k, rec in r.items():\n        if rec[\"rname\"] != \"chr22\": continue\n        if rec[\"mapq\"] < 1: continue\n        lo, hi = rec[\"pos\"]-1, rec[\"end\"]-1\n        b0, b1 = lo//BIN, hi//BIN\n        for b in range(b0, min(b1+1, nbins)):\n            s = max(lo, b*BIN); e = min(hi, (b+1)*BIN-1)\n            cov[b] += e - s + 1\nimport json\nwith open(\"tools/depth_100kb.json\",\"w\") as fh:\n    json.dump({\"bin\":BIN, \"cov\":cov}, fh)\nprint(\"bins:\", nbins)\nfor i, c in enumerate(cov):\n    if i % 5 == 0:\n        print(f\"{i*BIN//1000000:>4}-{(i+1)*BIN//1000000:>4}Mb cov={c}\")\n'\"'@ | Set-Content -Encoding utf8 tools/explore.py; python tools/explore.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
