{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport collections, statistics\n\nseq = []\nwith open(\\\"tools/chr22.fa\\\") as fh:\n    next(fh)\n    for line in fh: seq.append(line.strip())\nseq = \\\"\\\".join(seq)\nL = len(seq)\n\ndef cigar_ops(cig):\n    ops = []; num = \\\"\\\"\n    for ch in cig:\n        if ch.isdigit(): num += ch\n        else: ops.append((ch, int(num))); num = \\\"\\\"\n    return ops\n\ndef reflen(cig):\n    return sum(l for o,l in cigar_ops(cig) if o in \\\"MDN=X\\\")\n\nreads = []  # (flag, pos, mapq, end, clipL, clipR, cigar, qname, idx)\nwith open(\\\"tools/aln.sam\\\") as fh:\n    for line in fh:\n        if line.startswith(\\\"@\\\"): continue\n        f = line.split(\\\"\\\\t\\\")\n        flag = int(f[1])\n        if flag & 4: continue\n        cig = f[5]\n        ops = cigar_ops(cig)\n        cl = ops[0][1] if ops and ops[0][0]==\\\"S\\\" else 0\n        cr = ops[-1][1] if ops and ops[-1][0]==\\\"S\\\" else 0\n        pos = int(f[3])\n        reads.append((f[0], flag, pos, int(f[4]), pos+reflen(cig)-1, cl, cr, cig))\n\ndef profile(a, b, w):\n    cov = [0]*((b-a+w-1)//w)\n    for _,_,pos,mq,end,cl,cr,cig in reads:\n        if mq < 1: continue\n        lo, hi = max(pos,a)-1, min(end,b)-1\n        if hi < lo: continue\n        for x in range(lo, hi+1):\n            cov[(x-a)//w] += 1\n    return cov\n\nfor (a,b) in [(19_940_000, 20_060_000), (20_940_000, 21_060_000)]:\n    cov = profile(a,b,1000)\n    print(f\\\"\\\\n--- 1kb depth {a/1e6:.3f}-{b/1e6:.3f} Mb ---\\\")\n    line = []\n    for i,c in enumerate(cov):\n        line.append(f\\\"{(a+i*1000)/1e6:.3f}:{c}\\\")\n    # print compact: position where depth changes\n    prev = None\n    for i,c in enumerate(cov):\n        if c \"'!= prev:\n            print(f\"  {(a+i*1000):>9} depth {prev} -> {c}\")\n            prev = c\n\nprint(\"'\"\\\\n--- reads overlapping 19,995,000-20,005,000 (any mapq) ---\\\")\nfor r in sorted(reads, key=lambda r: r[2]):\n    qn,flag,pos,mq,end,cl,cr,cig = r\n    if pos <= 20_005_000 and end >= 19_995_000 and (pos > 19_999_000 or end < 20_001_000):\n        if 19_995_000 <= pos <= 20_005_000 or 19_995_000 <= end <= 20_005_000:\n            rev = \\\"-\\\" if flag&16 else \\\"+\\\"\n            print(f\\\"  {qn} {rev} pos={pos} end={end} mapq={mq} clip={cl}/{cr} cig={cig}\\\")\n\nprint(\\\"\\\\n--- reads overlapping 20,995,000-21,005,000 (any mapq) ---\\\")\nfor r in sorted(reads, key=lambda r: r[2]):\n    qn,flag,pos,mq,end,cl,cr,cig = r\n    if pos <= 21_005_000 and end >= 20_995_000 and (pos > 20_999_000 or end < 21_001_000):\n        if 20_995_000 <= pos <= 21_005_000 or 20_995_000 <= end <= 21_005_000:\n            rev = \\\"-\\\" if flag&16 else \\\"+\\\"\n            print(f\\\"  {qn} {rev} pos={pos} end={end} mapq={mq} clip={cl}/{cr} cig={cig}\\\")\n\n# residual coverage inside 20.0-21.0: list all reads with any base inside\nprint(\\\"\\\\n--- all reads with any base inside 20,000,001-20,999,999 ---\\\")\ninside = [r for r in reads if r[2] <= 20_999_999 and r[4] >= 20_000_001]\nprint(\\\"count:\\\", len(inside))\nfor r in sorted(inside, key=lambda r: r[2])[:60]:\n    qn,flag,pos,mq,end,cl,cr,cig = r\n    rev = \\\"-\\\" if flag&16 else \\\"+\\\"\n    print(f\\\"  {qn} {rev} pos={pos} end={end} mapq={mq} clip={cl}/{cr}\\\")\n'@ | Set-Content -Encoding utf8 tools/explore4.py; python tools/explore4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
