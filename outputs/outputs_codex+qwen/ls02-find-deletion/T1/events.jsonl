{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport collections, statistics, json\n\nseq = []\nwith open(\\\"tools/chr22.fa\\\") as fh:\n    next(fh)\n    for line in fh: seq.append(line.strip())\nseq = \\\"\\\".join(seq)\nL = len(seq)\n\ndef parse_cigar_reflen(cig):\n    n = 0; num = \\\"\\\"\n    for ch in cig:\n        if ch.isdigit(): num += ch\n        else:\n            l = int(num); num = \\\"\\\"\n            if ch in \\\"MDN=X\\\": n += l\n    return n\n\nrecs = {}\nwith open(\\\"tools/aln.sam\\\") as fh:\n    for line in fh:\n        if line.startswith(\\\"@\\\"): continue\n        f = line.split(\\\"\\\\t\\\")\n        qname, flag = f[0], int(f[1])\n        if flag & 4: continue\n        r = recs.setdefault(qname, {})\n        r[flag & 0x80] = (flag, f[2], int(f[3]), int(f[4]), int(f[3]) + parse_cigar_reflen(f[5]) - 1)\n\nBIN = 100000\nnb = (L + BIN - 1)//BIN\nmapp = [0]*nb\ni = 0\nwhile i < L:\n    if seq[i] \"'!= \"N\":\n        j = i\n        while j < L and seq[j] != \"N\": j += 1\n        b0, b1 = i//BIN, (j-1)//BIN\n        for b in range(b0, b1+1):\n            s = max(i, b*BIN); e = min(j-1, (b+1)*BIN-1)\n            mapp[b] += e - s + 1\n        i = j\n    else: i += 1\n\ncov = [0]*nb\nfor q, r in recs.items():\n    for k, rec in r.items():\n        if rec[1] != \"chr22\" or rec[3] < 1: continue\n        lo, hi = rec[2]-1, rec[4]-1\n        b0, b1 = lo//BIN, hi//BIN\n        for b in range(b0, min(b1+1, nb)):\n            s = max(lo, b*BIN); e = min(hi, (b+1)*BIN-1)\n            cov[b] += e - s + 1\n\nratios = []\nprint(\"bin(Mb)   cov_bp  mapp_bp  depth_norm\")\nfor b in range(nb):\n    if mapp[b] >= 50000:\n        d = cov[b]/mapp[b]\n        ratios.append((b, d, cov[b], mapp[b]))\nmed = statistics.median([d for _,d,_,_ in ratios])\nprint(\"median normalized