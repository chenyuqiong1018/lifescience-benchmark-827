{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport collections\n\ndef cigar_ops(cig):\n    ops=[]; num=\\\"\\\"\n    for ch in cig:\n        if ch.isdigit(): num+=ch\n        else: ops.append((ch,int(num))); num=\\\"\\\"\n    return ops\ndef reflen(cig): return sum(l for o,l in cigar_ops(cig) if o in \\\"MDN=X\\\")\n\nreads=[]\nwith open(\\\"tools/aln.sam\\\") as fh:\n    for line in fh:\n        if line.startswith(\\\"@\\\"): continue\n        f=line.split(\\\"\\\\t\\\")\n        flag=int(f[1])\n        if flag&4: continue\n        reads.append((f[0],flag,int(f[3]),int(f[4]),int(f[3])+reflen(f[5])-1,f[5]))\n\n# max end of reads ending in left-edge zone; reads themselves start upstream\nends=[]\nfor qn,flag,pos,mq,end,cig in reads:\n    if 19_999_000 <= end <= 20_001_000 and pos < 20_000_000 and mq>=1:\n        ends.append((end,pos,qn,mq,cig,flag&16))\nends.sort(reverse=True)\nprint(\\\"left edge: reads with max end (mapq>=1):\\\")\nfor e in ends[:8]: print(\\\"  end=%d pos=%d %s mapq=%d %s rev=%s\\\"%e)\n\nstarts=[]\nfor qn,flag,pos,mq,end,cig in reads:\n    if 20_999_000 <= pos <= 21_001_000 and end > 21_000_000 and mq>=1:\n        starts.append((pos,end,qn,mq,cig,flag&16))\nstarts.sort()\nprint(\\\"right edge: reads with min start (mapq>=1):\\\")\nfor s in starts[:8]: print(\\\"  pos=%d end=%d %s mapq=%d %s rev=%s\\\"%s)\n\n# spanning pairs near 20/21 with details\nrecs=collections.defaultdict(dict)\nfor qn,flag,pos,mq,end,cig in reads:\n    recs[qn][flag&0x80]=(flag,pos,mq,end,cig)\nprint(\\\"\\\\nspanning pairs over the 20-21Mb gap:\\\")\nfor qn,r in recs.items():\n    if 0 in r and 0x80 in r:\n        a,b=r[0],r[0x80]\n        if min(a[1],b[1])>=10 and a[1]<20_000_000<a[3]<20_010_000 and 20_990_000<b[1]<21_010_000:\n            print(f\\\"  {qn}: left flag={a[0]} pos={a[1]