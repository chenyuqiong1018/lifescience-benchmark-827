{"type":"item.started","item":{"id":"item_102","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$d5 = @'\"'\nimport sys, os\nsys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'output'))\nimport numpy as np\n\ncache = np.load(os.path.join(os.path.dirname(os.path.abspath(__file__)), 'cache.npz'))\nstarts1, strands1, matches1 = cache['starts1'], cache['strands1'], cache['matches1']\nstarts2, strands2, matches2 = cache['starts2'], cache['strands2'], cache['matches2']\n\ndef concordant_pairs(lo, hi, min_match=140):\n    mm = (starts1 >= lo) & (starts1 < hi) & (starts2 >= lo) & (starts2 < hi) \\\\\n         & (matches1 >= min_match) & (matches2 >= min_match)\n    i = np.where(mm)[0]\n    if len(i) == 0:\n        return 0, []\n    s1, s2 = starts1[i], starts2[i]\n    st1, st2 = strands1[i], strands2[i]\n    fr = (st1 == 0) & (st2 == 1) & (s2 >= s1) & (s2 + 150 - s1 <= 1200)\n    rf = (st1 == 1) & (st2 == 0) & (s1 >= s2) & (s1 + 150 - s2 <= 1200)\n    return int((fr | rf).sum()), i.tolist()[:10]\n\ntests = [\n    (\\\"deletion [20.0M,21.0M)\\\", 20000000, 21000000),\n    (\\\"block [21.151M,21.35M)\\\", 21151000, 21350000),\n    (\\\"block [21.46M,21.55M)\\\", 21460000, 21550000),\n    (\\\"control left flank [19.5M,19.7M)\\\", 19500000, 19700000),\n    (\\\"control right [21.6M,21.8M)\\\", 21600000, 21800000),\n    (\\\"control [22.0M,22.2M)\\\", 22000000, 22200000),\n    (\\\"elevated [21.36M,21.46M)\\\", 21360000, 21460000),\n    (\\\"elevated [18.4M,18.6M)\\\", 18400000, 18600000),\n]\nfor name, lo, hi in tests:\n    n, ex = concordant_pairs(lo, hi)\n    area = (hi - lo)\n    print(f\\\"{name}: concordant pairs = {n}  (per 100kb: {n*100000/area:.0f})\\\")\n\nprint()\n# also: unique-only (matches>=145) read starts counts per block\nfor name, lo, hi in tests:\n    c1 = int(((starts1 >= lo) & (starts1 < hi) & (matches1 >= 145)).sum())\n    c2 = int(((starts2 >= lo) & (starts2 < hi) & (matches2 >= 145)).sum())\n    print(f\\\"{name}: unique-match reads = {c1+c2}\\\")\n'@\nSet-Content -Path scratch\\\\diag5.py -Value \"'$d5 -Encoding utf8\npython scratch'\"\\\\diag5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
