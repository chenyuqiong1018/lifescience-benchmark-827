{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$code = @'\"'\n#\"'!/usr/bin/env python3\n\"\"\"\nanalysis.py - Locate a large deletion in shallow paired-end hg38 data (chr22).\n\nPipeline (pure numpy/pandas, no external aligner required):\n  1. Load chr22 reference (GRCh38) and 2-bit encode it.\n  2. Build a sorted 20-mer index over the reference (repeat-masked by\n     k-mer occurrence count).\n  3. Map 150 bp reads by seed-and-vote: seeds every 10 bp on both strands,\n     diagonal voting, then full-read verification (Hamming match count).\n  4. Read-depth analysis in 100 kb (and 10 kb) bins, normalized by local\n     mappability, to locate the depleted interval.\n  5. Discordant read pairs (abnormally large FR insert) to refine\n     breakpoints.\n  6. Split reads (prefix/suffix mapping) for nucleotide-level breakpoint\n     evidence.\n  7. Report breakpoints rounded to the nearest 100 kb, with the underlying\n     raw evidence kept separate from the rounding precision.\n\nOutputs: output/deletion.tsv, output/qc.json (this script is\noutput/analysis.py; report is output/report.md).\n\"\"\"\nimport gzip\nimport json\nimport os\nimport sys\nimport time\n\nimport numpy as np\n\nT0 = time.time()\nHERE = os.path.dirname(os.path.abspath(__file__))\nROOT = os.path.dirname(HERE)\nIN_REF = os.path.join(ROOT, \"inputs\", \"reference\", \"GRCh38_chr22.fa.gz\")\nIN_R1 = os.path.join(ROOT, \"inputs\", \"find.deletion.r1.fq.gz\")\nIN_R2 = os.path.join(ROOT, \"inputs\", \"find.deletion.r2.fq.gz\")\n\nK = 20                # k-mer length for the index\nSEED_STEP = 10        # seed spacing within reads\nREAD_LEN = 150\nMAX_OCC = 16          # k-mers occurring more often are treated as repeats\nMIN_MATCH = 130       # min matches of 150 to accept an alignment\nSPLIT_MIN_MATCH = 55  # min matches for a prefix/suffix split segment\nCHROM = \"chr22\"\n\ndef log(msg):\n    print(f\"[{time.time()-T0:7.1f}s] {msg}\", flush=True)\n\n# ----------------------------------------------------------------------\n# 1. Reference loading + encoding\n# ----------------------------------------------------------------------\ndef load_reference(path):\n    seq = []\n    name = None\n    with gzip.open(path, \"rt\") as f:\n        for line in f:\n            line = line.rstrip(\"'\"\\\\n\\\")\n            if line.startswith(\\\">\\\"):\n                name = line[1:].split()[0]\n            else:\n                seq.append(line.upper())\n    return name, \\\"\\\".join(seq)\n\ndef encode_ref(seq):\n    \\\"\\\"\\\"2-bit encode; N/other -> 255 (never matches).\\\"\\\"\\\"\n    a = np.frombuffer(seq.encode(\\\"ascii\\\"), dtype=np.uint8).copy()\n    lut = np.full(256, 255, dtype=np.uint8)\n    lut[np.frombuffer(b\\\"ACGT\\\", dtype=np.uint8)] = np.arange(4, dtype=np.uint8)\n    codes = lut[a]\n    return codes  # uint8, 0-3 for ACGT else 255\n\n# ----------------------------------------------------------------------\n# 2. k-mer index\n# ----------------------------------------------------------------------\ndef kmer_codes(codes, k, valid=None):\n    \\\"\\\"\\\"Rolling k-mer codes over a code array (255 positions poison the k-mer).\\\"\\\"\\\"\n    n = len(codes) - k + 1\n    km = codes[:n].astype(np.uint64)\n    ok = codes[:n] < 4\n    for j in range(1, k):\n        seg = codes[j:j + n]\n        km = (km << 2) | seg.astype(np.uint64)\n        ok &= seg < 4\n    km[~ok] = np.uint64(1) << np.uint64(63)  # sentinel sorts last\n    return km\n\ndef build_index(ref_codes):\n    log(\\\"building reference k-mer index ...\\\")\n    n = len(ref_codes) - K + 1\n    km = kmer_codes(ref_codes, K)\n    log(\\\"sorting %d k-mers ...\\\" % n)\n    perm = np.argsort(km, kind=\\\"stable\\\")\n    sorted_km = km[perm]\n    del km\n    pos = perm.astype(np.int32)\n    del perm\n    # occurrence count per sorted k-mer\n    log(\\\"counting k-mer occurrences ...\\\")\n    neq = np.flatnonzero(sorted_km[1:] \"'!= sorted_km[:-1]) + 1\n    starts = np.concatenate(([0], neq))\n    ends = np.concatenate((neq, [n]))\n    lengths = (ends - starts).astype(np.uint16)\n    occ = np.repeat(lengths, ends - starts)\n    # keep sentinel k-mers (N-containing) as '\"'infinite' occurrence\n    occ[sorted_km == (np.uint64(1) << np.uint64(63))] = 65535\n    n_uniq = int((lengths == 1).sum())\n    log(f\\\"index done: {n} k-mers, {n_uniq} unique, \\\"\n        f\\\"{int((lengths <= MAX_OCC).sum())} with occ<={MAX_OCC}\\\")\n    return sorted_km, pos, occ\n\n# ----------------------------------------------------------------------\n# 3. FASTQ loading\n# ----------------------------------------------------------------------\ndef load_fastq(path):\n    with gzip.open(path, \\\"rb\\\") as f:\n        lines = f.read().split(b\\\"\\\\n\\\")\n    lines = [l for l in lines if l]\n    seqs = lines[1::4]\n    quals = lines[3::4]\n    n = len(seqs)\n    L = len(seqs[0])\n    raw = np.frombuffer(b\\\"\\\".join(seqs), dtype=np.uint8).reshape(n, L)\n    lut = np.full(256, 255, dtype=np.uint8)\n    lut[np.frombuffer(b\\\"ACGT\\\", dtype=np.uint8)] = np.arange(4, dtype=np.uint8)\n    lut[np.frombuffer(b\\\"acgt\\\", dtype=np.uint8)] = np.arange(4, dtype=np.uint8)\n    codes = lut[raw]\n    q = np.frombuffer(b\\\"\\\".join(quals), dtype=np.uint8).reshape(n, L)\n    return codes, q  # codes: 0-3 ACGT else 255\n\ndef rc_codes(codes):\n    \\\"\\\"\\\"Reverse complement of (N,L) code array (255 stays 255).\\\"\\\"\\\"\n    comp = np.where(codes < 4, np.uint8(3) - codes, np.uint8(255)).astype(np.uint8)\n    return comp[:, ::-1].copy()\n\n# ----------------------------------------------------------------------\n# 4. Seed lookup + diagonal voting + verification\n# ----------------------------------------------------------------------\ndef seed_lookup(rcodes, offsets, sorted_km, pos, occ, tag):\n    \\\"\\\"\\\"Return hit arrays for seeds of given reads at given offsets.\\\"\\\"\\\"\n    n, L = rcodes.shape\n    seed_offs = []\n    seed_strand_valid = []\n    ks = []\n    for o in offsets:\n        s = rcodes[:, o:o + K].astype(np.uint64)\n        # pack\n        code = np.zeros(n, dtype=np.uint64)\n        for j in range(K):\n            code = (code << 2) | s[:, j]\n        valid = (rcodes[:, o:o + K] < 4).all(axis=1)\n        ks.append(code)\n        seed_offs.append(o)\n    all_k = np.concatenate(ks)\n    all_off = np.tile(np.array(offsets, dtype=np.int64), n)\n    all_read = np.repeat(np.arange(n, dtype=np.int64), len(offsets))\n    idx = np.searchsorted(sorted_km, all_k)\n    idx = np.clip(idx, 0, len(sorted_km) - 1)\n    found = sorted_km[idx] == all_k\n    keep = found & (occ[idx] <= MAX_OCC) & np.repeat((rcodes < 4).all(axis=1), 1)\n    # validity per seed (no N inside seed)\n    vld = np.concatenate([ (rcodes[:, o:o+K] < 4).all(axis=1) for o in offsets ])\n    keep &= vld\n    refpos = pos[idx][keep].astype(np.int64)\n    read_id = all_read[keep]\n    off = all_off[keep]\n    return read_id, off, refpos\n\ndef map_reads(rcodes, sorted_km, pos, occ, label):\n    n, L = rcodes.shape\n    offsets = list(range(0, L - K + 1, SEED_STEP))\n    # forward strand seeds\n    r1, o1, p1 = seed_lookup(rcodes, offsets, sorted_km, pos, occ, \\\"+\\\")\n    # reverse strand: seeds of the RC read\n    rcc = rc_codes(rcodes)\n    r2, o2, p2 = seed_lookup(rcc, offsets, sorted_km, pos, occ, \\\"-\\\")\n    log(f\\\"{label}: seeds found: {len(r1)} fwd, {len(r2)} rev\\\")\n    diag1 = p1 - o1\n    keep1 = diag1 >= 0\n    diag2 = p2 - o2\n    keep2 = diag2 >= 0\n    rid = np.concatenate([r1[keep1], r2[keep2]])\n    strand = np.concatenate([np.zeros(keep1.sum(), np.int8),\n                             np.ones(keep2.sum(), np.int8)])\n    diag = np.concatenate([diag1[keep1], diag2[keep2]])\n    # diagonal tolerance +/-1: vote to exact diagonal (indels are rare in\n    # simulated/shallow data; a 1 bp slip still verifies downstream)\n    key = ((rid << 1 | strand.astype(np.int64)) << 28) | diag\n    ukey, counts = np.unique(key, return_counts=True)\n    u_rid = (ukey >> 28) >> 1\n    u_strand = (ukey >> 28) & 1\n    u_diag = ukey & ((1 << 28) - 1)\n    # pick best (max votes) candidate per read\n    order = np.lexsort((-counts, u_rid))\n    u_rid_s, first = np.unique(u_rid[order], return_index=True)\n    best = order[first]\n    cand_read = u_rid[best]\n    cand_strand = u_strand[best].astype(np.int8)\n    cand_start = u_diag[best]\n    cand_votes = counts[best]\n    log(f\\\"{label}: reads with candidate: {len(cand_read)} / {n}\\\")\n    # verify by gathering reference windows\n    start_arr = np.full(n, -1, dtype=np.int64)\n    strand_arr = np.full(n, -1, dtype=np.int8)\n    match_arr = np.zeros(n, dtype=np.int16)\n    valid_starts = cand_start <= (len_ref_global - L)\n    cand_read = cand_read[valid_starts]; cand_strand = cand_strand[valid_starts]\n    cand_start = cand_start[valid_starts]; cand_votes = cand_votes[valid_starts]\n    rows = np.arange(READ_LEN)\n    refwin = ref_codes_global[cand_start[:, None] + rows[None, :]]\n    q = np.where(cand_strand[:, None] == 0, rcodes_global[label][cand_read],\n                 rcc_global[label][cand_read])\n    m = ((refwin == q) & (q < 4)).sum(axis=1)\n    good = m >= MIN_MATCH\n    start_arr[cand_read[good]] = cand_start[good]\n    strand_arr[cand_read[good]] = cand_strand[good]\n    match_arr[cand_read[good]] = m[good]\n    # keep subthreshold partial matches for split-read analysis\n    partial = (m >= 2 * SPLIT_MIN_MATCH) & ~good\n    log(f\\\"{label}: mapped {int(good.sum())}, partial {int(partial.sum())}\\\")\n    return start_arr, strand_arr, match_arr, (cand_read[partial],\n            cand_start[partial], cand_strand[partial], m[partial])\n'@\nSet-Content -Encoding utf8 scratch\\\\analysis_part1.py\n\\\"part1 written\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
