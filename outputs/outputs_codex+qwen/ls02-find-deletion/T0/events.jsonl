{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$d3 = @'\"'\nimport sys, os, collections\nsys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'output'))\nimport numpy as np\nimport analysis as A\n\nref_name, ref_seq = A.load_reference(A.IN_REF)\nref_codes = A.encode(ref_seq)\nref_len = len(ref_codes)\nsorted_km, pos, occ = A.build_index(ref_codes)\nindex = (sorted_km, pos, occ)\ncodes1, _ = A.load_fastq(A.IN_R1)\ncodes2, _ = A.load_fastq(A.IN_R2)\nstarts1, strands1, matches1, clusters1, rcc1, q1, m1, cr1, cs1, cp1 = A.map_end(codes1, index, ref_codes, \\\"R1\\\")\nstarts2, strands2, matches2, clusters2, rcc2, q2, m2, cr2, cs2, cp2 = A.map_end(codes2, index, ref_codes, \\\"R2\\\")\n\nprint(\\\"=== genome-wide split reads (primary, 2-cluster) ===\\\")\nsp = A.find_split_reads(codes1, rcc1, clusters1, ref_codes, index, \\\"R1\\\", None)\nsp += A.find_split_reads(codes2, rcc2, clusters2, ref_codes, index, \\\"R2\\\", None)\nprint(\\\"count:\\\", len(sp))\ncl = collections.Counter()\ndetail = collections.defaultdict(list)\nfor s in sp:\n    key = (round(s[\\\"J_left\\\"]/500)*500, round(s[\\\"J_right\\\"]/500)*500)\n    cl[key] += 1\n    detail[key].append(s)\nfor key, n in cl.most_common(30):\n    ex = detail[key][0]\n    print(f\\\"  n={n} J_left~{key[0]} J_right~{key[1]} span~{key[1]-key[0]} \\\"\n          f\\\"(e.g. J_left={ex['J_left']} J_right={ex['J_right']} matches {ex['pre_matches']}/{ex['split']}+{ex['suf_matches']}/{150-ex['split']})\\\")\n\nprint(\\\"\\\\n=== genome-wide split reads (secondary, partial rescue) ===\\\")\nsp2 = A.split_from_partials(codes1, (q1, m1, cr1, cs1, cp1), ref_codes, index, \\\"R1\\\", (0, ref_len))\nsp2 += A.split_from_partials(codes2, (q2, m2, cr2, cs2, cp2), ref_codes, index, \\\"R2\\\", (0, ref_len))\nprint(\\\"count:\\\", len(sp2))\ncl2 = collections.Counter()\ndetail2 = collections.defaultdict(list)\nfor s in sp2:\n    key = (round(s[\\\"J_left\\\"]/500)*500, round(s[\\\"J_right\\\"]/500)*500)\n    cl2[key] += 1\n    detail2[key].append(s)\nfor key, n in cl2.most_common(30):\n    ex = detail2[key][0]\n    print(f\\\"  n={n} J_left~{key[0]} J_right~{key[1]} span~{key[1]-key[0]}\\\")\n\nprint(\\\"\\\\n=== discordant pairs, uniqueness-filtered (both mates >=140 matches) ===\\\")\nmm = (starts1 >= 0) & (starts2 >= 0) & (matches1 >= 140) & (matches2 >= 140)\nidx = np.where(mm)[0]\ns1, s2 = starts1[idx], starts2[idx]\nst1, st2 = strands1[idx], strands2[idx]\nfr = (st1 == 0) & (st2 == 1) & (s2 >= s1)\nins = (s2[fr] + 150 - s1[fr])\nmed = np.median(ins); mad = np.median(np.abs(ins - med))\nprint(f\\\"FR pairs: {fr.sum()}, insert median {med}, MAD {mad}\\\")\ndisc = ins > max(1000, med + 10*max(mad*1.4826, 25))\nds1, ds2 = s1[fr][disc], s2[fr][disc]\nprint(f\\\"discordant: {disc.sum()}\\\")\ncl3 = collections.Counter()\ndet3 = collections.defaultdict(list)\nfor a, b in zip(ds1, ds2):\n    key = (int(a)//500*500, int(b)//500*500)\n    cl3[key] += 1\n    det3[key].append((int(a), int(b)))\nfor key, n in cl3.most_common(40):\n    if n >= 2:\n        ex = sorted(det3[key])\n        print(f\\\"  n={n} left~{key[0]} right~{key[1]} span~{key[1]-key[0]} pairs={ex[:6]}\\\")\n\nprint(\\\"\\\\n=== reads mapped inside [20M,21M) ===\\\")\nfor st, mt, lab in ((starts1, matches1, 'R1'), (starts2, matches2, 'R2')):\n    sel = np.where((st >= 20000000) & (st < 21000000))[0]\n    print(f\\\"  {lab}: {len(sel)}\\\")\n    for i in sel[:60]:\n        print(f\\\"    start={st[i]} matches={mt[i]} strand={strands1[i] if lab=='R1' else strands2[i]}\\\")\n\nprint(\\\"\\\\n=== 1kb depth: 19.96-20.04M, 20.96-21.04M, 21.1-21.62M ===\\\")\nocc_ref = np.empty(ref_len - A.K + 1, dtype=np.uint16)\nocc_ref[pos] = occ\ndepth, mappable = A.depth_analysis(starts1, starts2, ref_len, occ_ref)\nallst = np.concatenate([starts1[sta