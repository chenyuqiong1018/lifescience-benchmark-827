{"type":"item.started","item":{"id":"item_105","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$d6 = @'\"'\nimport sys, os, collections\nsys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'output'))\nimport numpy as np\nimport analysis as A\n\nref_name, ref_seq = A.load_reference(A.IN_REF)\nref_codes = A.encode(ref_seq)\nref_len = len(ref_codes)\nsorted_km, pos, occ = A.build_index(ref_codes)\nindex = (sorted_km, pos, occ)\ncodes1, _ = A.load_fastq(A.IN_R1)\ncodes2, _ = A.load_fastq(A.IN_R2)\nstarts1, strands1, matches1, clusters1, rcc1, q1, m1, cr1, cs1, cp1 = A.map_end(codes1, index, ref_codes, \\\"R1\\\")\nstarts2, strands2, matches2, clusters2, rcc2, q2, m2, cr2, cs2, cp2 = A.map_end(codes2, index, ref_codes, \\\"R2\\\")\n\nprint(\\\"== all split reads (primary) near candidate junctions ==\\\")\nsp = A.find_split_reads(codes1, rcc1, clusters1, ref_codes, index, \\\"R1\\\", None)\nsp += A.find_split_reads(codes2, rcc2, clusters2, ref_codes, index, \\\"R2\\\", None)\ncands = [\n    (\\\"primary del [20M|21M]\\\", (19990000, 20010000), (20990000, 21010000)),\n    (\\\"block2 [21.151M|21.35M]\\\", (21140000, 21165000), (21340000, 21365000)),\n    (\\\"block3 [21.46M|21.55M]\\\", (21450000, 21475000), (21540000, 21565000)),\n    (\\\"block2-left alt [21.13M|21.35M]\\\", (21120000, 21145000), (21340000, 21365000)),\n]\nfor name, L, R in cands:\n    hits = [s for s in sp if L[0] <= s[\\\"J_left\\\"] < L[1] and R[0] <= s[\\\"J_right\\\"] < R[1]]\n    print(f\\\"{name}: {len(hits)}\\\")\n    for s in hits[:12]:\n        print(f\\\"   {s['end']}#{s['read_id']} J_left={s['J_left']} J_right={s['J_right']} \\\"\n              f\\\"split={s['split']} m={s['pre_matches']}+{s['suf_matches']}\\\")\n\nprint(\\\"\\\\n== discordant pairs (unique>=140) spanning candidate junctions ==\\\")\nmm = (starts1 >= 0) & (starts2 >= 0) & (matches1 >= 140) & (matches2 >= 140)\nii = np.where(mm)[0]\ns1, s2 = starts1[ii], starts2[ii]\nst1, st2 = strands1[ii], strands2[ii]\nfr = (st1 == 0) & (st2 == 1) & (s2 >= s1)\nfor name, L1, L2, R1, R2 in [\n    (\\\"primary: left[19.85M,20.0M) right[21.0M,21.2M)\\\", 19850000, 20000000, 21000000, 21200000),\n    (\\\"primary-wide: left[19.7M,20.0M) right[21.0M,21.5M)\\\", 19700000, 20000000, 21000000, 21500000),\n    (\\\"block2: left[21.0M,21.151M) right[21.35M,21.6M)\\\", 21000000, 21151000, 21350000, 21600000),\n    (\\\"block3: left[21.35M,21.46M) right[21.55M,21.8M)\\\", 21350000, 21460000, 21550000, 21800000),\n]:\n    sel = fr & (s1 >= L1) & (s1 < L2) & (s2 >= R1) & (s2 < R2) & ((s2 + 150 - s1) > 1000)\n    n = int(sel.sum())\n    print(f\\\"{name}: {n}\\\")\n    ex = np.where(sel)[0][:20]\n    for e in ex:\n        print(f\\\"   s1={s1[e]} s2={s2[e]} insert={s2[e]+150-s1[e]}\\\")\n'@\nSet-Content -Path scratch\\\\diag6.py -Value \"'$d6 -Encoding utf8\npython scratch'\"\\\\diag6.py 2>&1 | Out-File -Encoding utf8 scratch\\\\diag6.log\nGet-Content scratch\\\\diag6.log | Select-Object -Skip 12\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
