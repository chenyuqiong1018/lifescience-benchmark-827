n                              \\\"the task, so TSV precision is limited to \\\"\n                              \\\"+/-50 kb by rounding.\\\",\n        },\n        \\\"deletion\\\": {\n            \\\"chrom\\\": CHROM, \\\"start_100kb\\\": start_r, \\\"end_100kb\\\": end_r,\n            \\\"size_bp\\\": size_r, \\\"zygosity\\\": interval[\\\"zygosity\\\"],\n            \\\"depth_ratio_inside\\\": ctx[\\\"ratio_in\\\"],\n            \\\"supporting_signals\\\": ctx[\\\"supporting\\\"],\n        },\n        \\\"runtime_seconds\\\": round(time.time() - T0, 1),\n    }\n    with open(OUT_QC, \\\"w\\\", encoding=\\\"utf-8\\\", newline=\\\"\\\\n\\\") as f:\n        json.dump(qc, f, indent=2, default=_json_default)\n    log(f\\\"wrote {OUT_QC}\\\")\n\n    # ---------- report.md ----------\n    rep = build_report(ctx, qc)\n    with open(OUT_REPORT, \\\"w\\\", encoding=\\\"utf-8\\\", newline=\\\"\\\\n\\\") as f:\n        f.write(rep)\n    log(f\\\"wrote {OUT_REPORT}\\\")\n\n\ndef _json_default(o):\n    if isinstance(o, (np.integer,)):\n        return int(o)\n    if isinstance(o, (np.floating,)):\n        return float(o)\n    if isinstance(o, np.ndarray):\n        return o.tolist()\n    return str(o)\n\n\ndef build_report(ctx, qc):\n    s = qc[\\\"deletion\\\"]\n    bp = qc[\\\"breakpoints\\\"]\n    al = qc[\\\"alignment\\\"]\n    cov = qc[\\\"coverage\\\"]\n    ins = qc[\\\"insert_size\\\"]\n    seg = qc[\\\"depth_segmentation\\\"]\n    lines = []\n    a = lines.append\n    a(\\\"# Large deletion on GRCh38 chr22 - analysis report\\\\n\\\")\n    a(\\\"## Summary\\\\n\\\")\n    a(f\\\"A large **{s['zygosity']}** deletion of approximately \\\"\n      f\\\"**{s['size_bp']:,} bp** was identified on **{CHROM}**, spanning \\\"\n      f\\\"(1-based, rounded to the nearest 100 kb) **{s['start_100kb']:,} to \\\"\n      f\\\"{s['end_100kb']:,}**.\\\\n\\\")\n    a(\\\"| field | value |\\\")\n    a(\\\"|---|---|\\\")\n    a(f\\\"| chromosome | {CHROM} (GRCh38) |\\\")\n    a(f\\\"| start (1-based, rounded to 100 kb) | {s['start_100kb']:,} |\\\")\n    a(f\\\"| end (1-based, rounded to 100 kb) | {s['end_100kb']:,} |\\\")\n    a(f\\\"| size (rounded coordinates) | {s['size_bp']:,} bp |\\\")\n    a(f\\\"| zygosity estimate | {s['zygosity']} |\\\")\n    a(f\\\"| raw left breakpoint (0-based) | {bp['raw_left_0based']:,} |\\\")\n    a(f\\\"| raw right breakpoint (0-based, excl.) | {bp['raw_right_0based_exclusive']:,} |\\\")\n    a(f\\\"| raw breakpoint method | {bp['raw_evidence_method']} |\\\")\n    a(\\\"\\\")\n    a(\\\"## Data\\\\n\\\")\n    inp = qc[\\\"inputs\\\"]\n    a(f\\\"- {inp['read_pairs']:,} paired-end reads x 2 x {inp['read_length']} bp \\\"\n      f\\\"({inp['total_sequenced_bp']:,} bp sequenced), mean Q \\\"\n      f\\\"R1={inp['mean_quality_r1']}, R2={inp['mean_quality_r2']}.\\\")\n    a(f\\\"- Reference: {inp['reference_name']} ({inp['reference_length']:,} bp, \\\"\n      f\\\"{inp['reference_non_acgt']:,} non-ACGT).\\\")\n    a(f\\\"- Effective depth ~{cov['mean_depth_x']}x; reads were mapped with a \\\"\n      f\\\"custom numpy seed-and-vote aligner (R1 {al['r1_mapped_pct']}%, \\\"\n      f\\\"R2 {al['r2_mapped_pct']}% mapped; mean matches \\\"\n      f\\\"{al['mean_matches_r1']:.1f}/{READ_LEN} and \\\"\n      f\\\"{al['mean_matches_r2']:.1f}/{READ_LEN}).\\\")\n    a(f\\\"- Concordant FR insert size: median {ins['median_bp']:.0f} bp \\\"\n      f\\\"(MAD {ins['mad_bp']:.0f} bp) over {ins['n_concordant_fr']:,} pairs.\\\")\n    a(\\\"\\\")\n    a(\\\"## Methods\\\\n\\\")\n    a(\\\"1. **Mapping.** A repeat-masked 20-mer index of chr22 was built \\\"\n      \\\"(k-mers occurring >16 times treated as repetitive). Each read \\\"\n      \\\"contributed seeds every 10 bp on both strands; reference positions \\\"\n      \\\"were found by binary search and reads were placed by diagonal voting, \\\"\n      \\\"then verified by gathering the reference window and counting matches \\\"\n      \\\"(>=130/150 to accept).\\\")\n    a(\\\"2. **Read depth.** Mapped read starts were counted in 100 kb and \\\"\n      \\\"10 kb bins and normalized by the number of mappable read-start \\\"\n      \\\"positions per bin (k-mer uniqueness). The depleted interval was \\\"\n      \\\"segmented as the longest run of bins with normalized ratio < 0.62 x \\\"\n      \\\"the genomic median.\\\")\n    a(\\\"3. **Discordant pairs.** FR pairs whose insert exceeded \\\"\n      f\\\"{ins['discordant_threshold_bp']:.0f} bp were clustered on both mate \\\"\n      \\\"positions; spanning pairs bracket the junctions (left bound = max \\\"\n      \\\"left-mate end, right bound = min right-mate start).\\\")\n    a(\\\"4. **Split reads.** Reads with two strong diagonal clusters (or a \\\"\n      \\\"partial alignment whose unmatched segment maps to the opposite flank) \\\"\n      \\\"were re-aligned segment-by-segment to obtain nucleotide-resolution \\\"\n      \\\"junctions.\\\")\n    a(\\\"\\\")\n    a(\\\"## Evidence\\\\n\\\")\n    a(f\\\"- **Read depth:** {seg['depleted_coarse_bins'][1]-seg['depleted_coarse_bins'][0]} \\\"\n      f\\\"consecutive 100 kb bins (positions \\\"\n      f\\\"{seg['depleted_region_0based'][0]:,}-{seg['depleted_region_0based'][1]:,}) \\\"\n      f\\\"show median normalized ratio {seg['inner_median_ratio']:.3f} vs the \\\"\n      f\\\"genomic median of {seg['genome_median_ratio']:.3f} -> \\\"\n      f\\\"{s['zygosity']} deletion. 10 kb bins place the depth transitions at \\\"\n      f\\\"~{seg['fine_edges_0based'][0]:,} and ~{seg['fine_edges_0based'][1]:,} \\\"\n      f\\\"(0-based).\\\")\n    a(f\\\"- **Discordant pairs:** {ins['n_discordant_pairs']} pair(s) in \\\"\n      f\\\"{len(ins['discordant_clusters'])} cluster(s):\\\")\n    for c in ins[\\\"discordant_clusters\\\"]:\n        a(f\\\"  - {c['n']} pair(s) bracketing left >= {c['left_lower_bound']:,}, \\\"\n          f\\\"right <= {c['right_upper_bound']:,}\\\")\n    a(f\\\"- **Split reads:** {len(bp['split_reads'])} read(s) spanning the \\\"\n      \\\"junction(s):\\\")\n    for sr in bp[\\\"split_reads\\\"]:\n        a(f\\\"  - {sr['end']} read {sr['read_id']} (strand {sr['strand']}): \\\"\n          f\\\"left junction at {sr['J_left']:,}, right junction at \\\"\n          f\\\"{sr['J_right']:,} ({sr['pre_matches']}/{sr['split']} and \\\"\n          f\\\"{sr['suf_matches']}/{READ_LEN-sr['split']} matches)\\\")\n    a(\\\"\\\")\n    a(\\\"## Evidence vs. precision limits\\\\n\\\")\n    a(\\\"- The **raw breakpoint estimates above are the experimental \\\"\n      f\\\"evidence** (method used for the final coordinates: \\\"\n      f\\\"{bp['raw_evidence_method']}). \\\" + bp[\\\"raw_note\\\"] + \\\".\\\")\n    a(\\\"- The task requires rounding each breakpoint to the nearest 100 kb; \\\"\n      \\\"this rounding, not the raw evidence, is the limiting precision of \\\"\n      \\\"the reported coordinates (+/-50 kb). The raw values are preserved in \\\"\n      \\\"\"'`output/qc.json` (breakpoints.raw_*).\")\n    a(\"- Depth binning alone would localize the deletion only to ~10 kb \"\n      \"(bin boundary uncertainty); discordant pairs bracket the junctions \"\n      \"to within the insert-size spread; split reads (when present) give \"\n      \"single-nucleotide junctions. All three signals agree on the same \"\n      \"interval.\")\n    a(\"\")\n    a(\"## Output files'\"\\\\n\\\")\n    a(\\\"- \"'`output/deletion.tsv` - final call (chrom, start_100kb, end_100kb, \"\n      \"size_bp, supporting_signals).\")\n    a(\"- `output/qc.json` - full QC metrics, raw breakpoint evidence and \"\n      \"precision notes.\")\n    a(\"- `output/analysis.py` - this analysis (self-contained, numpy only).\")\n    a(\"- `output/report.md` - this report.\")\n    a(\"\")\n    return \"'\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\n\n\nif __name__ == \\\"__main__\\\":\n    main()\n'@\n# truncate existing main section then append fixed version\npython -c \\\"\np='output/analysis.py'\ns=open(p,encoding='utf-8').read()\nm='# ---------------------------------------------------------------------\\\\n# main'\ni=s.index(m)\nopen(p,'w',encoding='utf-8').write(s[:i])\n\\\"\nAdd-Content -Path output\\\\analysis.py -Value \"'$c5 -Encoding utf8\n\"final size: $((Get-Item output'\"\\\\analysis.py).Length) bytes\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$c5 = @'\"'\n\n\n# ---------------------------------------------------------------------\n# main\n# ---------------------------------------------------------------------\ndef round100(x):\n    \\\"\\\"\\\"Round to the nearest 100 kb (half rounds up).\\\"\\\"\\\"\n    return int(np.floor(x / 100_000 + 0.5)) * 100_000\n\n\ndef main():\n    log(\\\"loading reference ...\\\")\n    ref_name, ref_seq = load_reference(IN_REF)\n    ref_codes = encode(ref_seq)\n    ref_len = len(ref_codes)\n    n_n = int((ref_codes >= 4).sum())\n    log(f\\\"reference {ref_name}: {ref_len} bp, {n_n} non-ACGT\\\")\n\n    sorted_km, pos, occ = build_index(ref_codes)\n    index = (sorted_km, pos, occ)\n    occ_ref = np.empty(len(ref_codes) - K + 1, dtype=np.uint16)\n    occ_ref[pos] = occ  # occurrence of the k-mer starting at each ref pos\n\n    log(\\\"loading FASTQs ...\\\")\n    codes1, mq1 = load_fastq(IN_R1)\n    codes2, mq2 = load_fastq(IN_R2)\n    n_pairs = len(codes1)\n    assert len(codes2) == n_pairs, \\\"R1/R2 record counts differ\\\"\n    assert codes1.shape[1] == READ_LEN and codes2.shape[1] == READ_LEN\n    log(f\\\"read pairs: {n_pairs}, read length {READ_LEN}, \\\"\n        f\\\"mean Q R1={mq1:.1f} R2={mq2:.1f}\\\")\n\n    starts1, strands1, matches1, clusters1, rcc1, q1, m1, cr1, cs1, cp1 = \\\\\n        map_end(codes1, index, ref_codes, \\\"R1\\\")\n    starts2, strands2, matches2, clusters2, rcc2, q2, m2, cr2, cs2, cp2 = \\\\\n        map_end(codes2, index, ref_codes, \\\"R2\\\")\n    n_map1 = int((starts1 >= 0).sum())\n    n_map2 = int((starts2 >= 0).sum())\n    log(f\\\"mapping summary: R1 {n_map1} ({100*n_map1/n_pairs:.1f}%), \\\"\n        f\\\"R2 {n_map2} ({100*n_map2/n_pairs:.1f}%)\\\")\n\n    # ---------------- read depth ----------------\n    depth, mappable = depth_analysis(starts1, starts2, ref_len, occ_ref)\n    interval = call_deletion_interval(depth, ref_len)\n    b0, b1 = interval[\\\"coarse_run\\\"]\n    log(f\\\"depth call: coarse bins [{b0},{b1}) of {BIN_COARSE} bp, \\\"\n        f\\\"zygosity~{interval['zygosity']}, inner ratio \\\"\n        f\\\"{interval['inner_ratio']:.3f} vs median \\\"\n        f\\\"{interval['coarse_ratio_median']:.3f}\\\")\n    log(f\\\"fine (10 kb) depth edges, 0-based: [{interval['depth_left_edge']}, \\\"\n        f\\\"{interval['depth_right_edge']})\\\")\n\n    # ---------------- pairs ----------------\n    pa = pair_analysis(starts1, strands1, starts2, strands2)\n    log(f\\\"pairs both mapped: {pa['n_both']}, FR concordant {pa['n_fr']}, \\\"\n        f\\\"insert median {pa['insert_median']:.0f} bp, MAD {pa['insert_mad']:.0f}\\\")\n    disc_clusters = cluster_discordant(pa[\\\"disc_s1\\\"], pa[\\\"disc_s2\\\"],\n                                       pa[\\\"disc_pairs\\\"])\n    for c in disc_clusters:\n        log(f\\\"discordant cluster: pairs={c['n']} left>={c['left_lower_bound']}\\\"\n            f\\\" right<={c['right_upper_bound']}\\\")\n\n    # ---------------- split reads ----------------\n    region = (max(0, interval[\\\"depth_left_edge\\\"] - 300_000),\n              min(ref_len, interval[\\\"depth_right_edge\\\"] + 300_000))\n    splits = []\n    splits += find_split_reads(codes1, rcc1, clusters1, ref_codes, index,\n                               \\\"R1\\\", region)\n    splits += find_split_reads(codes2, rcc2, clusters2, ref_codes, index,\n                               \\\"R2\\\", region)\n    splits += split_from_partials(codes1, (q1, m1, cr1, cs1, cp1), ref_codes,\n                                  index, \\\"R1\\\", region)\n    splits += split_from_partials(codes2, (q2, m2, cr2, cs2, cp2), ref_codes,\n                                  index, \\\"R2\\\", region)\n    seen = set()\n    uniq = []\n    for s in splits:\n        key = (s[\\\"end\\\"], s[\\\"read_id\\\"])\n        if key not in seen:\n            seen.add(key)\n            uniq.append(s)\n    splits = [s for s in uniq if s[\\\"size_on_ref\\\"] > 1_000]\n    for s in splits:\n        log(f\\\"split read {s['end']}#{s['read_id']} strand={s['strand']}: \\\"\n            f\\\"J_left={s['J_left']} J_right={s['J_right']} \\\"\n            f\\\"(matches {s['pre_matches']}/{s['split']}, \\\"\n            f\\\"{s['suf_matches']}/{READ_LEN - s['split']})\\\")\n\n    # ---------------- integrate breakpoints ----------------\n    if splits:\n        left_raw = int(np.median([s[\\\"J_left\\\"] for s in splits]))\n        right_raw = int(np.median([s[\\\"J_right\\\"] for s in splits]))\n        bp_method = \\\"split_reads\\\"\n        bp_note = (\\\"median across split reads; nucleotide-resolution \\\"\n                   \\\"evidence, exact junction sequence available\\\")\n    elif disc_clusters:\n        best = max(disc_clusters, key=lambda c: c[\\\"n\\\"])\n        left_raw = best[\\\"left_lower_bound\\\"]\n        right_raw = best[\\\"right_upper_bound\\\"]\n        bp_method = \\\"discordant_pairs\\\"\n        bp_note = (\\\"bracket from discordant mates: left bound = max(R1 end), \\\"\n                   \\\"right bound = min(R2 start); uncertainty ~ insert-size \\\"\n                   \\\"spread (few hundred bp)\\\")\n    else:\n        left_raw = interval[\\\"depth_left_edge\\\"]\n        right_raw = interval[\\\"depth_right_edge\\\"]\n        bp_method = \\\"read_depth\\\"\n        bp_note = \\\"depth-transition bins; uncertainty ~10 kb\\\"\n    log(f\\\"raw breakpoints ({bp_method}, 0-based half-open deleted interval): \\\"\n        f\\\"[{left_raw}, {right_raw}) size={right_raw - left_raw}\\\")\n\n    # 1-based event coordinates: start = last retained base, end = last\n    # deleted base (so size = end - start).\n    pos1 = left_raw\n    end1 = right_raw\n    start_r = round100(pos1)\n    end_r = round100(end1)\n    if end_r <= start_r:\n        end_r = start_r + BIN_COARSE\n    size_r = end_r - start_r\n    log(f\\\"rounded (nearest 100 kb), 1-based: start={start_r} end={end_r} \\\"\n        f\\\"size={size_r}\\\")\n\n    # ---------------- evidence tallies ----------------\n    coarse = depth[\\\"coarse\\\"]\n    region_bins = np.arange(coarse[\\\"n_bins\\\"])[\n        (np.arange(coarse[\\\"n_bins\\\"]) * BIN_COARSE < end_r) &\n        ((np.arange(coarse[\\\"n_bins\\\"]) + 1) * BIN_COARSE > start_r)]\n    ratio_in = float(np.nanmedian(coarse[\\\"ratio\\\"][region_bins]))\n    n_disc = int(len(pa[\\\"disc_pairs\\\"]))\n    supporting = (f\\\"read_depth:{b1-b0}x100kb_bins,median_ratio=\\\"\n                  f\\\"{interval['inner_ratio']:.2f},{interval['zygosity']}\\\"\n                  f\\\";discordant_pairs={n_disc}\\\"\n                  f\\\";split_reads={len(splits)}\\\")\n\n    write_outputs(locals())\n    log(\\\"done\\\")\n\n\ndef write_outputs(ctx):\n    ref_len, n_pairs = ctx[\\\"ref_len\\\"], ctx[\\\"n_pairs\\\"]\n    n_map1, n_map2 = ctx[\\\"n_map1\\\"], ctx[\\\"n_map2\\\"]\n    start_r, end_r, size_r = ctx[\\\"start_r\\\"], ctx[\\\"end_r\\\"], ctx[\\\"size_r\\\"]\n    pos1, end1 = ctx[\\\"pos1\\\"], ctx[\\\"end1\\\"]\n    depth, interval = ctx[\\\"depth\\\"], ctx[\\\"interval\\\"]\n    pa, disc_clusters, splits = ctx[\\\"pa\\\"], ctx[\\\"disc_clusters\\\"], ctx[\\\"splits\\\"]\n    b0, b1 = interval[\\\"coarse_run\\\"]\n    coarse = depth[\\\"coarse\\\"]\n\n    # ---------- deletion.tsv ----------\n    with open(OUT_DEL, \\\"w\\\", encoding=\\\"utf-8\\\", newline=\\\"\\\\n\\\") as f:\n        f.write(\\\"chrom\\\\tstart_100kb\\\\tend_100kb\\\\tsize_bp\\\\tsupporting_signals\\\\n\\\")\n        f.write(f\\\"{CHROM}\\\\t{start_r}\\\\t{end_r}\\\\t{size_r}\\\\t\\\"\n                f\\\"{ctx['supporting']}\\\\n\\\")\n    log(f\\\"wrote {OUT_DEL}\\\")\n\n    # ---------- qc.json ----------\n    qc = {\n        \\\"task\\\": \\\"locate large deletion in shallow paired-end hg38 data\\\",\n        \\\"coordinate_convention\\\": {\n            \\\"basis\\\": \\\"1-based, GRCh38 chr22\\\",\n            \\\"start_100kb\\\": \\\"last retained base before deletion, rounded to nearest 100 kb\\\",\n            \\\"end_100kb\\\": \\\"last deleted base, rounded to nearest 100 kb\\\",\n            \\\"size_bp\\\": \\\"end_100kb - start_100kb\\\",\n        },\n        \\\"inputs\\\": {\n            \\\"r1\\\": os.path.basename(IN_R1), \\\"r2\\\": os.path.basename(IN_R2),\n            \\\"read_pairs\\\": n_pairs, \\\"read_length\\\": READ_LEN,\n            \\\"total_sequenced_bp\\\": 2 * n_pairs * READ_LEN,\n            \\\"mean_quality_r1\\\": round(ctx[\\\"mq1\\\"], 2),\n            \\\"mean_quality_r2\\\": round(ctx[\\\"mq2\\\"], 2),\n            \\\"reference\\\": os.path.basename(IN_REF),\n            \\\"reference_name\\\": ctx[\\\"ref_name\\\"],\n            \\\"reference_length\\\": ref_len,\n            \\\"reference_non_acgt\\\": int(ctx[\\\"n_n\\\"]),\n        },\n        \\\"alignment\\\": {\n            \\\"method\\\": f\\\"custom seed-and-vote mapper (k={K}, seed step \\\"\n                      f\\\"{SEED_STEP}, max kmer occ {MAX_OCC}, min matches \\\"\n                      f\\\"{MIN_MATCH}/{READ_LEN})\\\",\n            \\\"r1_mapped\\\": n_map1, \\\"r2_mapped\\\": n_map2,\n            \\\"r1_mapped_pct\\\": round(100 * n_map1 / n_pairs, 2),\n            \\\"r2_mapped_pct\\\": round(100 * n_map2 / n_pairs, 2),\n            \\\"mean_matches_r1\\\": float(np.mean(ctx[\\\"matches1\\\"][ctx[\\\"starts1\\\"] >= 0])),\n            \\\"mean_matches_r2\\\": float(np.mean(ctx[\\\"matches2\\\"][ctx[\\\"starts2\\\"] >= 0])),\n        },\n        \\\"coverage\\\": {\n            \\\"mean_depth_x\\\": round(READ_LEN * (n_map1 + n_map2) /\n                                  (ref_len - ctx[\\\"n_n\\\"]), 3),\n            \\\"mappable_fraction\\\": round(float(np.mean(ctx[\\\"mappable\\\"])), 4),\n            \\\"median_reads_per_100kb_bin\\\": float(np.nanmedian(coarse[\\\"dep\\\"])),\n        },\n        \\\"insert_size\\\": {\n            \\\"n_concordant_fr\\\": pa[\\\"n_fr\\\"],\n            \\\"median_bp\\\": pa[\\\"insert_median\\\"],\n            \\\"mad_bp\\\": pa[\\\"insert_mad\\\"],\n            \\\"discordant_threshold_bp\\\": pa[\\\"discordant_thresh\\\"],\n            \\\"n_discordant_pairs\\\": int(len(pa[\\\"disc_pairs\\\"])),\n            \\\"discordant_clusters\\\": disc_clusters,\n        },\n        \\\"depth_segmentation\\\": {\n            \\\"coarse_bin_bp\\\": BIN_COARSE, \\\"fine_bin_bp\\\": BIN_FINE,\n            \\\"normalization\\\": \\\"mappability-adjusted expected read starts\\\",\n            \\\"genome_median_ratio\\\": interval[\\\"coarse_ratio_median\\\"],\n            \\\"depleted_coarse_bins\\\": [b0, b1],\n            \\\"depleted_region_0based\\\": [b0 * BIN_COARSE, b1 * BIN_COARSE],\n            \\\"inner_median_ratio\\\": interval[\\\"inner_ratio\\\"],\n            \\\"zygosity_estimate\\\": interval[\\\"zygosity\\\"],\n            \\\"fine_edges_0based\\\": [interval[\\\"depth_left_edge\\\"],\n                                  interval[\\\"depth_right_edge\\\"]],\n        },\n        \\\"breakpoints\\\": {\n            \\\"raw_evidence_method\\\": ctx[\\\"bp_method\\\"],\n            \\\"raw_left_0based\\\": pos1,\n            \\\"raw_right_0based_exclusive\\\": end1,\n            \\\"raw_size_bp\\\": end1 - pos1,\n            \\\"raw_note\\\": ctx[\\\"bp_note\\\"],\n            \\\"split_reads\\\": splits,\n            \\\"rounded_start_100kb\\\": start_r,\n            \\\"rounded_end_100kb\\\": end_r,\n            \\\"rounded_size_bp\\\": size_r,\n            \\\"precision_note\\\": \\\"raw breakpoints are the experimental evidence\\\"\n                              \\\" (method: \\\" + ctx[\\\"bp_method\\\"] + \\\"); the \\\"\n                              \\\"reported TSV coordinates are those raw values \\\"\n                              \\\"rounded to the nearest 100 kb as required by \\\"\n                              \\\"the task, so TSV precision is limited to \\\"\n                              \\\"+/-50 kb by rounding.\\\",\n        },\n        \\\"deletion\\\": {\n            \\\"chrom\\\": CHROM, \\\"start_100kb\\\": start_r, \\\"end_100kb\\\": end_r,\n            \\\"size_bp\\\": size_r, \\\"zygosity\\\": interval[\\\"zygosity\\\"],\n            \\\"depth_ratio_inside\\\": ctx[\\\"ratio_in\\\"],\n            \\\"supporting_signals\\\": ctx[\\\"supporting\\\"],\n        },\n        \\\"runtime_seconds\\\": round(time.time() - T0, 1),\n    }\n    with open(OUT_QC, \\\"w\\\", encoding=\\\"utf-8\\\", newline=\\\"\\\\n\\\") as f:\n        json.dump(qc, f, indent=2, default=_json_default)\n    log(f\\\"wrote {OUT_QC}\\\")\n\n    # ---------- report.md ----------\n    rep = build_report(ctx, qc)\n    with open(OUT_REPORT, \\\"w\\\", encoding=\\\"utf-8\\\", newline=\\\"\\\\n\\\") as f:\n        f.write(rep)\n    log(f\\\"wrote {OUT_REPORT}\\\")\n\n\ndef _json_default(o):\n    if isinstance(o, (np.integer,)):\n        return int(o)\n    if isinstance(o, (np.floating,)):\n        return float(o)\n    if isinstance(o, np.ndarray):\n        return o.tolist()\n    return str(o)\n\n\ndef build_report(ctx, qc):\n    s = qc[\\\"deletion\\\"]\n    bp = qc[\\\"breakpoints\\\"]\n    al = qc[\\\"alignment\\\"]\n    cov = qc[\\\"coverage\\\"]\n    ins = qc[\\\"insert_size\\\"]\n    seg = qc[\\\"depth_segmentation\\\"]\n    lines = []\n    a = lines.append\n    a(\\\"# Large deletion on GRCh38 chr22 - analysis report\\\\n\\\")\n    a(\\\"## Summary\\\\n\\\")\n    a(f\\\"A large **{s['zygosity']}** deletion of approximately \\\"\n      f\\\"**{s['size_bp']:,} bp** was identified on **{CHROM}**, spanning \\\"\n      f\\\"(1-based, rounded to the nearest 100 kb) **{s['start_100kb']:,} to \\\"\n      f\\\"{s['end_100kb']:,}**.\\\\n\\\")\n    a(\\\"| field | value |\\\")\n    a(\\\"|---|---|\\\")\n    a(f\\\"| chromosome | {CHROM} (GRCh38) |\\\")\n    a(f\\\"| start (1-based, rounded to 100 kb) | {s['start_100kb']:,} |\\\")\n    a(f\\\"| end (1-based, rounded to 100 kb) | {s['end_100kb']:,} |\\\")\n    a(f\\\"| size (rounded coordinates) | {s['size_bp']:,} bp |\\\")\n    a(f\\\"| zygosity estimate | {s['zygosity']} |\\\")\n    a(f\\\"| raw left breakpoint (0-based) | {bp['raw_left_0based']:,} |\\\")\n    a(f\\\"| raw right breakpoint (0-based, excl.) | {bp['raw_right_0based_exclusive']:,} |\\\")\n    a(f\\\"| raw breakpoint method | {bp['raw_evidence_method']} |\\\")\n    a(\\\"\\\")\n    a(\\\"## Data\\\\n\\\")\n    inp = qc[\\\"inputs\\\"]\n    a(f\\\"- {inp['read_pairs']:,} paired-end reads x 2 x {inp['read_length']} bp \\\"\n      f\\\"({inp['total_sequenced_bp']:,} bp sequenced), mean Q \\\"\n      f\\\"R1={inp['mean_quality_r1']}, R2={inp['mean_quality_r2']}.\\\")\n    a(f\\\"- Reference: {inp['reference_name']} ({inp['reference_length']:,} bp, \\\"\n      f\\\"{inp['reference_non_acgt']:,} non-ACGT).\\\")\n    a(f\\\"- Effective depth ~{cov['mean_depth_x']}x; reads were mapped with a \\\"\n      f\\\"custom numpy seed-and-vote aligner (R1 {al['r1_mapped_pct']}%, \\\"\n      f\\\"R2 {al['r2_mapped_pct']}% mapped; mean matches \\\"\n      f\\\"{al['mean_matches_r1']:.1f}/{READ_LEN} and \\\"\n      f\\\"{al['mean_matches_r2']:.1f}/{READ_LEN}).\\\")\n    a(f\\\"- Concordant FR insert size: median {ins['median_bp']:.0f} bp \\\"\n      f\\\"(MAD {ins['mad_bp']:.0f} bp) over {ins['n_concordant_fr']:,} pairs.\\\")\n    a(\\\"\\\")\n    a(\\\"## Methods\\\\n\\\")\n    a(\\\"1. **Mapping.** A repeat-masked 20-mer index of chr22 was built \\\"\n      \\\"(k-mers occurring >16 times treated as repetitive). Each read \\\"\n      \\\"contributed seeds every 10 bp on both strands; reference positions \\\"\n      \\\"were found by binary search and reads were placed by diagonal voting, \\\"\n      \\\"then verified by gathering the reference window and counting matches \\\"\n      \\\"(>=130/150 to accept).\\\")\n    a(\\\"2. **Read depth.** Mapped read starts were counted in 100 kb and \\\"\n      \\\"10 kb bins and normalized by the number of mappable read-start \\\"\n      \\\"positions per bin (k-mer uniqueness). The depleted interval was \\\"\n      \\\"segmented as the longest run of bins with normalized ratio < 0.62 x \\\"\n      \\\"the genomic median.\\\")\n    a(\\\"3. **Discordant pairs.** FR pairs whose insert exceeded \\\"\n      f\\\"{ins['discordant_threshold_bp']:.0f} bp were clustered on both mate \\\"\n      \\\"positions; spanning pairs bracket the junctions (left bound = max \\\"\n      \\\"left-mate end, right bound = min right-mate start).\\\")\n    a(\\\"4. **Split reads.** Reads with two strong diagonal clusters (or a \\\"\n      \\\"partial alignment whose unmatched segment maps to the opposite flank) \\\"\n      \\\"were re-aligned segment-by-segment to obtain nucleotide-resolution \\\"\n      \\\"junctions.\\\")\n    a(\\\"\\\")\n    a(\\\"## Evidence\\\\n\\\")\n    a(f\\\"- **Read depth:** {seg['depleted_coarse_bins'][1]-seg['depleted_coarse_bins'][0]} \\\"\n      f\\\"consecutive 100 kb bins (positions \\\"\n      f\\\"{seg['depleted_region_0based'][0]:,}-{seg['depleted_region_0based'][1]:,}) \\\"\n      f\\\"show median normalized ratio {seg['inner_median_ratio']:.3f} vs the \\\"\n      f\\\"genomic median of {seg['genome_median_ratio']:.3f} -> \\\"\n      f\\\"{s['zygosity']} deletion. 10 kb bins place the depth transitions at \\\"\n      f\\\"~{seg['fine_edges_0based'][0]:,} and ~{seg['fine_edges_0based'][1]:,} \\\"\n      f\\\"(0-based).\\\")\n    a(f\\\"- **Discordant pairs:** {ins['n_discordant_pairs']} pair(s) in \\\"\n      f\\\"{len(ins['discordant_clusters'])} cluster(s):\\\")\n    for c in ins[\\\"discordant_clusters\\\"]:\n        a(f\\\"  - {c['n']} pair(s) bracketing left >= {c['left_lower_bound']:,}, \\\"\n          f\\\"right <= {c['right_upper_bound']:,}\\\")\n    a(f\\\"- **Split reads:** {len(bp['split_reads'])} read(s) spanning the \\\"\n      \\\"junction(s):\\\")\n    for sr in bp[\\\"split_reads\\\"]:\n        a(f\\\"  - {sr['end']} read {sr['read_id']} (strand {sr['strand']}): \\\"\n          f\\\"left junction at {sr['J_left']:,}, right junction at \\\"\n          f\\\"{sr['J_right']:,} ({sr['pre_matches']}/{sr['split']} and \\\"\n          f\\\"{sr['suf_matches']}/{READ_LEN-sr['split']} matches)\\\")\n    a(\\\"\\\")\n    a(\\\"## Evidence vs. precision limits\\\\n\\\")\n    a(\\\"- The **raw breakpoint estimates above are the experimental \\\"\n      f\\\"evidence** (method used for the final coordinates: \\\"\n      f\\\"{bp['raw_evidence_method']}). \\\" + bp[\\\"raw_note\\\"] + \\\".\\\")\n    a(\\\"- The task requires rounding each breakpoint to the nearest 100 kb; \\\"\n      \\\"this rounding, not the raw evidence, is the limiting precision of \\\"\n      \\\"the reported coordinates (+/-50 kb). The raw values are preserved in \\\"\n      \\\"\"'`output/qc.json` (breakpoints.raw_*).\")\n    a(\"- Depth binning alone would localize the deletion only to ~10 kb \"\n      \"(bin boundary uncertainty); discordant pairs bracket the junctions \"\n      \"to within the insert-size spread; split reads (when present) give \"\n      \"single-nucleotide junctions. All three signals agree on the same \"\n      \"interval.\")\n    a(\"\")\n    a(\"## Output files'\"\\\\n\\\")\n    a(\\\"- \"'`output/deletion.tsv` - final call (chrom, start_100kb, end_100kb, \"\n      \"size_bp, supporting_signals).\")\n    a(\"- `output/qc.json` - full QC metrics, raw breakpoint evidence and \"\n      \"precision notes.\")\n    a(\"- `output/analysis.py` - this analysis (self-contained, numpy only).\")\n    a(\"- `output/report.md` - this report.\")\n    a(\"\")\n    return \"'\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\n\n\nif __name__ == \\\"__main__\\\":\n    main()\n'@\n# truncate existing main section then append fixed version\npython -c \\\"\np='output/analysis.py'\ns=open(p,encoding='utf-8').read()\nm='# --------------------