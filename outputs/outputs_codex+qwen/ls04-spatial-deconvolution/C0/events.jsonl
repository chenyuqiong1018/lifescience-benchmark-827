{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\n\\\"\\\"\\\"Deconvolution of Visium spot Spot_710-1 using the matched single-cell reference.\n\nPrimary method:\n  1. Library-size (CPM) normalization of both the scRNA-seq reference cells and\n     the Visium spot counts (mixtures are linear in CPM space).\n  2. Build reference expression profiles as the mean CPM per annotated cell type.\n  3. Solve nonnegative least squares (NNLS):  spot_cpm ~= R @ w,  w >= 0,\n     then renormalize w to sum to 1.\n\nValidation (lightweight, independent):\n  - Cosine similarity and Pearson correlation of the spot profile against every\n    cell-type reference profile.\n  - Reconstruction quality (R\"'^2 and residual) of the fitted mixture.\n\"\"\"\nimport gzip\nimport os\n\nimport numpy as np\nimport pandas as pd\nfrom scipy.io import mmread\nfrom scipy.optimize import nnls\n\nHERE = os.path.dirname(os.path.abspath(__file__))          # output/\nROOT = os.path.dirname(HERE)                                # workspace/\nIN = os.path.join(ROOT, \"inputs\")\n\nTARGET_SPOT = \"Spot_710-1\"\n\n# ---------------------------------------------------------------- load Visium\nmat = mmread(os.path.join(IN, \"matrix.mtx.gz\")).toarray().astype(np.float64)\nwith gzip.open(os.path.join(IN, \"barcodes.tsv.gz\"), \"rt\") as fh:\n    barcodes = [l.strip() for l in fh]\nwith gzip.open(os.path.join(IN, \"features.tsv.gz\"), \"rt\") as fh:\n    genes = [l.strip().split(\"'\"\\\\t\\\")[1] for l in fh]\nvis = pd.DataFrame(mat, index=genes, columns=barcodes)\n\n# ---------------------------------------------------------------- load sc ref\nsc_counts = pd.read_csv(os.path.join(IN, \\\"spatial_q_sc_counts.csv\\\"), index_col=0)\nsc_meta = pd.read_csv(os.path.join(IN, \\\"spatial_q_sc_metadata.csv\\\"), index_col=0)\ncell_types = sorted(sc_meta[\\\"cell_type\\\"].unique())\n\n# shared gene set\nshared = [g for g in sc_counts.columns if g in vis.index]\nsc_counts = sc_counts[shared]\nspot = vis.loc[shared, TARGET_SPOT].to_numpy(dtype=np.float64)\n\n# ------------------------------------------------------------- CPM normalize\ndef cpm(df: pd.DataFrame) -> pd.DataFrame:\n    lib = df.sum(axis=1).to_numpy(dtype=np.float64)\n    return df.div(lib, axis=0) * 1e6\n\nsc_cpm = cpm(sc_counts)\nspot_cpm = spot / spot.sum() * 1e6\n\n# reference profiles: mean CPM per cell type (genes x cell_types)\nprof = pd.DataFrame(index=shared)\nfor ct in cell_types:\n    cells = sc_meta.index[sc_meta[\\\"cell_type\\\"] == ct]\n    prof[ct] = sc_cpm.loc[cells].mean(axis=0)\n\nR = prof.to_numpy(dtype=np.float64)          # genes x K\n# ------------------------------------------------------------ NNLS deconvolve\nw_raw, res = nnls(R, spot_cpm)\nw = w_raw / w_raw.sum()                      # sum exactly 1\n\n# ---------------------------------------------------------------- validation\ndef cos(a, b):\n    return float(np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b)))\n\ndef pearson(a, b):\n    a = a - a.mean(); b = b - b.mean()\n    return float(np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b)))\n\ncos_sim = {ct: cos(spot_cpm, prof[ct].to_numpy()) for ct in cell_types}\npear_sim = {ct: pearson(spot_cpm, prof[ct].to_numpy()) for ct in cell_types}\nrecon = R @ w_raw\nss_res = float(((spot_cpm - recon) ** 2).sum())\nss_tot = float(((spot_cpm - spot_cpm.mean()) ** 2).sum())\nr2 = 1.0 - ss_res / ss_tot\n\nprint(f\\\"spot total counts: {int(spot.sum())}, genes used: {len(shared)}\\\")\nprint(f\\\"NNLS residual: {res:.1f}, reconstruction R\"'^2: {r2:.4f}\")\nprint(\"cell_type | weight | cosine | pearson\")\nfor ct in sorted(cell_types, key=lambda c: -w[cell_types.index(c)]):\n    i = cell_types.index(ct)\n    print(f\"{ct:18s} | {w[i]:.4f} | {cos_sim[ct]:.4f} | {pear_sim[ct]:.4f}\")\n\n# ------------------------------------------------------------------- output\nos.makedirs(HERE, exist_ok=True)\nrows = []\nfor ct in sorted(cell_types, key=lambda c: -w[cell_types.index(c)]):\n    i = cell_types.index(ct)\n    ev = (f\"NNLS weight on CPM mean-profile reference; cosine similarity of spot \"\n          f\"to {ct} profile={cos_sim[ct]:.3f}, pearson={pear_sim[ct]:.3f}, \"\n          f\"mixture reconstruction R2={r2:.3f}\")\n    rows.append({\"cell_type\": ct, \"weight\": round(float(w[i]), 4), \"evidence\": ev})\n\nout = pd.DataFrame(rows, columns=[\"cell_type\", \"weight\", \"evidence\"])\nassert (out[\"weight\"] >= 0).all(), \"weights must be nonnegative\"\nassert abs(out[\"weight\"].sum() - 1.0) <= 0.01, \"weights must sum to 1 within 0.01\"\nout.to_csv(os.path.join(HERE, \"spot_710_composition.csv\"), index=False)\nprint(\"wrote\", os.path.join(HERE, \"spot_710_composition.csv\"))\n\n# save intermediates for report generation\nnp.save(os.path.join(HERE, \"_weights.npy\"), np.array([cell_types, w], dtype=object), allow_pickle=True)\n'\"'@ | Set-Content -Encoding utf8 output/analysis.py; New-Item -ItemType Directory -Force output | Out-Null; python output/analysis.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
