       & (pos[\\\"array_col\\\"].between(r[\\\"array_col\\\"] - 1, r[\\\"array_col\\\"] + 1))\n         & (pos[\\\"barcode\\\"] \"'!= SPOT)\n         & (pos[\"in_tissue\"] == 1)]\nnb_comp = {}\nfor bc in nb[\"barcode\"]:\n    j = barcodes.index(bc)\n    v = np.asarray(mat[:, j].todense()).ravel().astype(float)\n    v = v / v.sum() * 1e6\n    wj, _ = nnls(A, v)\n    wj = wj / wj.sum()\n    nb_comp[bc] = {ct: float(wj[i]) for i, ct in enumerate(cell_types)}\nnb_mean = {ct: float(np.mean([nb_comp[b][ct] for b in nb_comp])) for ct in cell_types}\n\n# ---------------------------------------------------------------- write CSV\nkeep = [i for i, ct in enumerate(cell_types) if w[i] >= 0.005]\nwrep = w_raw[keep] / w_raw[keep].sum()\nrows = []\nfor i in keep:\n    ct = cell_types[i]\n    ev = (f\"NNLS weight {wrep[i]:.3f} (R2 fit {r2:.3f}); Pearson r vs {ct} centroid {corr[ct]:.3f}; \"\n          f\"{int(votes.get(ct, 0))}/{k} top correlated reference cells are {ct}; \"\n          f\"mean NNLS weight in 8 neighboring spots {nb_mean[ct]:.3f}\")\n    rows.append({\"cell_type\": ct, \"weight\": round(float(wrep[i]), 3), \"evidence\": ev})\nout = pd.DataFrame(rows, columns=[\"cell_type\", \"weight\", \"evidence\"])\nout.to_csv(os.path.join(WS, \"spot_710_composition.csv\"), index=False)\n\n# ---------------------------------------------------------------- console summary\nprint(\"Spot:\", SPOT, \"total UMIs:\", int(x.sum()))\nprint(\"NNLS raw weights:\", {ct: round(float(w[i]), 4) for i, ct in enumerate(cell_types)})\nprint(\"Reported weights:\", dict(zip(out.cell_type, out.weight)))\nprint(\"R2 of NNLS fit:\", round(r2, 4))\nprint(\"Centroid Pearson r:\", {ct: round(v, 3) for ct, v in corr.items()})\nprint(\"Top-%d cell votes:\" % k, votes.to_dict())\nprint(\"Neighbor mean composition:\", {ct: round(v, 3) for ct, v in nb_mean.items()})\nprint(\"Spot grid pos: array_row\", int(r[\"array_row\"]), \"array_col\", int(r[\"array_col\"]))\n\n# persist intermediate stats for report gener