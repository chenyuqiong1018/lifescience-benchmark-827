{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\n\\\"\\\"\\\"Independent verification of output/composition.csv + depleted_call.json.\n\nDifferent code path from output/analysis.py:\n  * library sizes via np.add.reduceat on CSR indptr (not .sum(axis=1))\n  * marker scores via sparse matmul against a genes x types weight matrix\n    (not per-type column slicing)\n  * expected totals parsed from the MTX header lines\n\\\"\\\"\\\"\nimport gzip, json\nimport numpy as np\nimport pandas as pd\nfrom scipy import sparse\nfrom scipy.io import mmread\n\ngenes = pd.read_csv(\\\"inputs/differential.composition.q1.genes.txt.gz\\\", sep=\\\"\\\\t\\\")\nsym = list(genes.gene_symbols)\nsym2i = {s: i for i, s in enumerate(sym)}\npanel = pd.read_csv(\\\"inputs/MARKER_PANEL.tsv\\\", sep=\\\"\\\\t\\\")\ntypes = list(panel.cell_type)\n\n# weight matrix: genes x types, 1/k_t per marker\nrows, cols = [], []\nfor t, (_, r) in enumerate(panel.iterrows()):\n    for g in r.markers.split(\\\",\\\"):\n        rows.append(sym2i[g]); cols.append(t)\nW = sparse.csr_matrix((np.ones(len(rows)) / np.array([len(r.markers.split(\\\",\\\")) for _, r in panel.iterrows()])[cols],\n                       (rows, cols)), shape=(len(sym), len(types)))\n\nexp = {}\nfor lab, tag in [(\\\"sample1\\\", \\\"1\\\"), (\\\"sample2\\\", \\\"2\\\")]:\n    with gzip.open(f\\\"inputs/differential.composition.q1.{tag}.mtx.gz\\\", \\\"rt\\\") as f:\n        while True:\n            ln = f.readline()\n            if not ln.startswith(\\\"%\\\"):\n                hdr = ln.strip(); break\n    ng, nc, nnz = map(int, hdr.split())\n    Xgc = mmread(f\\\"inputs/differential.composition.q1.{tag}.mtx.gz\\\").tocsr().astype(np.float64)\n    assert Xgc.shape == (ng, nc)\n    Xcg = Xgc.T.tocsr()\n    lib = np.add.reduceat(Xcg.data, Xcg.indptr[:-1]) if Xcg.nnz else np.zeros(nc)\n    # empty-row fix: reduceat trick valid only if all rows non-empty; check\n    assert (np.diff(Xcg.indptr) > 0).all(), \\\"empty rows need special handling\\\"\n    Xn = Xcg.multiply(10000.0 / lib[:, None]).tocsr()\n    Xn.data = np.log1p(Xn.data)\n    S = (Xn @ W).toarray()\n    lab_idx = np.argmax(S, axis=1)\n    counts = np.bincount(lab_idx, minlength=len(types))\n    exp[lab] = dict(types=types, counts=counts, total=nc,\n                    hc_marker_mean=float(np.asarray(Xn[:, [sym2i[g] for g in \\\"LHX1,ONECUT1,ONECUT2,PROX1,CALB1\\\".split(\\\",\\\")]].mean(axis=1)).mean()))\n    print(f\\\"{lab}: header cells={nc}, assigned={counts.sum()}, \\\"\n          f\\\"mean horiz-cell marker expr (all cells)={exp[lab]['hc_marker_mean']:.4f}\\\")\n\ncomp = pd.read_csv(\\\"output/composition.csv\\\")\nok = True\nfor lab in [\\\"sample1\\\", \\\"sample2\\\"]:\n    sub = comp[comp.sample == lab].set_index(\\\"cell_type\\\")\n    assert sub.index.tolist() == types, \\\"row order/type mismatch\\\"\n    if not (sub.n_cells.to_numpy() == exp[lab][\\\"counts\\\"]).all():\n        ok = False; print(f\\\"{lab}: COUNT MISMATCH\\\", sub.n_cells.to_numpy(), exp[lab][\\\"counts\\\"])\n    if not np.isclose(sub.fraction.sum(), 1.0, atol=1e-4):\n        ok = False; print(f\\\"{lab}: fractions sum {sub.fraction.sum()}\\\")\n    if int(sub.n_cells.sum()) \"'!= exp[lab][\"total\"]:\n        ok = False; print(f\"{lab}: total mismatch\")\n\ncall = json.load(open(\"output/depleted_call.json\"))\nf1 = comp[comp.sample == \"sample1\"].set_index(\"cell_type\").fraction\nf2 = comp[comp.sample == \"sample2\"].set_index(\"cell_type\").fraction\ncand = f1[f1 >= 0.01].index\nratios = (f2 / f1)[cand]\nbest = ratios.idxmin()\nprint(\"independent depleted call:\", best, \"ratio\", round(float(ratios[best]), 6),\n      \"| json says:\", call[\"depleted_cell_type\"], call[\"ratio_sample2_over_sample1\"])\nprint(\"candidate ratios:\", {k: round(float(v), 4) for k, v in ratios.items()})\nassert best == call[\"depleted_cell_type\"]\nassert np.isclose(ratios[best], call[\"ratio_sample2_over_sample1\"], atol=1e-5)\nassert exp[\"sample2\"][\"hc_marker_mean\"] < exp[\"sample1\"][\"hc_marker_mean\"], \"direction check\"\nprint(\"MT- genes in symbol list:\", sum(1 for s in sym if s.startswith(\"MT-\")))\nprint(\"VERIFICATION:\", \"PASS\" if ok else \"FAIL\")\n'\"'@ | Set-Content -Encoding utf8 _verify.py\npython _verify.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
