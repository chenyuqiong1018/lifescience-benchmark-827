ex\npickle.dump({'hs': dict(hs), 'nr': dict(nr)}, open('scratch/symbol_index.pkl','wb'))\n'@ | Set-Content -Encoding utf8 scratch/check_markers.py; python scratch/check_markers.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
