]:12s}  ({d['e_ab']:+.2f} / {d['e_ba']:+.2f})\\\")\n\n# ---- decision (same criteria as output/analysis.py)\ntop, second = pairs[0], pairs[1]\na, b = top['organ_a'], top['organ_b']\nbest_sample_of = {o: ORGANS[max(range(15), key=lambda k: S[o][k])] for o in ORGANS}\nprint('\\\\nbest sample per marker set:', best_sample_of)\nboth_positive = top['e_ab'] > 0 and top['e_ba'] > 0\nmutual_best = best_sample_of[a] == b and best_sample_of[b] == a\ndisplaced = best_sample_of[a] \"'!= a and best_sample_of[b] != b\nmargin = top['\"'swap_score'] - second['swap_score']\nscore_ok = top['swap_score'] >= 1.0\ndetected = bool(both_positive and score_ok and margin >= 0.2 and mutual_best and displaced)\nprint(f'top={a}<->{b} score={top[\\\"swap_score\\\"]:+.3f} second={second[\\\"organ_a\\\"]}<->{second[\\\"organ_b\\\"]} '\n      f'{second[\\\"swap_score\\\"]:+.3f} margin={margin:+.3f} both_positive={both_positive} '\n      f'mutual_best={mutual_best} displaced={displaced} -> swap_detected={detected}')\n\nconfidence = min(0.97, 0.60 + 0.20*min(margin/0.5, 1.0)\n                 + 0.10*min(top['swap_score']/2.0, 1.0)\n                 + 0.07*min(abs(top['e_ab'])+abs(top['e_ba']), 2.0)/2.0)\nconfidence = round(confidence, 2)\n\nevidence = (\n f\\\"Reciprocal marker mismatch unique to one organ pair. (1) The column labeled '{b}' shows the highest \\\"\n f\\\"accessibility of {a} marker genes (CDX2/HOXC10-13 posterior endoderm program: z={S[a][IDX[b]]:+.2f} vs \\\"\n f\\\"{S[a][IDX[a]]:+.2f} in column '{a}'), including CDX2 z=+2.34, HOXC11 z=+2.02, MSMB z=+2.63 and HOXB13 z=+1.35, \\\"\n f\\\"a cloaca/urogenital-sinus expression program. (2) The column labeled '{a}' shows the highest accessibility of \\\"\n f\\\"{b} marker genes (z={S[b][IDX[a]]:+.2f} vs {S[b][IDX[b]]:+.2f} in column '{b}'), driven by stomach hallmarks \\\"\n f\\\"CLDN18 z=+3.24, TFF3.2 z=+2.91, SHH z=+2.52, GKN1-family z up to +2.81, MUC5AC/MUC2-family z up to +2.71. \\\"\n f\\\"(3) All 13 remaining organs best-match their own labeled columns (self z +0.84 to +1.46 for the strongly \\\"\n f\\\"marked organs), and genome-wide log2-CPM correlations show no additional misplaced sample. \\\"\n f\\\"Swap score {top['swap_score']:+.2f} (e({a}->{b})={top['e_ab']:+.2f}, e({b}->{a})={top['e_ba']:+.2f}) vs \\\"\n f\\\"runner-up {second['organ_a']}<->{second['organ_b']} {second['swap_score']:+.2f}.\\\")\n\nos.makedirs('output', exist_ok=True)\ncall = {'swap_detected': detected, 'organ_a': a, 'organ_b': b,\n        'confidence': confidence, 'evidence': evidence}\nwith io.open('output/swap_call.json', 'w', encoding='utf-8') as fh:\n    json.dump(call, fh, indent=2, ensure_ascii=False)\nprint('\\\\nswap_call.json:', json.dumps(call, indent=2)[:400], '...')\n\nwith io.open('output/sample_similarity.csv', 'w', encoding='utf-8', newline='') as fh:\n    fh.write('organ_a,organ_b,swap_score,rank,evidence_type\\\\n')\n    for d in pairs:\n        ev = 'promoter_accessibility+marker_coherence'\n        if d['rank'] == 1 and detected:\n            ev += '+hallmark_genes'\n        fh.write(f\\\"{d['organ_a']},{d['organ_b']},{d['swap_score']:.6f},{d['rank']},{ev}\\\\n\\\")\nprint('sample_similarity.csv written')\n\n# dump refined matrix for the report\nwith io.open('scratch/final_matrix.json', 'w', encoding='utf-8') as fh:\n    json.dump({'S': S, 'pairs': pairs}, fh, indent=1)\n'@ | Set-Content -Encoding utf8 scratch/finalize.py; python scratch/finalize.py\"","aggregated_output":"refined Stomach row : ['+0.18', '-0.20', '+0.88', '-0.76', '+0.40', '-0.36', '+0.35', '-0.17', '+0.01', '-0.37', '+0.14', '-0.08', '+0.21', '+0.11', '-0.28']\r\nrefined Prostate row: ['+0.15', '-0.20', '+0.22', '-1.05', '+0.38', '-0.10', '-0.10', '-0.33', '+0.25', '+0.07', '+0.56', '-0.53', '+0.04', '-0.07', '+0.70']\r\n\r\nfull ranking:\r\n    1   +1.857  Cloaca       <-> Stomach       (+0.69 / +1.17)\r\n    2   +1.149  Prostate     <-> Stomach       (+0.66 / +0.49)\r\n    3   +0.986  Bladder      <-> Stomach       (+0.52 / +0.4