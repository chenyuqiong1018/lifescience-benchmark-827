 own labeled columns (self z +0.84 to +1.46 for the strongly \\\"\n f\\\"marked organs), and genome-wide log2-CPM correlations show no additional misplaced sample. \\\"\n f\\\"Swap score {top['swap_score']:+.2f} (e({a}->{b})={top['e_ab']:+.2f}, e({b}->{a})={top['e_ba']:+.2f}) vs \\\"\n f\\\"runner-up {second['organ_a']}<->{second['organ_b']} {second['swap_score']:+.2f}.\\\")\n\nos.makedirs('output', exist_ok=True)\ncall = {'swap_detected': detected, 'organ_a': a, 'organ_b': b,\n        'confidence': confidence, 'evidence': evidence}\nwith io.open('output/swap_call.json', 'w', encoding='utf-8') as fh:\n    json.dump(call, fh, indent=2, ensure_ascii=False)\nprint('\\\\nswap_call.json:', json.dumps(call, indent=2)[:400], '...')\n\nwith io.open('output/sample_similarity.csv', 'w', encoding='utf-8', newline='') as fh:\n    fh.write('organ_a,organ_b,swap_score,rank,evidence_type\\\\n')\n    for d in pairs:\n        ev = 'promoter_accessibility+marker_coherence'\n        if d['rank'] == 1 and detected:\n            ev += '+hallmark_genes'\n        fh.write(f\\\"{d['organ_a']},{d['organ_b']},{d['swap_score']:.6f},{d['rank']},{ev}\\\\n\\\")\nprint('sample_similarity.csv written')\n\n# dump refined matrix for the report\nwith io.open('scratch/final_matrix.json', 'w', encoding='utf-8') as fh:\n    json.dump({'S': S, 'pairs': pairs}, fh, indent=1)\n'@ | Set-Content -Encoding utf8 scratch/finalize.py; python scratch/finalize.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
