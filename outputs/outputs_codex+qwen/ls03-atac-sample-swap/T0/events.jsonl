{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport gzip, re, pickle, collections, bisect, json, time\n\nTSS_WIN = 2000\nFLANK = 100000\n\npieces = []\narm_len = collections.defaultdict(int)\nwith open('inputs/sample.swap.atac.q1.chrom.sizes') as f:\n    for line in f:\n        p, ln = line.rstrip('\\\\n').split('\\\\t')\n        arm = re.sub(r'_\\\\d+\"'$'\"', '', p)\n        off = arm_len[arm]\n        pieces.append((p, arm, off, int(ln)))\n        arm_len[arm] += int(ln)\npiece_info = {p: (arm, off, ln) for p, arm, off, ln in pieces}\n\nresolved = pickle.load(open('scratch/resolved_markers.pkl', 'rb'))\norgans = sorted(resolved.keys())\ngenes_all = []\norgan_gene_idx = {}\ngi = 0\nfor organ in organs:\n    idxs = []\n    for g in resolved[organ]:\n        genes_all.append(g)\n        idxs.append(gi)\n        gi += 1\n    organ_gene_idx[organ] = idxs\nG = len(genes_all)\nprint('total marker genes:', G)\n\n# build per-piece targets\ntargets_by_piece = collections.defaultdict(list)  # piece -> list of (wstart, wend, gidx, kind)\ndef add_windows(piece, arm, off, ln, tss0, gidx):\n    # promoter\n    ws, we = tss0 - TSS_WIN, tss0 + TSS_WIN\n    ws, we = max(ws, 0), min(we, ln)\n    if ws < we:\n        targets_by_piece[piece].append([ws, we, gidx, 0])\n    # flank (excluding promoter portion)\n    fws, fwe = tss0 - FLANK, tss0 + FLANK\n    fws, fwe = max(fws, 0), min(fwe, ln)\n    if fws < we:  # left flank piece\n        targets_by_piece[piece].append([fws, min(ws, ln), gidx, 1]) if fws < min(ws, ln) else None\n    if max(we, 0) < fwe:  # right flank piece\n        targets_by_piece[piece].append([max(we, 0), fwe, gidx, 1])\n\nfor gidx, g in enumerate(genes_all):\n    arm = g['chrom']; tss0 = g['tss0']\n    for (p, a, off, ln) in pieces:\n        if a \"'!= arm:\n            continue\n        # gene tss in piece-local coordinates if within this piece\n        if off <= tss0 < off + ln:\n            ltss = tss0 - off\n            ws, we = ltss - TSS_WIN, ltss + TSS_WIN\n            # may spill across piece boundary; clip to this piece; also add spillover to neighbor handled by per-piece clipping of arm window\n        # use arm-space clipping then map to piece:\n    # simpler: compute arm-space windows and intersect with each piece of the arm\n    pws, pwe = tss0 - TSS_WIN, tss0 + TSS_WIN\n    fws, fwe = tss0 - FLANK, tss0 + FLANK\n    for (p, a, off, ln) in pieces:\n        if a != arm:\n            continue\n        lo, hi = off, off + ln\n        # promoter intersect\n        s_, e_ = max(pws, lo), min(pwe, hi)\n        if s_ < e_:\n            targets_by_piece[p].append([s_ - off, e_ - off, gidx, 0])\n        # flank left: [fws, pws) intersect piece\n        s_, e_ = max(fws, lo), min(pws, hi)\n        if s_ < e_:\n            targets_by_piece[p].append([s_ - off, e_ - off, gidx, 1])\n        # flank right: (pwe, fwe] intersect piece\n        s_, e_ = max(pwe, lo), min(fwe, hi)\n        if s_ < e_:\n            targets_by_piece[p].append([s_ - off, e_ - off, gidx, 1])\n\nfor p in targets_by_piece:\n    targets_by_piece[p].sort(key=lambda t: t[0])\nprint('\"'pieces with targets:', len(targets_by_piece))\n\nimport numpy as np\nn_samples = 15\nprom = np.zeros((G, n_samples), dtype=np.int64)\nflank = np.zeros((G, n_samples), dtype=np.int64)\nprom_bins = np.zeros(G, dtype=np.int64)\nflank_bins = np.zeros(G, dtype=np.int64)\ncolsum = np.zeros(n_samples, dtype=np.int64)\n\nt0 = time.time()\nactive = []\ncur_piece = None\nptr = 0\nstarts = []\nwith gzip.open('inputs/sample.swap.atac.q1.tsv.gz', 'rt') as f:\n    header = f.readline().rstrip('\\\\n').split('\\\\t')\n    samples = header[3:]\n    assert len(samples) == n_samples, samples\n    for line in f:\n        parts = line.rstrip('\\\\n').split('\\\\t')\n        piece = parts[0]\n        s = int(parts[1]); e = int(parts[2])\n        vals = [int(x) for x in parts[3:]]\n        for k in range(n_samples):\n            colsum[k] += vals[k]\n        if piece \"'!= cur_piece:\n            cur_piece = piece\n            targets = targets_by_piece.get(piece, [])\n            starts = [t[0] for t in targets]\n            active = []\n            ptr = 0\n        if not starts:\n            continue\n        # activate targets with start < e\n        while ptr < len(starts) and starts[ptr] < e:\n            t = targets_by_piece[piece][ptr]\n            active.append(t)\n            ptr += 1\n        # drop expired\n        if active:\n            active = [t for t in active if t[1] > s]\n        if active:\n            # which active are promoter targets for this row (to exclude from flank)\n            prom_g = {t[2] for t in active if t[3] == 0 and t[0] < e and t[1] > s}\n            for t in active:\n                if t[0] >= e or t[1] <= s:\n                    continue\n                gidx = t[2]\n                if t[3] == 0:\n                    for k in range(n_samples):\n                        prom[gidx, k] += vals[k]\n                    prom_bins[gidx] += 1\n                else:\n                    if gidx in prom_g:\n                        continue\n                    for k in range(n_samples):\n                        flank[gidx, k] += vals[k]\n                    flank_bins[gidx] += 1\nprint('\"'stream done in', round(time.time() - t0, 1), 's')\nprint('colsums:', dict(zip(samples, colsum.tolist())))\nnp.savez('scratch/raw_counts.npz', prom=prom, flank=flank, prom_bins=prom_bins, flank_bins=flank_bins, colsum=colsum, samples=np.array(samples))\npickle.dump({'genes_all': genes_all, 'organ_gene_idx': organ_gene_idx, 'organs': organs}, open('scratch/meta.pkl', 'wb'))\nprint('prom_bins stats:', prom_bins.min(), prom_bins.max(), 'flank_bins:', flank_bins.min(), flank_bins.max())\n'@ | Set-Content -Encoding utf8 scratch/step2_stream.py; python scratch