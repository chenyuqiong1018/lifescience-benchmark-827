{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport pickle, gzip, re, collections\n\ngenes = pickle.load(open('scratch/gene_index.pkl','rb'))\n# index by gid\nby_gid = {}\nby_pos = collections.defaultdict(list)\nfor (c,s,e,st,gid,gname) in genes:\n    by_gid[gid] = (c,s,e,st,gname)\n    by_pos[c].append((s,e,gid,gname,st))\nfor c in by_pos:\n    by_pos[c].sort()\n\ndef neighborhood(gid, win=3_000_000):\n    c,s,e,st,gname = by_gid[gid]\n    out = []\n    for (s2,e2,g2,n2,st2) in by_pos[c]:\n        if abs(s2 - s) <= win and g2 \"'!= gid:\n            out.append((s2, g2, n2))\n    return c, s, e, st, gname, out\n\nfor gid in ['\"'AMEX60DD005979','AMEX60DD002375','AMEX60DD001701','AMEX60DD007982','AMEX60DD021953','AMEX60DD007019','AMEX60DD006472','AMEX60DD007436','AMEX60DD004459','AMEX60DD004464']:\n    try:\n        c,s,e,st,gname,nb = neighborhood(gid)\n    except KeyError:\n        # try to find by suffix\n        hit = [k for k in by_gid if k.endswith(gid[-6:])]\n        print(gid, 'not found, candidates:', hit[:4]); continue\n    print(f'== {gid} {gname}  {c}:{s}-{e} ({st})  neighbors within 3Mb:')\n    for (s2,g2,n2) in nb[:14]:\n        print(f'     {s2:>12d} {g2} {n2}')\n'@ | Set-Content -Encoding utf8 scratch/step10_synteny.py; python scratch/step10_synteny.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
