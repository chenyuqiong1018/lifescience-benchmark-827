{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport numpy as np, pickle\n\nd = np.load('scratch/raw_counts.npz', allow_pickle=True)\nprom, flank = d['prom'], d['flank']\nprom_bins, flank_bins = d['prom_bins'], d['flank_bins']\ncolsum = d['colsum']; samples = list(d['samples'])\nmeta = pickle.load(open('scratch/meta.pkl','rb'))\norgans = meta['organs']; organ_gene_idx = meta['organ_gene_idx']; genes_all = meta['genes_all']\nvalid = prom_bins >= 1\ncpm = 1e6\nprom_pb = (prom / colsum) * cpm / np.maximum(prom_bins,1)[:,None]\nflank_pb = (flank / colsum) * cpm / np.maximum(flank_bins,1)[:,None]\neps = 0.05\nfold = prom_pb / (flank_pb + eps)\ndef zscore_rows(X):\n    mu = X.mean(axis=1, keepdims=True); sd = X.std(axis=1, keepdims=True); sd[sd==0]=1\n    return (X-mu)/sd\nZf = zscore_rows(np.log2(fold+1e-3))\nZc = zscore_rows(np.log2(prom_pb+eps))\nZ = 0.5*(Zf+Zc)\n\nshow = ['Gill','GallBladder']\nprint('gene-level z for Gill & GallBladder marker genes')\nprint('gene'.ljust(26) + ''.join(s[:8].rjust(9) for s in samples))\nfor organ in show:\n    print(f'--- {organ}')\n    for g in organ_gene_idx[organ]:\n        if not valid[g]: continue\n        gg = genes_all[g]\n        label = f\\\"{gg['symbol']}:{gg['gid'][-4:]}\\\"\n        print(label.ljust(26) + ''.join(f'{v:9.2f}' for v in Z[g]))\n\n# swap score matrix with consensus organ scores\nsc = pickle.load(open('scratch/scores.pkl','rb'))\nscore = sc['score']\nprint('\\\\n=== directed evidence e(A->B) = score(A-markers, B-col) - score(A-markers, A-col) ===')\nn = len(organs)\nE = np.full((n,n), np.nan)\nfor i in range(n):\n    for j in range(n):\n        if i==j: continue\n        E[i,j] = score[i,j] - score[i,i]\nprint('e(A->B): rows=A(labeled), cols=B')\nprint(''.ljust(13) + ''.join(s[:9].rjust(10) for s in samples))\nfor i in range(