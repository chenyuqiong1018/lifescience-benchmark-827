{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport gzip, time, numpy as np, collections, re\n\nt0 = time.time()\n# pass: collect bins x samples as float32, log-CPM later\nrows = 0\ncols = None\nchunks = []\nwith gzip.open('inputs/sample.swap.atac.q1.tsv.gz','rt') as f:\n    header = f.readline().rstrip('\\\\n').split('\\\\t')\n    samples = header[3:]\n    buf = np.zeros((200000, len(samples)), dtype=np.float32)\n    bi = 0\n    for line in f:\n        parts = line.split('\\\\t')\n        vals = [int(x) for x in parts[3:]]\n        buf[bi] = vals\n        bi += 1\n        if bi == buf.shape[0]:\n            chunks.append(buf)\n            buf = np.zeros_like(buf)\n            bi = 0\n    if bi:\n        chunks.append(buf[:bi])\nX = np.vstack(chunks)\nprint('matrix', X.shape, 'in', round(time.time()-t0,1), 's')\n\nlib = X.sum(axis=0)\nprint('libs:', dict(zip(samples, lib.astype(int).tolist())))\n\n# QC: fraction of bins with any signal, promoter fraction computed elsewhere\nprint('frac bins all-zero per sample:')\nnz = (X > 0).mean(axis=0)\nfor s, v in zip(samples, nz):\n    print(f'  {s:12s} {v:.4f}')\n\n# log-CPM transform\ncpm = X / lib * 1e6\nnp.log2(cpm + 0.1, out=cpm)\n# standardize columns\nmu = cpm.mean(axis=0); sd = cpm.std(axis=0)\nZ = (cpm - mu) / sd\nZ = Z.astype(np.float32)\nC = (Z.T @ Z) / Z.shape[0]\nprint('\\\\ngenome-wide Pearson correlation (log2 CPM):')\nprint(''.ljust(12) + ''.join(s[:8].rjust(9) for s in samples))\nfor i, s in enumerate(samples):\n    print(s.ljust(12) + ''.join(f'{C[i,j]:9.3f}' for j in range(len(samples))))\nnp.save('scratch/corr.npy', C)\n'@ | Set-Content -Encoding utf8 scratch/step6_corr.py; python scratch/step6_corr.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
