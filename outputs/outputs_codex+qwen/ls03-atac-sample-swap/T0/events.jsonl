{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport numpy as np, pickle\n\nd = np.load('scratch/raw_counts.npz', allow_pickle=True)\nprom, flank = d['prom'], d['flank']\nprom_bins, flank_bins = d['prom_bins'], d['flank_bins']\ncolsum = d['colsum']; samples = list(d['samples'])\nmeta = pickle.load(open('scratch/meta.pkl','rb'))\norgans = meta['organs']; organ_gene_idx = meta['organ_gene_idx']; genes_all = meta['genes_all']\n\nvalid = prom_bins >= 1\ncpm = 1e6\nprom_pb = (prom / colsum) * cpm / np.maximum(prom_bins,1)[:,None]\nflank_pb = (flank / colsum) * cpm / np.maximum(flank_bins,1)[:,None]\neps = 0.05\nfold = prom_pb / (flank_pb + eps)\ndef zscore_rows(X):\n    mu = X.mean(axis=1, keepdims=True); sd = X.std(axis=1, keepdims=True); sd[sd==0]=1\n    return (X-mu)/sd\nZf = zscore_rows(np.log2(fold+1e-3))\nZc = zscore_rows(np.log2(prom_pb+eps))\nZ = 0.5*(Zf+Zc)\n\nweak = ['Bladder','Cloaca','GallBladder','Gill','Limb','Prostate','Stomach']\nprint('gene-level z (consensus) for weak-organ marker genes')\nprint('gene(sym/gid)'.ljust(30) + ''.join(s[:8].rjust(9) for s in samples))\nfor organ in weak:\n    print(f'--- {organ}')\n    for g in organ_gene_idx[organ]:\n        if not valid[g]: continue\n        gg = genes_all[g]\n        label = f\\\"{gg['symbol']}:{gg['gid'][-4:]}\\\"\n        print(label.ljust(30) + ''.join(f'{v:9.2f}' for v in Z[g]))\n'@ | Set-Content -Encoding utf8 scratch/step4_geneview.py; python scratch/step4_geneview.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
