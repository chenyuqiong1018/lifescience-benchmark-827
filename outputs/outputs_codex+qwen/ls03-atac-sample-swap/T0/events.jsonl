{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport gzip, re, pickle, collections, time, numpy as np\n\nTSS_WIN = 2000\nFLANK = 100000\n\npieces = []\narm_len = collections.defaultdict(int)\nwith open('inputs/sample.swap.atac.q1.chrom.sizes') as f:\n    for line in f:\n        p, ln = line.rstrip('\\\\n').split('\\\\t')\n        arm = re.sub(r'_\\\\d+\"'$'\"', '', p)\n        off = arm_len[arm]\n        pieces.append((p, arm, off, int(ln)))\n        arm_len[arm] += int(ln)\npiece_by_arm = collections.defaultdict(list)\nfor (p, arm, off, ln) in pieces:\n    piece_by_arm[arm].append((p, off, ln))\n\ngenes = pickle.load(open('scratch/gene_index.pkl','rb'))\n# keep only genes on arms, dedupe by (chrom, tss)\nseen = set()\ngg = []\nfor (c, s, e, st, gid, gname) in genes:\n    if c not in arm_len: continue\n    tss0 = (s-1) if st=='+' else e\n    key = (c, tss0)\n    if key in seen: continue\n    seen.add(key)\n    gg.append((c, tss0, gid, gname))\nprint('genes on arms (deduped by tss):', len(gg))\n\ntargets_by_piece = collections.defaultdict(list)\nfor gidx, (c, tss0, gid, gname) in enumerate(gg):\n    pws, pwe = tss0 - TSS_WIN, tss0 + TSS_WIN\n    fws, fwe = tss0 - FLANK, tss0 + FLANK\n    for (p, off, ln) in piece_by_arm[c]:\n        lo, hi = off, off+ln\n        s_, e_ = max(pws, lo), min(pwe, hi)\n        if s_ < e_: targets_by_piece[p].append([s_-off, e_-off, gidx, 0])\n        s_, e_ = max(fws, lo), min(pws, hi)\n        if s_ < e_: targets_by_piece[p].append([s_-off, e_-off, gidx, 1])\n        s_, e_ = max(pwe, lo), min(fwe, hi)\n        if s_ < e_: targets_by_piece[p].append([s_-off, e_-off, gidx, 1])\nfor p in targets_by_piece:\n    targets_by_piece[p].sort(key=lambda t: t[0])\n\nG = len(gg)\nprom = np.zeros((G,15), dtype=np.int64)\nflank = np.zeros((G,15), dtype=np.int64)\nprom_bins = np.zeros(G, dtype=np.int32)\nflank_bins = np.zeros(G, dtype=np.int32)\ncolsum = np.zeros(15, dtype=np.int64)\n\nt0 = time.time()\ncur = None; active = []; ptr = 0; starts = []\nwith gzip.open('inputs/sample.swap.atac.q1.tsv.gz','rt') as f:\n    header = f.readline()\n    for line in f:\n        parts = line.split('\\\\t')\n        piece = parts[0]\n        s = int(parts[1]); e = int(parts[2])\n        vals = [int(x) for x in parts[3:]]\n        for k in range(15): colsum[k] += vals[k]\n        if piece \"'!= cur:\n            cur = piece\n            targets = targets_by_piece.get(piece, [])\n            starts = [t[0] for t in targets]\n            active = []; ptr = 0\n        if not starts: continue\n        while ptr < len(starts) and starts[ptr] < e:\n            active.append(targets[ptr]); ptr += 1\n        if active:\n            active = [t for t in active if t[1] > s]\n        if active:\n            prom_g = {t[2] for t in active if t[3]==0 and t[0] < e and t[1] > s}\n            for t in active:\n                if t[0] >= e or t[1] <= s: continue\n                gidx = t[2]\n                if t[3]==0:\n                    for k in range(15): prom[gidx,k] += vals[k]\n                    prom_bins[gidx] += 1\n                else:\n                    if gidx in prom_g: continue\n                    for k in range(15): flank[gidx,k] += vals[k]\n                    flank_bins[gidx] += 1\nprint('\"'done', round(time.time()-t0,1), 's')\nnp.savez('scratch/genome_counts.npz', prom=prom, flank=flank, prom_bins=prom_bins, flank_bins=flank_bins, colsum=colsum)\npickle.dump(gg, open('scratch/genome_genes.pkl','wb'))\n'@ | Set-Content -Encoding utf8 scratch/step7_genome.py; python scratch/step7_genome.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
