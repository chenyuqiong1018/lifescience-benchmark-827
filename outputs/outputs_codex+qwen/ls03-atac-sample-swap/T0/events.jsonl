{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"New-Item -ItemType Directory -Force output | Out-Null; @'\nimport gzip, re, pickle, collections, itertools, math, sys\n\nTSS_WIN = 2000      # promoter window +/- around TSS\nFLANK = 100000      # local background window +/- around TSS\n\n# ---------- 1. chrom pieces ----------\npieces = []          # (piece, arm, offset, length)\narm_len = collections.defaultdict(int)\nwith open('inputs/sample.swap.atac.q1.chrom.sizes') as f:\n    for line in f:\n        p, ln = line.rstrip('\\\\n').split('\\\\t')\n        arm = re.sub(r'_\\\\d+\"'$'\"', '', p)\n        off = arm_len[arm]\n        pieces.append((p, arm, off, int(ln)))\n        arm_len[arm] += int(ln)\npiece_info = {p: (arm, off, ln) for p, arm, off, ln in pieces}\nprint('arms:', len(arm_len), 'pieces:', len(pieces))\n\n# ---------- 2. genes ----------\ngenes = pickle.load(open('scratch/gene_index.pkl', 'rb'))  # (chrom,start,end,strand,gid,gname)\n\n# symbol index: tokens \\\"SYM [hs]\\\", \\\"SYM [nr]\\\" or plain \\\"SYM\\\"\nsym_index = collections.defaultdict(list)\nfor (c, s, e, st, gid, gname) in genes:\n    for tok in gname.split('|'):\n        tok = tok.strip()\n        m = re.match(r'\"'^(.*)'\"\\\\s+\\\\[(\\\\w+)\\\\]\"'$'\"', tok)\n        sym = m.group(1).strip() if m else tok\n        sym_index[sym].append((c, s, e, st, gid))\npickle.dump(dict(sym_index), open('scratch/symbol_index_full.pkl', 'wb'))\nprint('symbols indexed:', len(sym_index))\n\n# ---------- 3. marker sets ----------\nMARKERS = {\n 'Bladder': ['UPK1A','UPK1B','UPK2','UPK3A','UPK3B','KRT20','KRT8','KRT18','PPARG','SLC26A6','ELF3','FGFR3','PLAC8','GRHL3'],\n 'Brain': ['SNAP25','SYT1','SYN1','SYP','NCAM1','MAP2','TUBB3','NEFL','NEFM','NEFH','ENO2','GAD1','GAD2','GRIN1','GRIN2B','GFAP','MBP','PLP1','MOG','OLIG2','