{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport numpy as np, json, pickle, gzip, re\nfrom collections import defaultdict\n# rebuild gene list (same order as P rows)\nhs_re=re.compile(r\\\"([A-Za-z0-9][A-Za-z0-9\\\\-.]*) \\\\[hs\\\\]\\\")\ngenes=[]\nwith gzip.open(r'inputs/AmexT_v47-AmexG_v6.0-DD.gtf.gz','rt') as f:\n    for line in f:\n        if line.startswith('#'): continue\n        p=line.split('\\\\t')\n        if p[2]\"'!='\"'gene' or not p[0].startswith('chr'): continue\n        hs=hs_re.findall(p[8])\n        if hs: genes.append((p[8].split(';')[0], hs[0]))\nP=np.load('scratch_P.npy')\nprint('rows', P.shape, 'genes', len(genes))\nmeta=json.load(open('scratch_meta.json'))\norgans=meta['organs']\nMARKERS=meta['used']  # symbols only\nsym2idx=defaultdict(list)\nfor i,(gid,sym) in enumerate(genes):\n    pass\n# need full hs list; redo quickly\nsym2idx=defaultdict(list)\nhs_all=[]\nwith gzip.open(r'inputs/AmexT_v47-AmexG_v6.0-DD.gtf.gz','rt') as f:\n    i=-1\n    for line in f:\n        if line.startswith('#'): continue\n        p=line.split('\\\\t')\n        if p[2]\"'!='\"'gene' or not p[0].startswith('chr'): continue\n        hs=hs_re.findall(p[8])\n        if not hs: continue\n        i+=1\n        for h in set(hs): sym2idx[h].append(i)\nfor o,ms in MARKERS.items():\n    print('='*10, o, '='*10)\n    idxs=[]\n    for s in ms: idxs.extend(sym2idx.get(s,[]))\n    idxs=sorted(set(idxs))\n    for i in idxs:\n        v=P[i]\n        order=np.argsort(v)[::-1]\n        top=', '.join(f'{organs[j]}:{v[j]:.1f}' for j in order[:3])\n        selfv=v[organs.index(o)]\n        print(f'  {genes[i][1]:10s} self={selfv:7.1f} | {top}')\n'@ | Set-Content -Encoding utf8 scratch_detail.py; python scratch_detail.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
