{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\n#\"'!/usr/bin/env python\n\"\"\"Detect a swapped pair of organ labels in axolotl bulk ATAC-seq data.\n\nApproach\n--------\nThe count matrix is a genome-wide 10 kb bin x organ table. Swapping two\ncolumn labels leaves the (label-free) correlation structure invariant, so\ndetection requires external biological knowledge. We use organ marker genes:\n\n1. Parse the AmexG v6 GTF, keep genes that carry a human ortholog symbol\n   (`... [hs]` in gene_name), and take their transcription start site (TSS).\n2. Map base chromosome coordinates (chr1p ...) onto the chunked assembly\n   used by the count table (chr1p_1, chr1p_2, ...) using chrom sizes.\n3. Promoter accessibility of a gene = sum of counts in 10 kb bins\n   overlapping TSS +/- 2 kb.\n4. Z-score each gene across the 15 organ columns (plus a rank-based score).\n5. Marker coherence matrix S[organ o, column c] = mean standardized\n   accessibility of o'\"'s marker genes in column c. If labels are correct,\n   S[o, o] is maximal for every o. A swap of labels a<->b produces\n   S[a, b] > S[a, a] and S[b, a] > S[b, b].\n6. swap_score(a, b) = (S[a,b]-S[a,a]) + (S[b,a]-S[b,b]); all unordered\n   pairs are ranked.\n\nOutputs: output/swap_call.json, output/sample_similarity.csv, output/report.md\n\\\"\\\"\\\"\nimport gzip\nimport itertools\nimport json\nimport math\nimport re\nfrom collections import OrderedDict, defaultdict\n\nimport numpy as np\nimport pandas as pd\n\nINPUTS = \\\"inputs\\\"\nOUT = \\\"output\\\"\nTSV = f\\\"{INPUTS}/sample.swap.atac.q1.tsv.gz\\\"\nSIZES = f\\\"{INPUTS}/sample.swap.atac.q1.chrom.sizes\\\"\nGTF = f\\\"{INPUTS}/AmexT_v47-AmexG_v6.0-DD.gtf.gz\\\"\nPROMOTER_PAD = 2000  # bp around TSS\nBIN = 10000\n\n# Organ marker gene sets (human ortholog symbols as annotated in the GTF).\nMARKERS = {\n    \\\"Bladder\\\": [\\\"UPK3B\\\", \\\"KRT13\\\", \\\"KRT4\\\", \\\"KRT5\\\", \\\"KRT19\\\"],\n    \\\"Brain\\\": [\\\"SNAP25\\\", \\\"SYT1\\\", \\\"SYT2\\\", \\\"TUBB3\\\", \\\"NEFL\\\", \\\"MBP\\\", \\\"MAG\\\", \\\"OLIG2\\\",\n              \\\"GAD1\\\", \\\"GAD2\\\", \\\"GRIN1\\\", \\\"GRIN3A\\\", \\\"GRIA2\\\", \\\"GRIA4\\\", \\\"SLC17A6\\\",\n              \\\"SLC6A1\\\", \\\"CHAT\\\", \\\"SCN2A\\\", \\\"HCN1\\\", \\\"PAX6\\\", \\\"SOX2\\\", \\\"EMX1\\\", \\\"EMX2\\\"],\n    \\\"Cloaca\\\": [\\\"HOXC13\\\", \\\"CDX2\\\", \\\"CDX4\\\", \\\"UPK3B\\\", \\\"KRT13\\\"],\n    \\\"GallBladder\\\": [\\\"KRT19\\\", \\\"HNF1B\\\", \\\"SLC26A6\\\", \\\"CFTR\\\", \\\"FABP6\\\"],\n    \\\"Gill\\\": [\\\"CA4\\\", \\\"CA5B\\\", \\\"RHAG\\\", \\\"SLC26A3\\\", \\\"SLC26A6\\\", \\\"SLC26A9\\\",\n             \\\"ATP1A1\\\", \\\"HBA1\\\", \\\"HBG1\\\", \\\"HBG2\\\"],\n    \\\"Heart\\\": [\\\"MYH6\\\", \\\"MYH7\\\", \\\"MYH7B\\\", \\\"ACTC1\\\", \\\"RYR2\\\", \\\"HCN4\\\", \\\"SCN5A\\\",\n              \\\"CACNA1C\\\", \\\"HAND2\\\", \\\"KCNH2\\\", \\\"GJA1\\\", \\\"ATP2A2\\\", \\\"MYLK3\\\"],\n    \\\"Intestine\\\": [\\\"CDX2\\\", \\\"CDX4\\\", \\\"FABP2\\\", \\\"FABP6\\\", \\\"VIL1\\\", \\\"MUC2\\\", \\\"MUC3B\\\",\n                  \\\"ALPI\\\", \\\"ANPEP\\\", \\\"REG4\\\", \\\"GUCY2C\\\", \\\"SLC9A3\\\", \\\"SLC26A3\\\"],\n    \\\"Kidney\\\": [\\\"UMOD\\\", \\\"SLC12A3\\\", \\\"LHX1\\\", \\\"CUBN\\\", \\\"LRP2\\\", \\\"CLCN5\\\", \\\"CLCNKB\\\",\n               \\\"SLC34A2\\\", \\\"SLC22A6\\\", \\\"SLC22A8\\\", \\\"AQP3\\\"],\n    \\\"Limb\\\": [\\\"ACTA1\\\", \\\"MYH1\\\", \\\"MYH2\\\", \\\"MYH3\\\", \\\"MYF5\\\", \\\"TNNC2\\\", \\\"TNNT3\\\", \\\"TNNI2\\\",\n             \\\"ACAN\\\", \\\"COL2A1\\\", \\\"MYL1\\\", \\\"RYR1\\\", \\\"CASQ1\\\", \\\"SCN4A\\\"],\n    \\\"Liver\\\": [\\\"APOA1\\\", \\\"APOA4\\\", \\\"APOE\\\", \\\"SERPINA1\\\", \\\"FGA\\\", \\\"CYP3A4\\\", \\\"ALDOB\\\",\n              \\\"G6PC\\\", \\\"F2\\\", \\\"UGT1A1\\\", \\\"CYP2A6\\\", \\\"CYP2C9\\\", \\\"CYP2D6\\\"],\n    \\\"Lung\\\": [\\\"SFTPA2B\\\", \\\"SFTPD\\\", \\\"MUC5B\\\", \\\"AQP5\\\"],\n    \\\"Pancreas\\\": [\\\"PDX1\\\", \\\"PRSS1\\\", \\\"PRSS2\\\", \\\"CPA1\\\", \\\"CPA2\\\", \\\"CPA3\\\", \\\"CPB1\\\",\n                 \\\"CELA2A\\\", \\\"CEL\\\", \\\"CTRB1\\\", \\\"AMY2A\\\", \\\"REG1B\\\", \\\"NEUROG3\\\", \\\"CHGA\\\",\n                 \\\"KCNJ11\\\"],\n    \\\"Prostate\\\": [\\\"TMPRSS2\\\", \\\"MSMB\\\", \\\"HOXB9\\\"],\n    \\\"Spleen\\\": [\\\"CD3E\\\", \\\"CD3G\\\", \\\"ZAP70\\\", \\\"CD8B\\\", \\\"GZMB\\\", \\\"PRF1\\\", \\\"IL7R\\\"],\n    \\\"Stomach\\\": [\\\"PGC\\\", \\\"MUC5AC\\\", \\\"TFF2\\\", \\\"MUC4\\\"],\n}\n\n\ndef load_chunk_map():\n    sizes = OrderedDict()\n    with open(SIZES) as f:\n        for line in f:\n            c, s = line.split()\n            sizes[c] = int(s)\n    base = OrderedDict()\n    for chunk, s in sizes.items():\n        b = re.sub(r\\\"_\\\\d+\"'$\", \"\", chunk)\n        base.setdefault(b, []).append((chunk, s))\n    cum = {}\n    for b, chunks in base.items():\n        offs, total = [], 0\n        for chunk, s in chunks:\n            offs.append((chunk, total, s))\n            total += s\n        cum[b] = (offs, total)\n    return sizes, cum\n\n\ndef locate(cum, chrom, pos):\n    \"\"\"Map base-chromosome 1-based position to (chunk, pos_in_chunk).\"\"\"\n    offs, total = cum[chrom]\n    if pos > total:\n        return None\n    for chunk, off, s in offs:\n        if pos <= off + s:\n            return chunk, pos - off\n    return None\n\n\ndef parse_genes(cum):\n    hs_re = re.compile(r\"([A-Za-z0-9][A-Za-z0-9'\"\\\\-.]*) \\\\[hs\\\\]\\\")\n    gid_re = re.compile(r'gene_id \\\"([\"'^\"]+)\"'\"')\n    gname_re = re.compile(r'gene_name \\\"([\"'^\"]+)\"'\"')\n    genes = []\n    with gzip.open(GTF, \\\"rt\\\") as f:\n        for line in f:\n            if line.startswith(\\\"#\\\"):\n                continue\n            p = line.split(\\\"\\\\t\\\")\n            if p[2] \"'!= \"gene\" or not p[0].startswith(\"chr\"):\n                continue\n            hs = hs_re.findall(p[8])\n            if not hs:\n                continue\n            gid = gid_re.search(p[8]).group(1)\n            gname = gname_re.search(p[8]).group(1)\n            tss = int(p[3]) if p[6] == \"+\" else int(p[4])\n            loc = locate(cum, p[0], tss)\n            if loc is None:\n                continue\n            genes.append({\"gid\": gid, \"name\": gname, \"hs\": tuple(sorted(set(hs))),\n                          \"chunk\": loc[0], \"tss\": loc[1]})\n    return genes\n\n\ndef load_matrix(sizes):\n    header = None\n    organs = None\n    arrays = {c: np.zeros((s // BIN + 2, 15), dtype=np.float32)\n              for c, s in sizes.items()}\n    present = {c: np.zeros(s // BIN + 2, dtype=bool) for c, s in sizes.items()}\n    reader = pd.read_csv(TSV, sep=\"'\"\\\\t\\\", chunksize=200_000)\n    for i, chunk in enumerate(reader):\n        if organs is None:\n            organs = list(chunk.columns[3:])\n        vals = chunk.iloc[:, 3:].to_numpy(dtype=np.float32)\n        starts = chunk[\\\"start\\\"].to_numpy()\n        for c in sizes:\n            sel = chunk[\\\"chrom\\\"].to_numpy() == c\n            if not sel.any():\n                continue\n            idx = starts[sel] // BIN\n            arrays[c][idx] = vals[sel]\n            present[c][idx] = True\n        if (i + 1) % 5 == 0:\n            print(f\\\"  loaded {(i + 1) * 200_000} rows\\\")\n    return organs, arrays, present\n\n\ndef promoter_matrix(genes, arrays, present, organs):\n    n = len(genes)\n    P = np.full((n, len(organs)), np.nan, dtype=np.float32)\n    skipped = 0\n    for i, g in enumerate(genes):\n        chunk, tss = g[\\\"chunk\\\"], g[\\\"tss\\\"]  # tss is 1-based within chunk\n        t0 = tss - 1  # 0-based\n        lo, hi = t0 - PROMOTER_PAD, t0 + PROMOTER_PAD\n        acc = np.zeros(len(organs), dtype=np.float64)\n        found = False\n        b = (lo // BIN) * BIN\n        while b <= hi:\n            if b >= 0:\n                idx = b // BIN\n                if idx < present[chunk].shape[0] and present[chunk][idx]:\n                    acc += arrays[chunk][idx]\n                    found = True\n            b += BIN\n        if found:\n            P[i] = acc\n        else:\n            skipped += 1\n    return P, skipped\n\n\ndef standardize(P):\n    mu = np.nanmean(P, axis=1, keepdims=True)\n    sd = np.nanstd(P, axis=1, keepdims=True)\n    ok = sd.ravel() > 1e-6\n    Z = (P - mu) / np.where(sd > 1e-6, sd, 1.0)\n    Z[~ok] = np.nan\n    # rank-based score per gene across organs: (rank - mean_rank)/mean_rank\n    R = np.argsort(np.argsort(np.nan_to_num(P, nan=-1), axis=1), axis=1).astype(np.float32)\n    m = R.shape[1]\n    R = (R - (m - 1) / 2.0) / ((m - 1) / 2.0)\n    R[~ok] = np.nan\n    return Z, R, ok\n\n\ndef marker_scores(organs, genes, Z, R, ok, sym2idx):\n    organs_idx = {o: j for j, o in enumerate(organs)}\n    scores_z = np.zeros((len(organs), len(organs)))\n    scores_r = np.zeros((len(organs), len(organs)))\n    used = {}\n    for o, ms in MARKERS.items():\n        gi = set()\n        for sym in ms:\n            gi.update(sym2idx.get(sym, []))\n        gi = sorted(i for i in gi if ok[i])\n        used[o] = gi\n        sub_z = Z[gi]\n        sub_r = R[gi]\n        scores_z[organs_idx[o]] = np.nanmean(sub_z, axis=0)\n        scores_r[organs_idx[o]] = np.nanmean(sub_r, axis=0)\n    T = 0.5 * (scores_z + scores_r)\n    return T, scores_z, scores_r, used\n\n\ndef main():\n    print(\\\"[1] chunk map\\\")\n    sizes, cum = load_chunk_map()\n    print(\\\"[2] parse GTF\\\")\n    genes = parse_genes(cum)\n    print(f\\\"    {len(genes)} genes with human ortholog symbols\\\")\n    sym2idx = defaultdict(list)\n    for i, g in enumerate(genes):\n        for h in g[\\\"hs\\\"]:\n            sym2idx[h].append(i)\n    print(\\\"[3] load count matrix\\\")\n    organs, arrays, present = load_matrix(sizes)\n    print(\\\"    organs:\\\", organs)\n    print(\\\"[4] promoter accessibility\\\")\n    P, skipped = promoter_matrix(genes, arrays, present, organs)\n    print(f\\\"    {P.shape[0]} genes, {skipped} without any mappable promoter bin\\\")\n    print(\\\"[5] standardize + marker scoring\\\")\n    Z, R, ok = standardize(P)\n    T, Sz, Sr, used = marker_scores(organs, genes, Z, R, ok, sym2idx)\n    for o in organs:\n        print(f\\\"    {o:12s} markers used: {len(used[o])}\\\")\n    print(\\\"[6] genome-wide correlations (log1p, label-free context)\\\")\n    # free memory before correlation\n    del arrays, present\n    # rebuild matrix for correlation from TSV again would be costly; instead\n    # compute per-organ totals and skip full corr (kept in report as optional)\n    lib = None\n    reader = pd.read_csv(TSV, sep=\\\"\\\\t\\\", chunksize=400_000)\n    lib = np.zeros(len(organs), dtype=np.float64)\n    for chunk in reader:\n        lib += chunk.iloc[:, 3:].to_numpy(dtype=np.float64).sum(axis=0)\n    print(\\\"    library sizes:\\\", dict(zip(organs, lib.astype(int))))\n\n    # ---- swap scoring ----\n    n = len(organs)\n    pair_scores = {}\n    for a, b in itertools.combinations(range(n), 2):\n        dab = T[a, b] - T[a, a]\n        dba = T[b, a] - T[b, b]\n        pair_scores[(organs[a], organs[b])] = (dab + dba, dab, dba)\n    ranked = sorted(pair_scores.items(), key=lambda kv: -kv[1][0])\n\n    top_pair, (top_score, dab, dba) = ranked[0]\n    second_pair, (second_score, *_rest) = ranked[1]\n    a_idx, b_idx = organs.index(top_pair[0]), organs.index(top_pair[1])\n    mutual = (np.nanargmax(T[a_idx]) == b_idx) and (np.nanargmax(T[b_idx]) == a_idx)\n    both_pos = dab > 0 and dba > 0\n\n    # self-consistency before/after correction\n    pre_self = [organs[i] for i in range(n) if np.nanargmax(T[i]) == i]\n    Tc = T.copy()\n    Tc[[a_idx, b_idx]] = Tc[[b_idx, a_idx]]  # relabel columns a<->b\n    post_self = [organs[i] for i in range(n) if np.nanargmax(Tc[i]) == i]\n\n    margin = top_score - second_score\n    conf_margin = min(1.0, margin / max(top_score, 1e-9)) if top_score > 0 else 0.0\n    conf_dir = 1.0 if (mutual and both_pos) else 0.0\n    conf_cons = len(post_self) / n\n    confidence = round(0.35 * conf_margin + 0.35 * conf_dir + 0.30 * conf_cons, 3)\n    swap_detected = bool(top_score > 0 and mutual and both_pos and\n                         len(post_self) == n and margin > 0.3 * top_score)\n\n    # ---- sample_similarity.csv ----\n    rows = []\n    rank_map = {pair: r + 1 for r, (pair, _v) in enumerate(ranked)}\n    for pair, (score, _dab, _dba) in ranked:\n        oa, ob = sorted(pair)\n        etype = (\\\"promoter_accessibility+marker_coherence(mutual_best)\\\"\n                 if pair == top_pair and swap_detected else\n                 \\\"promoter_accessibility+marker_coherence\\\")\n        rows.append({\\\"organ_a\\\": oa, \\\"organ_b\\\": ob,\n                     \\\"swap_score\\\": round(float(score), 4),\n                     \\\"rank\\\": rank_map[pair], \\\"evidence_type\\\": etype})\n    df = pd.DataFrame(rows).sort_values(\\\"swap_score\\\", ascending=False)\n    df.to_csv(f\\\"{OUT}/sample_similarity.csv\\\", index=False)\n\n    # ---- evidence details ----\n    ev_lines = []\n    ev_lines.append(f\\\"Top pair {top_pair[0]}<->{top_pair[1]}: swap_score={top_score:.3f} \\\"\n                    f\\\"(delta {organs[a_idx]}markers->{organs[b_idx]} col={dab:.3f}; \\\"\n                    f\\\"delta {organs[b_idx]}markers->{organs[a_idx]} col={dba:.3f}); \\\"\n                    f\\\"second best {second_pair} score={second_score:.3f}; margin={margin:.3f}\\\")\n    ev_lines.append(f\\\"mutual_best={mutual}, both_directions_positive={both_pos}, \\\"\n                    f\\\"self-consistent organs before correction={len(pre_self)}/15 {sorted(pre_self)}, \\\"\n                    f\\\"after correction={len(post_self)}/15\\\")\n    # marker detail for top pair: show raw promoter sums for their markers\n    detail = {}\n    for o in top_pair:\n        gi = used[o]\n        rows_d = []\n        for i in gi:\n            vals = P[i]\n            rows_d.append((genes[i][\\\"hs\\\"][0], genes[i][\\\"name\\\"],\n                           {organs[j]: float(vals[j]) for j in range(n)}))\n        detail[o] = rows_d\n\n    evidence = \\\"; \\\".join(ev_lines)\n    call = {\n        \\\"swap_detected\\\": swap_detected,\n        \\\"organ_a\\\": top_pair[0] if swap_detected else None,\n        \\\"organ_b\\\": top_pair[1] if swap_detected else None,\n        \\\"confidence\\\": confidence if swap_detected else confidence,\n        \\\"evidence\\\": evidence,\n    }\n    with open(f\\\"{OUT}/swap_call.json\\\", \\\"w\\\") as f:\n        json.dump(call, f, indent=2)\n\n    # console summary + dump arrays for report writing\n    print(\\\"\\\\n=== marker coherence matrix T (rows=marker set, cols=column) ===\\\")\n    print(pd.DataFrame(T, index=[f\\\"{o}-markers\\\" for o in organs], columns=organs)\n          .round(2).to_string())\n    print(\\\"\\\\nTop 8 pairs:\\\")\n    for pair, (s, x, y) in ranked[:8]:\n        print(f\\\"  {pair[0]:12s} {pair[1]:12s} score={s:7.3f} (dab={x:6.3f} dba={y:6.3f})\\\")\n    print(f\\\"\\\\nswap_detected={swap_detected} pair={top_pair} confidence={confidence}\\\")\n    np.save(\\\"scratch_T.npy\\\", T)\n    np.save(\\\"scratch_P.npy\\\", P)\n    with open(\\\"scratch_meta.json\\\", \\\"w\\\") as f:\n        json.dump({\\\"organs\\\": organs, \\\"used\\\": {k: [genes[i][\\\"hs\\\"][0] for i in v] for k, v in used.items()},\n                   \\\"pre_self\\\": pre_self, \\\"post_self\\\": post_self,\n                   \\\"lib\\\": dict(zip(organs, lib.astype(int).tolist())),\n                   \\\"detail\\\": {k: [(s[0], s[1], s[2]) for s in v] for k, v in detail.items()},\n                   \\\"ranked_top\\\": [((p[0][0], p[0][1]), p[1][0]) for p in ranked[:10]]}, f, indent=1)\n    print(\\\"done\\\")\n\n\nif __name__ == \\\"__main__\\\":\n    main()\n'@ | Set-Content -Encoding utf8 output/analysis.py; python output/analysis.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\n#\"'!/usr/bin/env python\n\"\"\"Detect a swapped pair of organ labels in axolotl bulk ATAC-seq data.\n\nApproach\n--------\nThe count matrix is a genome-wide 10 kb bin x organ table. Swapping two\ncolumn labels leaves the (label-free) correlation structure invariant, so\ndetection requires external biological knowledge. We use organ marker genes:\n\n1. Parse the AmexG v6 GTF, keep genes that carry a human ortholog symbol\n   (`... [hs]` in gene_name), and take their transcription start site (TSS).\n2. Map base chromosome coordinates (chr1p ...) onto the chunked assembly\n   used by the count table (chr1p_1, chr1p_2, ...) using chrom sizes.\n3. Promoter accessibility of a gene = sum of counts in 10 kb bins\n   overlapping TSS +/- 2 kb.\n4. Z-score each gene across the 15 organ columns (plus a rank-based score).\n5. Marker coherence matrix S[organ o, column c] = mean standardized\n   accessibility of o'\"'s marker genes in column c. If labels are correct,\n   S[o, o] is maximal for every o. A swap of labels a<->b produces\n   S[a, b] > S[a, a] and S[b, a] > S[b, b].\n6. swap_score(a, b) = (S[a,b]-S[a,a]) + (S[b,a]-S[b,b]); all unordered\n   pairs are ranked.\n\nOutputs: output/swap_call.json, output/sample_similarity.csv, output/report.md\n\\\"\\\"\\\"\nimport gzip\nimport itertools\nimport json\nimport math\nimport re\nfrom collections import OrderedDict, defaultdict\n\nimport numpy as np\nimport pandas as pd\n\nINPUTS = \\\"inputs\\\"\nOUT = \\\"output\\\"\nTSV = f\\\"{INPUTS}/sample.swap.atac.q1.tsv.gz\\\"\nSIZES = f\\\"{INPUTS}/sample.swap.atac.q1.chrom.sizes\\\"\nGTF = f\\\"{INPUTS}/AmexT_v47-AmexG_v6.0-DD.gtf.gz\\\"\nPROMOTER_PAD = 2000  # bp around TSS\nBIN = 10000\n\n# Organ marker gene sets (human ortholog symbols as annotated in the GTF).\nMARKERS = {\n    \\\"Bladder\\\": [\\\"UPK3B\\\", \\\"KRT13\\\", \\\"KRT4\\\", \\\"KRT5\\\", \\\"KRT19\\\"],\n    \\\"Brain\\\": [\\\"SNAP25\\\", \\\"SYT1\\\", \\\"SYT2\\\", \\\"TUBB3\\\", \\\"NEFL\\\", \\\"MBP\\\", \\\"MAG\\\", \\\"OLIG2\\\",\n              \\\"GAD1\\\", \\\"GAD2\\\", \\\"GRIN1\\\", \\\"GRIN3A\\\", \\\"GRIA2\\\", \\\"GRIA4\\\", \\\"SLC17A6\\\",\n              \\\"SLC6A1\\\", \\\"CHAT\\\", \\\"SCN2A\\\", \\\"HCN1\\\", \\\"PAX6\\\", \\\"SOX2\\\", \\\"EMX1\\\", \\\"EMX2\\\"],\n    \\\"Cloaca\\\": [\\\"HOXC13\\\", \\\"CDX2\\\", \\\"CDX4\\\", \\\"UPK3B\\\", \\\"KRT13\\\"],\n    \\\"GallBladder\\\": [\\\"KRT19\\\", \\\"HNF1B\\\", \\\"SLC26A6\\\", \\\"CFTR\\\", \\\"FABP6\\\"],\n    \\\"Gill\\\": [\\\"CA4\\\", \\\"CA5B\\\", \\\"RHAG\\\", \\\"SLC26A3\\\", \\\"SLC26A6\\\", \\\"SLC26A9\\\",\n             \\\"ATP1A1\\\", \\\"HBA1\\\", \\\"HBG1\\\", \\\"HBG2\\\"],\n    \\\"Heart\\\": [\\\"MYH6\\\", \\\"MYH7\\\", \\\"MYH7B\\\", \\\"ACTC1\\\", \\\"RYR2\\\", \\\"HCN4\\\", \\\"SCN5A\\\",\n              \\\"CACNA1C\\\", \\\"HAND2\\\", \\\"KCNH2\\\", \\\"GJA1\\\", \\\"ATP2A2\\\", \\\"MYLK3\\\"],\n    \\\"Intestine\\\": [\\\"CDX2\\\", \\\"CDX4\\\", \\\"FABP2\\\", \\\"FABP6\\\", \\\"VIL1\\\", \\\"MUC2\\\", \\\"MUC3B\\\",\n                  \\\"ALPI\\\", \\\"ANPEP\\\", \\\"REG4\\\", \\\"GUCY2C\\\", \\\"SLC9A3\\\", \\\"SLC26A3\\\"],\n    \\\"Kidney\\\": [\\\"UMOD\\\", \\\"SLC12A3\\\", \\\"LHX1\\\", \\\"CUBN\\\", \\\"LRP2\\\", \\\"CLCN5\\\", \\\"CLCNKB\\\",\n               \\\"SLC34A2\\\", \\\"SLC22A6\\\", \\\"SLC22A8\\\", \\\"AQP3\\\"],\n    \\\"Limb\\\": [\\\"ACTA1\\\", \\\"MYH1\\\", \\\"MYH2\\\", \\\"MYH3\\\", \\\"MYF5\\\", \\\"TNNC2\\\", \\\"TNNT3\\\", \\\"TNNI2\\\",\n             \\\"ACAN\\\", \\\"COL2A1\\\", \\\"MYL1\\\", \\\"RYR1\\\", \\\"CASQ1\\\", \\\"SCN4A\\\"],\n    \\\"Liver\\\": [\\\"APOA1\\\", \\\"APOA4\\\", \\\"APOE\\\", \\\"SERPINA1\\\", \\\"FGA\\\", \\\"CYP3A4\\\", \\\"ALDOB\\\",\n              \\\"G6PC\\\", \\\"F2\\\", \\\"UGT1A1\\\", \\\"CYP2A6\\\", \\\"CYP2C9\\\", \\\"CYP2D6\\\"],\n    \\\"Lung\\\": [\\\"SFTPA2B\\\", \\\"SFTPD\\\", \\\"MUC5B\\\", \\\"AQP5\\\"],\n    \\\"Pancreas\\\": [\\\"PDX1\\\", \\\"PRSS1\\\", \\\"PRSS2\\\", \\\"CPA1\\\", \\\"CPA2\\\", \\\"CPA3\\\", \\\"CPB1\\\",\n                 \\\"CELA2A\\\", \\\"CEL\\\", \\\"CTRB1\\\", \\\"AMY2A\\\", \\\"REG1B\\\", \\\"NEUROG3\\\", \\\"CHGA\\\",\n                 \\\"KCNJ11\\\"],\n    \\\"Prostate\\\": [\\\"TMPRSS2\\\", \\\"MSMB\\\", \\\"HOXB9\\\"],\n    \\\"Spleen\\\": [\\\"CD3E\\\", \\\"CD3G\\\", \\\"ZAP70\\\", \\\"CD8B\\\", \\\"GZMB\\\", \\\"PRF1\\\", \\\"IL7R\\\"],\n    \\\"Stomach\\\": [\\\"PGC\\\", \\\"MUC5AC\\\", \\\"TFF2\\\", \\\"MUC4\\\"],\n}\n\n\ndef load_chunk_map():\n    sizes = OrderedDict()\n    with open(SIZES) as f:\n        for line in f:\n            c, s = line.split()\n            sizes[c] = int(s)\n    base = OrderedDict()\n    for chunk, s in sizes.items():\n        b = re.sub(r\\\"_\\\\d+\"'$\", \"\", chunk)\n        base.setdefault(b, []).append((chunk, s))\n    cum = {}\n    for b, chunks in base.items():\n        offs, total = [], 0\n        for chunk, s in chunks:\n            offs.append((chunk, total, s))\n            total += s\n        cum[b] = (offs, total)\n    return sizes, cum\n\n\ndef locate(cum, chrom, pos):\n    \"\"\"Map base-chromosome 1-based position to (chunk, pos_in_chunk).\"\"\"\n    offs, total = cum[chrom]\n    if pos > total:\n        return None\n    for chunk, off, s in offs:\n        if pos <= off + s:\n            return chunk, pos - off\n    return None\n\n\ndef parse_genes(cum):\n    hs_re = re.compile(r\"([A-Za-z0-9][A-Za-z0-9'\"\\\\-.]*) \\\\[hs\\\\]\\\")\n    gid_re = re.compile(r'gene_id \\\"([\"'^\"]+)\"'\"')\n    gname_re = re.compile(r'gene_name \\\"([\"'^\"]+)\"'\"')\n    genes = []\n    with gzip.open(GTF, \\\"rt\\\") as f:\n        for line in f:\n            if line.startswith(\\\"#\\\"):\n                continue\n            p = line.split(\\\"\\\\t\\\")\n            if p[2] \"'!= \"gene\" or not p[0].startswith(\"chr\"):\n                continue\n            hs = hs_re.findall(p[8])\n            if not hs:\n                continue\n            gid = gid_re.search(p[8]).group(1)\n            gname = gname_re.search(p[8]).group(1)\n            tss = int(p[3]) if p[6] == \"+\" else int(p[4])\n            loc = locate(cum, p[0], tss)\n            if loc is None:\n                continue\n            genes.append({\"gid\": gid, \"name\": gname, \"hs\": tuple(sorted(set(hs))),\n                          \"chunk\": loc[0], \"tss\": loc[1]})\n    return genes\n\n\ndef load_matrix(sizes):\n    header = None\n    organs = None\n    arrays = {c: np.zeros((s // BIN + 2, 15), dtype=np.float32)\n              for c, s in sizes.items()}\n    present = {c: np.zeros(s // BIN + 2, dtype=bool) for c, s in sizes.items()}\n    reader = pd.read_csv(TSV, sep=\"'\"\\\\t\\\", chunksize=200_000)\n    for i, chunk in enumerate(reader):\n        if organs is None:\n            organs = list(chunk.columns[3:])\n        vals = chunk.iloc[:, 3:].to_numpy(dtype=np.float32)\n        starts = chunk[\\\"start\\\"].to_numpy()\n        for c in sizes:\n            sel = chunk[\\\"chrom\\\"].to_numpy() == c\n            if not sel.any():\n                continue\n            idx = starts[sel] // BIN\n            arrays[c][idx] = vals[sel]\n            present[c][idx] = True\n        if (i + 1) % 5 == 0:\n            print(f\\\"  loaded {(i + 1) * 200_000} rows\\\")\n    return organs, arrays, present\n\n\ndef promoter_matrix(genes, arrays, present, organs):\n    n = len(genes)\n    P = np.full((n, len(organs)), np.nan, dtype=np.float32)\n    skipped = 0\n    for i, g in enumerate(genes):\n        chunk, tss = g[\\\"chunk\\\"], g[\\\"tss\\\"]  # tss is 1-based within chunk\n        t0 = tss - 1  # 0-based\n        lo, hi = t0 - PROMOTER_PAD, t0 + PROMOTER_PAD\n        acc = np.zeros(len(organs), dtype=np.float64)\n        found = False\n        b = (lo // BIN) * BIN\n        while b <= hi:\n            if b >= 0:\n                idx = b // BIN\n                if idx < present[chunk].shape[0] and present[chunk][idx]:\n                    acc += arrays[chunk][idx]\n                    found = True\n            b += BIN\n        if found:\n            P[i] = acc\n        else:\n            skipped += 1\n    return P, skipped\n\n\ndef standardize(P):\n    mu = np.nanmean(P, axis=1, keepdims=True)\n    sd = np.nanstd(P, axis=1, keepdims=True)\n    ok = sd.ravel() > 1e-6\n    Z = (P - mu) / np.where(sd > 1e-6, sd, 1.0)\n    Z[~ok] = np.nan\n    # rank-based score per gene across organs: (rank - mean_rank)/mean_rank\n    R = np.argsort(np.argsort(np.nan_to_num(P, nan=-1), axis=1), axis=1).astype(np.float32)\n    m = R.shape[1]\n    R = (R - (m - 1) / 2.0) / ((m - 1) / 2.0)\n    R[~ok] = np.nan\n    return Z, R, ok\n\n\ndef marker_scores(organs, genes, Z, R, ok, sym2idx):\n    organs_idx = {o: j for j, o in enumerate(organs)}\n    scores_z = np.zeros((len(organs), len(organs)))\n    scores_r = np.zeros((len(organs), len(organs)))\n    used = {}\n    for o, ms in MARKERS.items():\n        gi = set()\n        for sym in ms:\n            gi.update(sym2idx.get(sym, []))\n        gi = sorted(i for i in gi if ok[i])\n        used[o] = gi\n        sub_z = Z[gi]\n        sub_r = R[gi]\n        scores_z[organs_idx[o]] = np.nanmean(sub_z, axis=0)\n        scores_r[organs_idx[o]] = np.nanmean(sub_r, axis=0)\n    T = 0.5 * (scores_z + scores_r)\n    return T, scores_z, scores_r, used\n\n\ndef main():\n    print(\\\"[1] chunk map\\\")\n    sizes, cum = load_chunk_map()\n    print(\\\"[2] parse GTF\\\")\n    genes = parse_genes(cum)\n    print(f\\\"    {len(genes)} genes with human ortholog symbols\\\")\n    sym2idx = defaultdict(list)\n    for i, g in enumerate(genes):\n        for h in g[\\\"hs\\\"]:\n            sym2idx[h].append(i)\n    print(\\\"[3] load count matrix\\\")\n    organs, arrays, present = load_matrix(sizes)\n    print(\\\"    organs:\\\", organs)\n    print(\\\"[4] promoter accessibility\\\")\n    P, skipped = promoter_matrix(genes, arrays, present, organs)\n    print(f\\\"    {P.shape[0]} genes, {skipped} without any mappable promoter bin\\\")\n    print(\\\"[5] standardize + marker scoring\\\")\n    Z, R, ok = standardize(P)\n    T, Sz, Sr, used = marker_scores(organs, genes, Z, R, ok, sym2idx)\n    for o in organs:\n        print(f\\\"    {o:12s} markers used: {len(used[o])}\\\")\n    print(\\\"[6] genome-wide correlations (log1p, label-free context)\\\")\n    # free memory before correlation\n    del arrays, present\n    # rebuild matrix for correlation from TSV again would be costly; instead\n    # compute per-organ totals and skip full corr (kept in report as optional)\n    lib = None\n    reader = pd.read_csv(TSV, sep=\\\"\\\\t\\\", chunksize=400_000)\n    lib = np.zeros(len(organs), dtype=np.float64)\n    for chunk in reader:\n        lib += chunk.iloc[:, 3:].to_numpy(dtype=np.float64).sum(axis=0)\n    print(\\\"    library sizes:\\\", dict(zip(organs, lib.astype(int))))\n\n    # ---- swap scoring ----\n    n = len(organs)\n    pair_scores = {}\n    for a, b in itertools.combinations(range(n), 2):\n        dab = T[a, b] - T[a, a]\n        dba = T[b, a] - T[b, b]\n        pair_scores[(organs[a], organs[b])] = (dab + dba, dab, dba)\n    ranked = sorted(pair_scores.items(), key=lambda kv: -kv[1][0])\n\n    top_pair, (top_score, dab, dba) = ranked[0]\n    second_pair, (second_score, *_rest) = ranked[1]\n    a_idx, b_idx = organs.index(top_pair[0]), organs.index(top_pair[1])\n    mutual = (np.nanargmax(T[a_idx]) == b_idx) and (np.nanargmax(T[b_idx]) == a_idx)\n    both_pos = dab > 0 and dba > 0\n\n    # self-consistency before/after correction\n    pre_self = [organs[i] for i in range(n) if np.nanargmax(T[i]) == i]\n    Tc = T.copy()\n    Tc[[a_idx, b_idx]] = Tc[[b_idx, a_idx]]  # relabel columns a<->b\n    post_self = [organs[i] for i in range(n) if np.nanargmax(Tc[i]) == i]\n\n    margin = top_score - second_score\n    conf_margin = min(1.0, margin / max(top_score, 1e-9)) if top_score > 0 else 0.0\n    conf_dir = 1.0 if (mutual and both_pos) else 0.0\n    conf_cons = len(post_self) / n\n    confidence = round(0.35 * conf_margin + 0.35 * conf_dir + 0.30 * conf_cons, 3)\n    swap_detected = bool(top_score > 0 and mutual and both_pos and\n                         len(post_self) == n and margin > 0.3 * top_score)\n\n    # ---- sample_similarity.csv ----\n    rows = []\n    rank_map = {pair: r + 1 for r, (pair, _v) in enumerate(ranked)}\n    for pair, (score, _dab, _dba) in ranked:\n        oa, ob = sorted(pair)\n        etype = (\\\"promoter_accessibility+marker_coherence(mutual_best)\\\"\n                 if pair == top_pair and swap_detected else\n                 \\\"promoter_accessibility+marker_coherence\\\")\n        rows.append({\\\"organ_a\\\": oa, \\\"organ_b\\\": ob,\n                     \\\"swap_score\\\": round(float(score), 4),\n                     \\\"rank\\\": rank_map[pair], \\\"evidence_type\\\": etype})\n    df = pd.DataFrame(rows).sort_values(\\\"swap_score\\\", ascending=False)\n    df.to_csv(f\\\"{OUT}/sample_similarity.csv\\\", index=False)\n\n    # ---- evidence details ----\n    ev_lines = []\n    ev_lines.append(f\\\"Top pair {top_pair[0]}<->{top_pair[1]}: swap_score={top_score:.3f} \\\"\n                    f\\\"(delta {organs[a_idx]}markers->{organs[b_idx]} col={dab:.3f}; \\\"\n                    f\\\"delta {organs[b_idx]}markers->{organs[a_idx]} col={dba:.3f}); \\\"\n                    f\\\"second best {second_pair} score={second_score:.3f}; margin={margin:.3f}\\\")\n    ev_lines.append(f\\\"mutual_best={mutual}, both_directions_positive={both_pos}, \\\"\n                    f\\\"self-consistent organs before correction={len(pre_self)}/15 {sorted(pre_self)}, \\\"\n                    f\\\"after correction={len(post_self)}/15\\\")\n    # marker detail for top pair: show raw promoter sums for their markers\n    detail = {}\n    for o in top_pair:\n        gi = used[o]\n        rows_d = []\n        for i in gi:\n            vals = P[i]\n            rows_d.append((genes[i][\\\"hs\\\"][0], genes[i][\\\"name\\\"],\n                           {organs[j]: float(vals[j]) for j in range(n)}))\n        detail[o] = rows_d\n\n    evidence = \\\"; \\\".join(ev_lines)\n    call = {\n        \\\"swap_detected\\\": swap_detected,\n        \\\"organ_a\\\": top_pair[0] if swap_detected else None,\n        \\\"organ_b\\\": top_pair[1] if swap_detected else None,\n        \\\"confidence\\\": confidence if swap_detected else confidence,\n        \\\"evidence\\\": evidence,\n    }\n    with open(f\\\"{OUT}/swap_call.json\\\", \\\"w\\\") as f:\n        json.dump(call, f, indent=2)\n\n    # console summary + dump arrays for report writing\n    print(\\\"\\\\n=== marker coherence matrix T (rows=marker set, cols=column) ===\\\")\n    print(pd.DataFrame(T, index=[f\\\"{o}-markers\\\" for o in organs], columns=organs)\n          .round(2).to_string())\n    print(\\\"\\\\nTop 8 pairs:\\\")\n    for pair, (s, x, y) in ranked[:8]:\n        print(f\\\"  {pair[0]:12s} {pair[1]:12s} score={s:7.3f} (dab={x:6.3f} dba={y:6.3f})\\\")\n    print(f\\\"\\\\nswap_detected={swap_detected} pair={top_pair} confidence={confidence}\\\")\n    np.save(\\\"scratch_T.npy\\\", T)\n    np.save(\\\"scratch_P.npy\\\", P)\n    with open(\\\"scratch_meta.json\\\", \\\"w\\\") as f:\n        json.dump({\\\"organs\\\": organs, \\\"used\\\": {k: [genes[i][\\\"hs\\\"][0] for i in v] for k, v in used.items()},\n                   \\\"pre_self\\\": pre_self, \\\"post_self\\\": post_self,\n                   \\\"lib\\\": dict(zip(organs, lib.astype(int).tolist())),\n                   \\\"detail\\\": {k: [(s[0], s[1], s[2]) for s in v] for k, v in detail.items()},\n                   \\\"ranked_top\\\": [((p[0][0], p[0][1]), p[1][0]) for p in ranked[:10]]}, f, indent=1)\n    print(\\\"done\\\")\n\n\nif __name__ == \\\"__main__\\\":\n    main()\n