{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"New-Item -ItemType Directory -Force -Path output | Out-Null; @'\nimport gzip, re, pickle\n\n# 1) chunk map from chrom sizes\nimport collections\nchunk_sizes=collections.OrderedDict()\nwith open(r'inputs/sample.swap.atac.q1.chrom.sizes') as f:\n    for line in f:\n        a,b=line.split()\n        chunk_sizes[a]=int(b)\n\n# 2) parse GTF genes\ngenes=[]\nhs_re=re.compile(r'([A-Za-z0-9][A-Za-z0-9\\\\-\\\\.]*) \\\\[hs\\\\]')\nwith gzip.open(r'inputs/AmexT_v47-AmexG_v6.0-DD.gtf.gz','rt') as f:\n    for line in f:\n        if line.startswith('#'): continue\n        p=line.split('\\\\t')\n        if p[2]\"'!='\"'gene': continue\n        c=p[0]\n        if not c.startswith('chr'): continue\n        attrs=p[8]\n        m=re.search(r'gene_id \\\"([\"'^\"]+)\"'\"',attrs)\n        gid=m.group(1) if m else ''\n        m=re.search(r'gene_name \\\"([\"'^\"]+)\"'\"',attrs)\n        nm=m.group(1) if m else ''\n        hs=hs_re.findall(nm)\n        if not hs: continue\n        s=p[6]; st=int(p[3]); en=int(p[4])\n        tss = st if s=='+' else en\n        genes.append((gid, tuple(hs), c, tss))\nprint('genes with hs:', len(genes))\n\nsym2genes=collections.defaultdict(list)\nfor i,(gid,hs,c,tss) in enumerate(genes):\n    for h in set(hs):\n        sym2genes[h.upper()].append(i)\n\nMARKERS = {\n 'Bladder':['UPK1A','UPK1B','UPK2','UPK3A','UPK3B','KRT20','KRT7','KRT5','PPARG'],\n 'Brain':['SNAP25','SYT1','SYN1','SYP','MAP2','TUBB3','NEFL','NEFM','NEFH','GFAP','MBP','PLP1','MOG','MAG','OLIG1','OLIG2','SOX10','GAD1','GAD2','GRIN1','GRIN2A','GRIN2B','GRIA1','CAMK2A'],\n 'Cloaca':['HOXA13','HOXD13','HOXC13','CDX2','KRT20','UPK1A','UPK3A','GATA3'],\n 'GallBladder':['KRT19','KRT7','HNF1B','SOX9','SLC26A6','CFTR','MUC1','AQP1','SPP1','BEST2','SLC4A2'],\n 'Gill':['CA2',