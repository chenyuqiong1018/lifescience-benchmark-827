{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport gzip, re, collections, pickle\nimport numpy as np, pandas as pd\n\nPROM = 5000  # promoter window +/- around TSS\n\n# ---------- 1. GTF genes ----------\ngenes = []  # (arm, strand, tss, gene_id, symbols)\nattr_re = re.compile(r'(\\\\w+) \\\"([\"'^\"]*)\"'\"')\nwith gzip.open('inputs/AmexT_v47-AmexG_v6.0-DD.gtf.gz','rt') as f:\n    for line in f:\n        if line.startswith('#'): continue\n        p = line.rstrip().split('\\\\t')\n        if p[2] \"'!= '\"'gene': continue\n        arm, start, end, strand = p[0], int(p[3]), int(p[4]), p[6]\n        attrs = dict(attr_re.findall(p[8]))\n        gid = attrs.get('gene_id','')\n        name = attrs.get('gene_name','')\n        symbols = []\n        for part in name.split('|'):\n            part = part.strip()\n            s = re.sub(r'\\\\s*\\\\[(nr|hs)\\\\]\\\\s*', '', part).strip()\n            if s and not s.startswith('AMEX60DD'):\n                symbols.append(s)\n        tss = start if strand == '+' else end\n        genes.append((arm, strand, tss, gid, symbols))\nprint('genes parsed:', len(genes))\n\n# collapse to symbol level later; keep gene-level rows for now\nimport pandas as pd\ngdf = pd.DataFrame(genes, columns=['arm','strand','tss','gene_id','symbols'])\ngdf.to_pickle('work_genes.pkl')\n\n# ---------- 2. contig offsets ----------\nsizes = {}\nwith open('inputs/sample.swap.atac.q1.chrom.sizes') as f:\n    for line in f:\n        c, s = line.split()\n        sizes[c] = int(s)\ncontig_arm, contig_off = {}, {}\nparts = collections.defaultdict(list)\nfor c, s in sizes.items():\n    if '_' in c:\n        arm, k = c.rsplit('_', 1); k = int(k)\n    else:\n        arm, k = c, 0\n    parts[arm].append((k, c, s))\nfor arm, pl in parts.items():\n    off = 0\n    for k, c, s in sorted(pl):\n        contig_arm[c] = arm\n        contig_off[c] = off\n        off += s\npickle.dump((contig_arm, contig_off), open('work_contigs.pkl','wb'))\nprint('contigs:', len(contig_arm))\n\n# ---------- 3. per-arm promoter intervals ----------\narm_intervals = collections.defaultdict(list)  # arm -> list of (pstart, pend, sym_idx)\nsym2idx = {}\nfor arm, strand, tss, gid, symbols in genes:\n    if not symbols: continue\n    # use primary (first) symbol as aggregation key\n    s0 = symbols[0]\n    if s0 not in sym2idx: sym2idx[s0] = len(sym2idx)\n    arm_intervals[arm].append((tss - PROM, tss + PROM, sym2idx[s0]))\nfor arm in arm_intervals:\n    arm_intervals[arm].sort(key=lambda x: x[0])\npickle.dump((arm_intervals, sym2idx), open('work_intervals.pkl','wb'))\nprint('interval arms:', len(arm_intervals), 'symbols:', len(sym2idx))\n'@ | Set-Content -Encoding utf8 scratch_step1.py\npython scratch_step1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
