{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport pickle, gzip, re\nimport numpy as np\n\nD = pickle.load(open('work_z.pkl','rb'))\nz, idx2sym, ORGS = D['z'], D['idx2sym'], D['ORGS']\nsym2prim = pickle.load(open('work_sym2prim.pkl','rb'))\n\n# build primary symbol -> gene_name map from GTF\nattr_re = re.compile(r'(\\\\w+) \\\"([\"'^\"]*)\"'\"')\nprim2name = {}\nwith gzip.open('inputs/AmexT_v47-AmexG_v6.0-DD.gtf.gz','rt') as f:\n    for line in f:\n        if line.startswith('#'): continue\n        p = line.rstrip().split('\\\\t')\n        if p[2] \"'!= '\"'gene': continue\n        attrs = dict(attr_re.findall(p[8]))\n        name = attrs.get('gene_name','')\n        parts = []\n        for part in name.split('|'):\n            s = re.sub(r'\\\\s*\\\\[(nr|hs)\\\\]\\\\s*', '', part.strip()).strip()\n            if s: parts.append(s)\n        if parts:\n            prim2name.setdefault(parts[0], name)\n\npickle.dump(prim2name, open('work_names.pkl','wb'))\nfor org in ['Stomach','GallBladder','Prostate','Bladder','Gill','Cloaca','Limb','Kidney']:\n    oi = ORGS.index(org)\n    col = z[:, oi]\n    valid = ~np.isnan(col)\n    order = np.where(valid)[0][np.argsort(col[valid])[::-1]]\n    print(f\\\"===== {org} column top 18 genes with full gene_name =====\\\")\n    for i in order[:18]:\n        prim = idx2sym[i]\n        print(f\\\"  {prim:16s} z={col[i]:4.1f}  name={prim2name.get(prim,'?')[:110]}\\\")\n'@ | Set-Content -Encoding utf8 scratch_step11.py\npython scratch_step11.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
