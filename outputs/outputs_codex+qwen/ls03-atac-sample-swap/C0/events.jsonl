{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport pickle, itertools, json\nimport numpy as np, pandas as pd\n\nD = pickle.load(open('work_z.pkl','rb'))\nlogcpm, sym2idx, ORGS = D['logcpm'], D['sym2idx'], D['ORGS']\nsym2prim = pickle.load(open('work_sym2prim.pkl','rb'))\n\n# variance-floored z\nmu = logcpm.mean(1, keepdims=True)\nsd = logcpm.std(1, ddof=0, keepdims=True).ravel()\ns0 = np.median(sd[sd > 0])\nsdf = np.maximum(sd, s0)\nzf = (logcpm - mu) / sdf[:, None]\nzf[sd == 0, :] = np.nan\nprint('sd floor:', round(s0, 4))\n\nMARKERS = {\n 'Brain':      ['SYP','SNAP25','GFAP','MBP','PLP1','TUBB3','NEFL','GAD1','SLC17A6','GABRG2','OLIG2','MAG','SLC6A1','SLC1A3','GJA1','AQP4','STMN4','GRIN2B'],\n 'Heart':      ['MYH6','MYH7','TNNT2','MYL2','MYL3','MYL4','MYL7','ACTC1','TNNI3','TPM1','RYR2','GATA4','TTN','MYLK4'],\n 'Liver':      ['ALB','APOA1','APOB','APOC1','AGT','FGA','FGB','FGG','HNF4A','SERPINA1','TTR','LCAT','CP','HPX','FETUB','OIT3','TMPRSS6','LEAP2'],\n 'Kidney':     ['SLC12A1','UMOD','UMODL1','SLC12A3','CALB1','NPHS1','NPHS2','LRP2','CUBN','PAX2','GATA3','SLC34A1','PAX8','SLC23A3','SLC26A1'],\n 'Lung':       ['SFTPC','NKX2-1','AQP5','MUC5B','FOXA2'],\n 'Pancreas':   ['INS','GCG','SST','PPY','PDX1','IAPP','AMY2A','CPA1','CEL','PRSS1','CTRB1','CTRB2','CELA3B','PNLIP','CLPS','PTF1A','CELA1','CTRL','CPB1','PRSS2'],\n 'Spleen':     ['CD3E','CD3G','CD8B','CD79A','LCK','IL7R','PTPRC','SPI1','IRF8','CSF1R','CD68','CD163','C1QA','C1QB','HBA1','RAG1','RAG2','FLT3','CXCR5','CD72','POU2AF1'],\n 'Intestine':  ['VIL1','CDX2','FABP2','FABP6','ANPEP','DPP4','SI','ALPI','MUC2','RBP2','SLC15A1','CDHR2'],\n 'Stomach':    ['PGA3','PGC','PGBC2','CHGA','CHGB','MUC5AC','TFF2','GKN1','GKN2','ATP4B','MUC1','ANXA4'],\n 'Limb':       ['ACTA1','MYH1','MYH2','MYH3','MYH4','TNNT1','TNNT3','TNNI1','TNNI2','MYOG','COL1A1','COL1A2','COL2A1','COL11A1','COL11A2','ACAN','COMP','SPP1','BGLAP','POSTN','KRT5','KRT15','TP63','IVL','PRRX1'],\n 'Gill':       ['HBA1','HBD','HBG1','HBG2','HBE1','HBZ','HB-AM','HB-B','CA2','CA4','CA13','SLC4A1','SLC12A2','ATP1A1','ATP6V1B1','RHAG','RHBG','RHCG','SLC26A3','SLC26A4','SLC26A6'],\n 'Bladder':    ['UPK1A','UPK1B','UPK2.S','UPK3A','UPK3B','KRT8','KRT18','SLC14A2'],\n 'Cloaca':     ['VIL1','CDX2','UPK1B','UPK3A','KRT5','KRT13','FOXA2','TFF3.2','MUC2'],\n 'Prostate':   ['NKX3-1','MSMB','KLK1','KLK7','KLKB1','HOXB13'],\n 'GallBladder':['KRT19','KRT8','KRT18','SOX9','ANXA4','SLC4A2','MUC1','EPCAM','FOXA1'],\n}\n\ndef marker_genes(org):\n    idxs = []\n    for m in MARKERS[org]:\n        for prim in sym2prim.get(m, ()):\n            if prim in sym2idx: idxs.append(sym2idx[prim])\n    return idxs\n\nMZ = {}\nfor org in MARKERS:\n    zi = zf[marker_genes(org)]\n    MZ[org] = np.nanmean(zi, axis=0)\n\nprint(f\\\"\\\\n{'organ':12s} {'n':>4s} {'argmax':>12s} {'self_z':>7s} {'2nd':>12s}\\\")\nfor org in MARKERS:\n    mz = MZ[org]\n    order = np.argsort(mz)[::-1]\n    a1, a2 = ORGS[order[0]], ORGS[order[1]]\n    flag = '' if a1 == org else '   <-- mismatch'\n    print(f\\\"{org:12s} {len(marker_genes(org)):>4d} {a1:>12s} {mz[ORGS.index(org)]:>7.2f} {a2}({mz[order[1]]:.2f}){flag}\\\")\n\n# pairwise scores\nrows = []\nfor a, b in itertools.combinations(sorted(ORGS), 2):\n    ia, ib = ORGS.index(a), ORGS.index(b)\n    da = MZ[a][ib] - MZ[a][ia]\n    db = MZ[b][ia] - MZ[b][ib]\n    # win-rate version\n    wa = winb = 0.0; na = nb = 0\n    for gi in marker_genes(a):\n        if np.isnan(zf[gi, ia]) or np.isnan(zf[gi, ib]): continue\n        na += 1; wa += zf[gi, ib] > zf[gi, ia]\n    for gi in marker_genes(b):\n        if np.isnan(zf[gi, ia]) or np.isnan(zf[gi, ib]): continue\n        nb += 1; wb += zf[gi, ia] > zf[gi, ib]\n    win = (wa + wb) / max(1, na + nb) * 2\n    rows.append((da + db, win, da, db, a, b))\nrows.sort(reverse=True)\nprint('\\\\nTop 15 pairs (mean-z delta; win-rate in [0,2]):')\nfor s, win, da, db, a, b in rows[:15]:\n    print(f\\\"  {a:12s} <-> {b:12s}  dsum={s:6.2f}  win={win:4.2f}  ({a}->{b}: {da:+5.2f}, {b}->{a}: {db:+5.2f})\\\")\n\nbywin = sorted(rows, key=lambda r: -r[1])\nprint('\\\\nTop 10 pairs by win-rate:')\nfor s, win, da, db, a, b in bywin[:10]:\n    print(f\\\"  {a:12s} <-> {b:12s}  win={win:4.2f}  dsum={s:6.2f}\\\")\n\npickle.dump({'zf':zf,'MZ':MZ,'MARKERS':MARKERS,'rows':rows}, open('work_v2.pkl','wb'))\n'@ | Set-Content -Encoding utf8 scratch_step10.py\npython scratch_step10.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
