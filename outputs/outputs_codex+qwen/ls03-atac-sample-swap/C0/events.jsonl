{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport pickle, itertools\nimport numpy as np, pandas as pd\n\nD = pickle.load(open('work_z.pkl','rb'))\nz, sym2idx, ORGS, MARKERS = D['z'], D['sym2idx'], D['ORGS'], D['MARKERS']\nsym2prim = pickle.load(open('work_sym2prim.pkl','rb'))\n\ndef marker_zmean(org):\n    idxs = []\n    for m in MARKERS[org]:\n        for prim in sym2prim.get(m, ()):\n            if prim in sym2idx: idxs.append(sym2idx[prim])\n    return np.nanmean(z[idxs], axis=0)\n\nMZ = {o: marker_zmean(o) for o in MARKERS}\n\ndef dsrc(a, b):\n    # improvement when swapping labels a<->b\n    return (MZ[a][ORGS.index(b)] - MZ[a][ORGS.index(a)]) + (MZ[b][ORGS.index(a)] - MZ[b][ORGS.index(b)])\n\npairs = []\nfor a, b in itertools.combinations(ORGS, 2):\n    da = MZ[a][ORGS.index(b)] - MZ[a][ORGS.index(a)]\n    db = MZ[b][ORGS.index(a)] - MZ[b][ORGS.index(b)]\n    pairs.append((da + db, da, db, a, b))\npairs.sort(reverse=True)\nprint('Top 20 pairs by swap score (sum of both directions):')\nfor s, da, db, a, b in pairs[:20]:\n    print(f\\\"  {a:12s} <-> {b:12s}  score={s:6.2f}   ({a}->{b}: {da:+5.2f}, {b}->{a}: {db:+5.2f})\\\")\nprint()\nprint('Pairs with BOTH directions positive:')\nfor s, da, db, a, b in pairs:\n    if da > 0 and db > 0:\n        print(f\\\"  {a:12s} <-> {b:12s}  score={s:6.2f}   ({a}->{b}: {da:+5.2f}, {b}->{a}: {db:+5.2f})\\\")\n'@ | Set-Content -Encoding utf8 scratch_step7.py\npython scratch_step7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
