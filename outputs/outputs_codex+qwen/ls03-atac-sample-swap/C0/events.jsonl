{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport pickle, itertools\nimport numpy as np\n\nD = pickle.load(open('work_z.pkl','rb'))\nlogcpm, sym2idx, ORGS = D['logcpm'], D['sym2idx'], D['ORGS']\nsym2prim = pickle.load(open('work_sym2prim.pkl','rb'))\n\nmu = logcpm.mean(1, keepdims=True)\nsd = logcpm.std(1, ddof=0, keepdims=True).ravel()\ns0 = np.median(sd[sd > 0])\nzf = (logcpm - mu) / np.maximum(sd, s0)[:, None]\nzf[sd == 0, :] = np.nan\n\nMARKERS3 = {\n 'Brain':      ['SYP','SNAP25','GFAP','MBP','PLP1','NEFL','GAD1','SLC17A6','GABRG2','MAG','STMN4','GRIN2B','AQP4','SLC1A3','GJA1'],\n 'Heart':      ['MYH6','MYH7','TNNT2','MYL2','MYL3','MYL7','ACTC1','TNNI3','TPM1','RYR2','TTN','MYLK4','NKX2-5','TBX20'],\n 'Liver':      ['ALB','APOA1','APOB','APOC1','AGT','FGA','FGB','FGG','HNF4A','TTR','LCAT','CP','HPX','FETUB','OIT3','TMPRSS6','LEAP2','TAT','F7'],\n 'Kidney':     ['SLC34A1','PAX8','SLC12A1','UMOD','SLC12A3','SLC23A3','SLC26A1','ACOT12','NPHS1','NPHS2','LRP2','CUBN','PAX2','GATA3','CALB1'],\n 'Lung':       ['SFTPC','NKX2-1','MUC5B','FOXA2'],\n 'Pancreas':   ['INS','GCG','SST','PPY','PDX1','IAPP','AMY2A','CEL','CPA1','CPB1','CELA1','CELA3B','CTRL','PRSS1','PRSS2','CTRB1','CTRB2','PNLIP','CLPS','PTF1A'],\n 'Spleen':     ['CD3E','CD3G','CD8B','CD79A','LCK','IL7R','PTPRC','SPI1','IRF8','CSF1R','CD68','C1QB','RAG1','RAG2','FLT3','CXCR5','CD72','POU2AF1','HBA1','HBE1'],\n 'Intestine':  ['VIL1','CDX2','FABP2','ANPEP','DPP4','SI','ALPI','MUC2','SLC15A1','CDHR2','NXPE4'],\n 'Stomach':    ['GKN1','GKN2','CLDN18.S','PGA3','PGC','ANXA4','MUC5AC'],\n 'Limb':       ['ACTA1','MYH2','MYH3','MYH4','TNNT1','TNNT3','TNNI1','TNNI2','COL1A1','COL1A2','COL2A1','COL11A1','COL11A2','ACAN','COMP','SPP1','BGLAP','POSTN','KRT5','KRT15','TP63','IVL','PRRX1','DCT','TYR'],\n 'Gill':       ['HBA1','HBD','HBG1','HBG2','HBE1','HBZ','HB-AM','HB-B','CA2','CA4','SLC4A1','SLC12A2','ATP1A1','ATP6V1B1','RHAG','RHBG','RHCG','FOXI1','CCL28','CNN2','UCP2','LRAT'],\n 'Bladder':    ['UPK1A','UPK1B','UPK2.S','UPK3A','UPK3B','AQP-T2'],\n 'Cloaca':     ['CDX2','MUC2','TFF3.2','VIL1','UPK1B','UPK2.S','UPK3A','KRT13','FOXA2','PPARG','CALB1','SLC9A3','FFAR4'],\n 'Prostate':   ['NKX3-1','MSMB','KLK1','KLK7','KLKB1','HOXB13'],\n 'GallBladder':['CYP8B1','ANXA4','KRT19','SLC4A2','SOX9','MUC1','EPCAM','FOXA1','KRT8','KRT18'],\n}\n\ndef midxs(org):\n    idxs = []\n    for m in MARKERS3[org]:\n        for prim in sym2prim.get(m, ()):\n            if prim in sym2idx: idxs.append(sym2idx[prim])\n    return idxs\n\nMZ3 = {o: np.nanmean(zf[midxs(o)], axis=0) for o in MARKERS3}\n\nprint(f\\\"{'organ':12s} {'n':>4s} {'argmax':>12s} {'self_z':>7s}\\\")\nfor org in MARKERS3:\n    mz = MZ3[org]; order = np.argsort(mz)[::-1]\n    flag = '' if ORGS[order[0]] == org else '   <-- ' + ORGS[order[0]]\n    print(f\\\"{org:12s} {len(midxs(org)):>4d} {ORGS[order[0]]:>12s} {mz[ORGS.index(org)]:>7.2f}{flag}\\\")\n\nres = []\nfor a, b in itertools.combinations(sorted(ORGS), 2):\n    ia, ib = ORGS.index(a), ORGS.index(b)\n    da = MZ3[a][ib] - MZ3[a][ia]   # a's markers: gain if relabeled to b's column\n    db = MZ3[b][ia] - MZ3[b][ib]\n    cross = min(MZ3[a][ib], MZ3[b][ia])\n    res.append({'a':a,'b':b,'da':da,'db':db,'dsum':da+db,'cross':cross})\n\nbydsum = sorted(res, key=lambda r: -r['dsum'])\nprint('\\\\nTop 12 by dsum:')\nfor r in bydsum[:12]:\n    print(f\\\"  {r['a']:12s} <-> {r['b']:12s} dsum={r['dsum']:6.2f} ({r['a']}->{r['b']} {r['da']:+5.2f}; {r['b']}->{r['a']} {r['db']:+5.2f}) cross_min={r['cross']:5.2f}\\\")\nbycross = sorted(res, key=lambda r: -r['cross'])\nprint('\\\\nTop 12 by bottleneck cross-fit:')\nfor r in bycross[:12]:\n    print(f\\\"  {r['a']:12s} <-> {r['b']:12s} cross_min={r['cross']:5.2f} dsum={r['dsum']:6.2f}\\\")\npickle.dump({'MARKERS3':MARKERS3,'MZ3':MZ3,'res':res,'zf':zf,'midxs':{o:midxs(o) for o in MARKERS3}}, open('work_v3.pkl','wb'))\n'@ | Set-Content -Encoding utf8 scratch_step16.py\npython scratch_step16.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
