{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport pickle, itertools\nimport numpy as np\n\nV = pickle.load(open('work_v3.pkl','rb'))\nMZ3, ORGS, MARKERS3, midxs, zf = V['MZ3'], ['Bladder','Brain','Cloaca','GallBladder','Gill','Heart','Intestine','Kidney','Limb','Liver','Lung','Pancreas','Prostate','Spleen','Stomach'], V['MARKERS3'], V['midxs'], V['zf']\n\ndef top_crossmin(MZmat):\n    best = -9; bp = None\n    for a, b in itertools.combinations(range(len(ORGS)), 2):\n        s = min(MZmat[a, b], MZmat[b, a])\n        if s > best: best, bp = s, (a, b)\n    return best, bp\n\nMZmat = np.array([MZ3[o] for o in ORGS])\nobs, (oa, ob) = top_crossmin(MZmat)\nprint(f\\\"observed top bottleneck: {ORGS[oa]}<->{ORGS[ob]} score={obs:.3f}\\\")\n\nrng = np.random.default_rng(42)\nn_perm = 2000\nnull = []\nfor i in range(n_perm):\n    perm = rng.permutation(len(ORGS))\n    Mp = MZmat[:, perm]  # columns relabeled\n    s, _ = top_crossmin(Mp)\n    null.append(s)\nnull = np.array(null)\np = (null >= obs).mean()\nprint(f\\\"permutation p-value: {p:.4f}  (null mean={null.mean():.3f}, 95th={np.percentile(null,95):.3f}, 99th={np.percentile(null,99):.3f})\\\")\n\n# win-rate version for Cloaca-Stomach and top competitors\ndef winrate(a, b):\n    ia, ib = ORGS.index(a), ORGS.index(b)\n    wa = wb = 0.0; na = nb = 0\n    for gi in midxs[a]:\n        if np.isnan(zf[gi, ia]) or np.isnan(zf[gi, ib]): continue\n        na += 1; wa += zf[gi, ib] > zf[gi, ia]\n    for gi in midxs[b]:\n        if np.isnan(zf[gi, ia]) or np.isnan(zf[gi, ib]): continue\n        nb += 1; wb += zf[gi, ia] > zf[gi, ib]\n    return (wa + wb) / max(1, na + nb) * 2, na + nb\n\nfor a, b in [('Cloaca','Stomach'), ('GallBladder','Stomach'), ('GallBladder','Prostate'), ('Prostate','Stomach'), ('Bladder','Gill'), ('Gill','Lung'), ('Bladder','Stomach'), ('Cloaca','GallBladder')]:\n    w, n = winrate(a, b)\n    print(f\\\"  win-rate {a:12s}<->{b:12s} = {w:.2f}  (n_genes={n})\\\")\n'@ | Set-Content -Encoding utf8 scratch_step17.py\npython scratch_step17.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
