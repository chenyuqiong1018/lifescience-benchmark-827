{"type":"item.started","item":{"id":"item_97","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$code = @'\"'\nimport collections\n\nTARGETS = {127661125: (\\\"G\\\", \\\"T\\\"), 122477222: (\\\"G\\\", \\\"T\\\")}\n\ndef parse_cigar(cig):\n    ops = []\n    num = 0\n    for ch in cig:\n        if ch.isdigit():\n            num = num * 10 + ord(ch) - 48\n        else:\n            ops.append((num, ch))\n            num = 0\n    return ops\n\n# independent recount: no quality filters first pass, record everything\nrecords = {p: [] for p in TARGETS}\nwith open(r\\\"work/aln/aln.sam\\\") as fh:\n    for line in fh:\n        if line[0] == \\\"@\\\":\n            continue\n        cols = line.rstrip(\\\"\\\\n\\\").split(\\\"\\\\t\\\")\n        flag = int(cols[1])\n        if flag & 4 or flag & 256 or flag & 2048 or cols[2] \"'!= \"chr9\":\n            continue\n        pos = int(cols[3])\n        seq = cols[9]\n        qual = cols[10]\n        rpos = pos\n        qi = 0\n        hit = None\n        for ln, op in parse_cigar(cols[5]):\n            if op in \"M=X\":\n                if hit is None:\n                    for p in TARGETS:\n                        if rpos <= p < rpos + ln:\n                            off = p - rpos\n                            base = seq[qi + off]\n                            bq = ord(qual[qi + off]) - 33\n                            hit = (p, base, bq, qi + off, len(seq))\n                            break\n                rpos += ln\n                qi += ln\n            elif op == \"I\":\n                qi += ln\n            elif op in \"DN\":\n                rpos += ln\n            elif op == \"S\":\n                qi += ln\n            if hit is not None:\n                break\n        if hit:\n            p, base, bq, qidx, qlen = hit\n            records[p].append((cols[0], int(cols[4]), flag & 16 != 0, base, bq, qidx, qlen))\n\nfor p, (ref, alt) in TARGETS.items():\n    recs = records[p]\n    print(\"=== position\", p, \"ref\", ref, \"alt\", alt, \"overlapping primary reads:\", len(recs))\n    by_base_all = collections.Counter(r[3] for r in recs)\n    print(\"  all-MAPQ base counts:\", dict(by_base_all))\n    filt = [r for r in recs if r[1] >= 20 and r[4] >= 20]\n    by_base = collections.Counter(r[3] for r in filt)\n    depth = sum(by_base.get(b, 0) for b in \"ACGT\")\n    print(\"  filtered (mapQ>=20, baseQ>=20) base counts:\", dict(by_base), \"depth:\", depth)\n    altrecs = [r for r in filt if r[3] == alt]\n    fwd = sum(1 for r in altrecs if not r[2])\n    rev = sum(1 for r in altrecs if r[2])\n    print(\"  alt reads:\", len(altrecs), \"fwd\", fwd, \"rev\", rev, \"AF=%.4f\" % (len(altrecs) / depth if depth else 0))\n    print(\"  alt MAPQs:\", sorted(r[1] for r in altrecs))\n    print(\"  alt baseQs:\", sorted(r[4] for r in altrecs))\n    dist_end = [min(r[5], r[6] - 1 - r[5]) for r in altrecs]\n    print(\"  alt distance-to-read-end:\", sorted(dist_end))\n'\"'@\nSet-Content -Path work\\\\verify.py -Value \"'$code -Encoding utf8\npython work'\"\\\\verify.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
