d intervals (pileup domain) and exon+flank target (index domain)\n    all_cds = []\n    all_exons = []\n    for tid, t in tx.items():\n        all_cds.extend(t[\"cds\"])\n    # exons from GTF re-parse (quick): reuse CDS flank target instead\n    targets = merge_intervals(all_cds, flank=FLANK, upper=glen)\n    cds_merged = merge_intervals(all_cds)\n    cds_starts = np.array([s for s, e in cds_merged], dtype=np.int64)\n    cds_ends = np.array([e for s, e in cds_merged], dtype=np.int64)\n    cds_pos_map = np.concatenate([np.arange(s, e + 1) for s, e in cds_merged])\n    log(\"CDS mask: %d intervals, %d bp; index target: %d intervals, %d bp\" %\n        (len(cds_merged), len(cds_pos_map), len(targets),\n         sum(e - s + 1 for s, e in targets)))\n\n    index = build_index(genome, targets)\n\n    # global CDS segment index for annotation\n    tx_cds_index = []\n    for tid, t in tx.items():\n        for s, e in t[\"cds\"]:\n            tx_cds_index.append((s, e, tid))\n    tx_cds_index.sort()\n    tx_cds_starts = np.array([x[0] for x in tx_cds_index])\n\n    log(\"=== pass 1: mapping + pileup ===\")\n    flat, stats = run_pass(FASTQ, genome, index, tx, cds_starts, cds_ends,\n                           cds_pos_map, glen)\n    cands = call_variants(flat, genome, cds_pos_map, cds_starts)\n\n    log(\"annotating candidates\")\n    for c in cands:\n        c[\"annotations\"] = annotate_candidate(c, models, tx_cds_index)\n    stop_cands = [c for c in cands\n                  if any(a[\"consequence\"] == \"stop_gained\"\n                         for a in c[\"annotations\"])]\n    log(\"stop-gained candidates: %d\" % len(stop_cands))\n\n    # ---- read-level evidence for stop-gained candidates (pass 2) ----\n    collect = {c[\"pos\"]: {\"reads\": []} for c in stop_cands}\n    if collect:\n        log(\"=== pass 2: read-level evidence for %d positions ===\" %\n            len(collect))\n        _, stats2 = run_pass(FASTQ, genome, index, tx, cds_starts, cds_ends,\n                             cds_pos_map, glen, collect=collect)\n\n    # ---- select final variant ----\n    def score(c):\n        return (c[\"alt_reads\"], c[\"allele_fraction\"])\n    stop_cands.sort(key=score, reverse=True)\n    final = stop_cands[0] if stop_cands else None\n\n    if final is not None:\n        ev = collect.get(final[\"pos\"], {\"reads\": []})\n        alt_reads = [r for r in ev[\"reads\"] if r[\"base\"] == final[\"alt\"]]\n        final[\"evidence\"] = {\n            \"n_supporting_reads\": len(alt_reads),\n            \"supporting_strands\": {\n                \"+\": sum(1 for r in alt_reads if r[\"strand\"] == \"+\"),\n                \"-\": sum(1 for r in alt_reads if r[\"strand\"] == \"-\"),\n            },\n            \"mean_base_quality_alt\": round(float(np.mean(\n                [r[\"bq\"] for r in alt_reads])), 2) if alt_reads else None,\n            \"min_base_quality_alt\": int(min(\n                (r[\"bq\"] for r in alt_reads), default=-1)),\n            \"mean_mismatches_supporting\": round(float(np.mean(\n                [r[\"mismatches\"] for r in alt_reads])), 3) if alt_reads else None,\n            \"all_reads_at_pos\": len(ev[\"reads\"]),\n        }\n        ann = [a for a in final[\"annotations\"]\n               if a[\"consequence\"] == \"stop_gained\"]\n        ann.sort(key=lambda a: (not a[\"mane_select\"], a[\"transcript_id\"]))\n        final[\"reported_annotation\"] = ann[0]\n\n    # ---------------- outputs ----------------\n    with open(os.path.join(OUTDIR, \"variant.tsv\"), \"w\") as f:\n        f.write(\"chrom'\"\\\\tpos\\\\tref\\\\talt\\\\tgene\\\\tconsequence\\\\talt_reads\\\\t\\\"\n                \\\"total_reads\\\\tallele_fraction\\\\n\\\")\n        if final is not None:\n            a = final[\\\"reported_annotation\\\"]\n            f.write(\\\"%s\\\\t%d\\\\t%s\\\\t%s\\\\t%s\\\\t%s\\\\t%d\\\\t%d\\\\t%.4f\\\\n\\\" % (\n                final[\\\"chrom\\\"], final[\\\"pos\\\"], final[\\\"ref\\\"], final[\\\"alt\\\"],\n                a[\\\"gene_name\\\"], a[\\\"consequence\\\"], final[\\\"alt_reads\\\"],\n                final[\\\"total_reads\\\"], final[\\\"allele_fraction\\\"]))\n\n    # coverage stats\n    cm = flat.reshape(-1, 8)\n    depth = cm.sum(axis=1)\n    cov_stats = {\n        \\\"cds_positions\\\": int(len(depth)),\n        \\\"positions_ge_10x\\\": int((depth >= 10).sum()),\n        \\\"fraction_cds_ge_10x\\\": round(float((depth >= 10).mean()), 4),\n        \\\"mean_cds_depth\\\": round(float(depth.mean()), 2),\n    }\n\n    evidence = {\n        \\\"reference\\\": {\n            \\\"genome_build\\\": \\\"GRCh38 (primary assembly, chr9)\\\",\n            \\\"reference_fasta\\\": \\\"GRCh38_chr9.fa.gz (Broad GATK bundle, chr9)\\\",\n            \\\"coordinate_system\\\": \\\"chr9, 1-based\\\",\n        },\n        \\\"annotation\\\": {\n            \\\"source\\\": \\\"GENCODE v47 (Ensembl 113), chr9 records\\\",\n            \\\"file\\\": \\\"gencode.v47.chr9.annotation.gtf.gz\\\",\n            \\\"biotype_filter\\\": \\\"protein_coding genes/transcripts\\\",\n        },\n        \\\"pipeline\\\": {\n            \\\"aligner\\\": \\\"custom seed-and-verify mapper (analysis.py)\\\",\n            \\\"seed_k\\\": K,\n            \\\"seed_step\\\": SEED_STEP,\n            \\\"index_target\\\": \\\"protein-coding CDS +/- %d bp\\\" % FLANK,\n            \\\"min_seed_votes\\\": MIN_VOTE,\n            \\\"max_mismatch_fraction\\\": WINDOW_MM_FRAC,\n            \\\"min_base_quality\\\": BASE_Q,\n            \\\"min_depth\\\": MIN_DEPTH,\n            \\\"min_alt_reads\\\": MIN_ALT,\n        },\n        \\\"read_stats\\\": dict(stats),\n        \\\"coverage\\\": cov_stats,\n        \\\"candidate_snvs_total\\\": len(cands),\n        \\\"stop_gained_candidates\\\": [\n            {k: v for k, v in c.items() if k not in (\\\"annotations\\\",)} |\n            {\\\"annotations\\\": c[\\\"annotations\\\"]}\n            for c in stop_cands\n        ],\n        \\\"final_variant\\\": final,\n    }\n    with open(os.path.join(OUTDIR, \\\"evidence.json\\\"), \\\"w\\\") as f:\n        json.dump(evidence, f, indent=2)\n\n    # console summary\n    print(\\\"\\\\n=== SUMMARY ===\\\")\n    print(\\\"reads total/mapped: %d / %d\\\" % (stats[\\\"total\\\"], stats[\\\"mapped\\\"]))\n    print(\\\"candidates: %d ; stop_gained: %d\\\" % (len(cands), len(stop_cands)))\n    if final is not None:\n        a = final[\\\"reported_annotation\\\"]\n        print(\\\"FINAL: %s:%d %s>%s %s %s AF=%.4f (%d/%d) %s\\\" % (\n            final[\\\"chrom\\\"], final[\\\"pos\\\"], final[\\\"ref\\\"], final[\\\"alt\\\"],\n            a[\\\"gene_name\\\"], a[\\\"consequence\\\"], final[\\\"allele_fraction\\\"],\n            final[\\\"alt_reads\\\"], final[\\\"total_reads\\\"], a[\\\"hgvs_p\\\"]))\n    for c in stop_cands[1:]:\n        a = c[\\\"annotations\\\"][0]\n        print(\\\"ALT:   %s:%d %s>%s %s AF=%.4f\\\" % (\n            c[\\\"chrom\\\"], c[\\\"pos\\\"], c[\\\"ref\\\"], c[\\\"alt\\\"], a[\\\"gene_name\\\"],\n            c[\\\"allele_fraction\\\"]))\n    print(\\\"wrote output/variant.tsv and output/evidence.json\\\")\n\n\nif __name__ == \\\"__main__\\\":\n    main()\n'@ -Encoding utf8; (Get-Item output/analysis.py).Length\"","aggregated_output":"24571\r\n","exit_code":0,"status":"completed"}}
