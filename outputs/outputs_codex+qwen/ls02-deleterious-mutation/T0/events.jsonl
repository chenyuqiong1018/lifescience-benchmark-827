offsets[k] + np.arange(lo, hi + 1) - cds_starts[k])\n    return np.concatenate(out) if out else np.array([], dtype=np.int64)\n\n\nprint(\\\"=== pass 1: pileup ===\\\", flush=True)\nflat, stats = an.run_pass(an.FASTQ, genome, index, tx, cds_starts, cds_ends,\n                          cds_pos_map, cds_offsets, glen)\nprint(\\\"stats:\\\", dict(stats), flush=True)\n\ncm = flat.reshape(-1, 8)\ndepth = cm.sum(axis=1)\n\n# ---- gene coverage profile ----\nprint(\\\"=== gene coverage (mean depth over gene CDS) ===\\\", flush=True)\ngcover = []\nfor (gid, gname), iv in gene_cds.items():\n    ivm = an.merge_intervals(iv)\n    idxs = np.concatenate([flat_indices(s, e) for s, e in ivm]) \\\\\n        if ivm else np.array([], dtype=np.int64)\n    d = depth[idxs]\n    gcover.append((float(d.mean()) if len(d) else 0.0,\n                   int((d >= 10).sum()), len(d), gname, gid))\ngcover.sort(reverse=True)\nwith open(\\\"scratch/gene_coverage.tsv\\\", \\\"w\\\") as f:\n    f.write(\\\"gene\\\\tgene_id\\\\tcds_positions\\\\tpos_ge_10x\\\\tmean_depth\\\\n\\\")\n    for mean_d, ge10, npos, gname, gid in gcover:\n        if mean_d > 0.1:\n            f.write(\\\"%s\\\\t%s\\\\t%d\\\\t%d\\\\t%.2f\\\\n\\\" % (gname, gid, npos, ge10, mean_d))\nprint(\\\"top-40 genes by mean CDS depth:\\\")\nfor mean_d, ge10, npos, gname, gid in gcover[:40]:\n    print(\\\"  %-14s %-20s positions=%6d ge10x=%6d mean_depth=%.1f\\\" %\n          (gname, gid, npos, ge10, mean_d))\n\n# ---- candidates ----\ncands = an.call_variants(flat, genome, cds_pos_map, cds_starts)\ntx_cds_index = []\nfor tid, t in tx.items():\n    for s, e in t[\\\"cds\\\"]:\n        tx_cds_index.append((s, e, tid))\ntx_cds_index.sort()\nfor c in cands:\n    c[\\\"annotations\\\"] = an.annotate_candidate(c, models, tx_cds_index)\nstop_cands = [c for c in cands if any(a[\\\"consequence\\\"] == \\\"stop_gained\\\"\n                                      for a in c[\\\"annotations\\\"])]\nprint(\\\"candidates:\\\", len(cands), \\\" stop_gained:\\\", len(stop_cands), flush=True)\n\n# ---- pass 2: co-occurrence ----\ncpos = np.array([c[\\\"pos\\\"] for c in cands], dtype=np.int64)\norder = np.argsort(cpos)\ncands_o = [cands[k] for k in order]\ncpos = cpos[order]\ncalt = np.array([an.BASES.index(c[\\\"alt\\\"]) for c in cands_o], dtype=np.int64)\ncarriers = np.zeros(len(cpos), dtype=np.int64)\nclean = np.zeros(len(cpos), dtype=np.int64)\nothers = np.zeros(len(cpos), dtype=np.int64)\nstrand_plus = np.zeros(len(cpos), dtype=np.int64)\nstrand_minus = np.zeros(len(cpos), dtype=np.int64)\nmulti_reads = 0\nt0 = time.time()\nprint(\\\"=== pass 2: co-occurrence ===\\\", flush=True)\nfor n, (name, s, q) in enumerate(an.stream_fastq(an.FASTQ), 1):\n    if n % 100000 == 0:\n        print(\\\"  read %d (%.0f/s)\\\" % (n, n / (time.time() - t0)), flush=True)\n    codes = an.CODE[np.frombuffer(s.encode(), dtype=np.uint8)]\n    quals = np.frombuffer(q.encode(), dtype=np.uint8) - 33\n    pl = an.place_read(codes, quals, genome, index, glen)\n    if pl is None:\n        continue\n    orient, d1, left, right, seq, ql, nmm, vote = pl\n    p0, p1 = d1 + left, d1 + right - 1\n    lo = np.searchsorted(cpos, p0)\n    hi = np.searchsorted(cpos, p1, side=\\\"right\\\")\n    if hi <= lo:\n        continue\n    cps = cpos[lo:hi]\n    j = cps - p0                       # index into aligned read segment\n    b = seq[left:right].astype(np.int64)\n    qq = ql[left:right]\n    keep = (qq >= an.BASE_Q) & (b < 4)\n    m = (b[j] == calt[lo:hi]) & keep[j]\n    S = np.where(m)[0] + lo\n    if len(S) == 0:\n        continue\n    if len(S) > 1:\n        multi_reads += 1\n    for ci in S:\n        carriers[ci] += 1\n        others[ci] += len(S) - 1\n        if orient == 0:\n            strand_plus[ci] += 1\n        else:\n            strand_minus[ci] += 1\n        if len(S) == 1:\n            clean[ci] += 1\n\nres = []\nfor k, c in enumerate(cands_o):\n    res.append({\n        \\\"pos\\\": int(cpos[k]), \\\"ref\\\": c[\\\"ref\\\"], \\\"alt\\