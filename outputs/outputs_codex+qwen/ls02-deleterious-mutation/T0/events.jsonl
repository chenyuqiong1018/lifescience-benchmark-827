{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Set-Content -Path output/analysis.py -Value @'\n#\"'!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nMosaic nonsense (stop-gained) SNV detection in chr9 exome reads.\n\nPure-Python / numpy pipeline (no external aligner required):\n  1. Load GRCh38 chr9 reference and GENCODE v47 chr9 annotation.\n  2. Build a 16-mer index over protein-coding exon regions (+/-100 bp).\n  3. Place each read by seed voting (both orientations), verify ungapped,\n     trim poorly matching ends, and filter multimappers.\n  4. Pile up Q>=20 bases over CDS positions and call SNV candidates.\n  5. Annotate candidates against protein-coding transcripts; select the\n     high-confidence mosaic nonsense SNV in a LoF-intolerant gene.\n\nOutputs (relative to the workspace root):\n  output/variant.tsv, output/evidence.json, output/report.md\n\"\"\"\nimport gzip\nimport json\nimport os\nimport sys\nimport time\n\nimport numpy as np\n\n# ----------------------------- configuration -----------------------------\nK = 16                 # seed k-mer length\nSEED_STEP = 3          # seed spacing within reads\nFLANK = 100            # bp flanking exons included in alignment target\nMAX_KMER_HITS = 256    # k-mers with more hits are masked as repetitive\nMIN_VOTE = 5           # minimum seed votes for a placement\nAMBIG_RATIO = 0.8      # second-best vote >= ratio*best -> multimapper\nWINDOW_MM_FRAC = 0.05  # max mismatch fraction inside aligned window\nMIN_ALIGNED_LEN = 50   # minimum aligned read length after trimming\nBASE_Q = 20            # minimum base quality for pileup counting\nMIN_DEPTH = 8          # minimum depth to consider a position\nMIN_ALT = 3            # minimum alt-read count for a candidate\nMIN_AF = 0.02          # candidate allele-fraction window\nMAX_AF = 0.98\nCHROM = \"chr9\"\n\nBASES = \"ACGT\"\nSTOP_CODONS = {\"TAA\", \"TAG\", \"TGA\"}\nCODON_TABLE = {\n    \"TTT\": \"F\", \"TTC\": \"F\", \"TTA\": \"L\", \"TTG\": \"L\",\n    \"CTT\": \"L\", \"CTC\": \"L\", \"CTA\": \"L\", \"CTG\": \"L\",\n    \"ATT\": \"I\", \"ATC\": \"I\", \"ATA\": \"I\", \"ATG\": \"M\",\n    \"GTT\": \"V\", \"GTC\": \"V\", \"GTA\": \"V\", \"GTG\": \"V\",\n    \"TCT\": \"S\", \"TCC\": \"S\", \"TCA\": \"S\", \"TCG\": \"S\",\n    \"CCT\": \"P\", \"CCC\": \"P\", \"CCA\": \"P\", \"CCG\": \"P\",\n    \"ACT\": \"T\", \"ACC\": \"T\", \"ACA\": \"T\", \"ACG\": \"T\",\n    \"GCT\": \"A\", \"GCC\": \"A\", \"GCA\": \"A\", \"GCG\": \"A\",\n    \"TAT\": \"Y\", \"TAC\": \"Y\", \"TAA\": \"*\", \"TAG\": \"*\",\n    \"CAT\": \"H\", \"CAC\": \"H\", \"CAA\": \"Q\", \"CAG\": \"Q\",\n    \"AAT\": \"N\", \"AAC\": \"N\", \"AAA\": \"K\", \"AAG\": \"K\",\n    \"GAT\": \"D\", \"GAC\": \"D\", \"GAA\": \"E\", \"GAG\": \"E\",\n    \"TGT\": \"C\", \"TGC\": \"C\", \"TGA\": \"*\", \"TGG\": \"W\",\n    \"CGT\": \"R\", \"CGC\": \"R\", \"CGA\": \"R\", \"CGG\": \"R\",\n    \"AGT\": \"S\", \"AGC\": \"S\", \"AGA\": \"R\", \"AGG\": \"R\",\n    \"GGT\": \"G\", \"GGC\": \"G\", \"GGA\": \"G\", \"GGG\": \"G\",\n}\nAA3 = {\n    \"A\": \"Ala\", \"R\": \"Arg\", \"N\": \"Asn\", \"D\": \"Asp\", \"C\": \"Cys\",\n    \"Q\": \"Gln\", \"E\": \"Glu\", \"G\": \"Gly\", \"H\": \"His\", \"I\": \"Ile\",\n    \"L\": \"Leu\", \"K\": \"Lys\", \"M\": \"Met\", \"F\": \"Phe\", \"P\": \"Pro\",\n    \"S\": \"Ser\", \"T\": \"Thr\", \"W\": \"Trp\", \"Y\": \"Tyr\", \"V\": \"Val\",\n    \"*\": \"Ter\",\n}\n\nSCRIPT = os.path.abspath(__file__)\nROOT = os.path.dirname(os.path.dirname(SCRIPT))          # workspace root\nINPUTS = os.path.join(ROOT, \"inputs\")\nOUTDIR = os.path.join(ROOT, \"output\")\nFASTA = os.path.join(INPUTS, \"reference\", \"GRCh38_chr9.fa.gz\")\nGTF = os.path.join(INPUTS, \"reference\", \"gencode.v47.chr9.annotation.gtf.gz\")\nFASTQ = os.path.join(INPUTS, \"deleterious.mutation.q2.R1.fq.gz\")\n\nCODE = np.full(256, 4, dtype=np.uint8)\nfor _i, _b in enumerate(b\"ACGT\"):\n    CODE[_b] = _i\n    CODE[_b + 32] = _i          # lowercase\nCHAR_OF = np.array([ord(\"A\"), ord(\"C\"), ord(\"G\"), ord(\"T\"), ord(\"N\")],\n                   dtype=np.uint8)\n\n\ndef log(msg):\n    print(\"[%s] %s\" % (time.strftime(\"%H:%M:%S\"), msg), flush=True)\n\n\n# ----------------------------- reference -----------------------------\ndef load_fasta(path):\n    with gzip.open(path, \"rb\") as f:\n        raw = f.read()\n    lines = raw.split(b\"'\"\\\\n\\\")\n    seq = b\\\"\\\".join(l.strip() for l in lines if l and not l.startswith(b\\\">\\\"))\n    seq = seq.upper()\n    arr = np.frombuffer(seq, dtype=np.uint8).copy()\n    codes = CODE[arr]\n    log(\\\"loaded %s: %d bp\\\" % (os.path.basename(path), len(codes)))\n    return codes\n\n\n# ----------------------------- annotation -----------------------------\ndef parse_gtf(path):\n    \\\"\\\"\\\"Return transcripts of protein-coding genes:\n    tid -> dict(gene_id, gene_name, strand, cds=[(start,end)...], mane=bool)\n    plus merged interval helpers.\\\"\\\"\\\"\n    tx = {}\n    with gzip.open(path, \\\"rt\\\") as f:\n        for line in f:\n            if line.startswith(\\\"#\\\"):\n                continue\n            a = line.rstrip(\\\"\\\\n\\\").split(\\\"\\\\t\\\")\n            feat = a[2]\n            if feat not in (\\\"transcript\\\", \\\"CDS\\\"):\n                continue\n            attr = {}\n            tags = []\n            for kv in a[8].split(\\\";\\\"):\n                kv = kv.strip()\n                if not kv:\n                    continue\n                if kv.startswith(\\\"tag \\\"):\n                    tags.append(kv.split('\\\"')[1])\n                    continue\n                if '\\\"' in kv:\n                    key, val = kv.split(\\\" \\\", 1)\n                    attr[key] = val.strip('\\\"')\n                else:\n                    key, val = kv.split(\\\" \\\", 1)\n                    attr[key] = val\n            if attr.get(\\\"gene_type\\\") \"'!= \"protein_coding\":\n                continue\n            tid = attr[\"transcript_id\"]\n            if feat == \"transcript\":\n                if attr.get(\"transcript_type\") != \"protein_coding\":\n                    continue\n                tx[tid] = {\n                    \"gene_id\": attr[\"gene_id\"],\n                    \"gene_name\": attr.get(\"gene_name\", \"\"),\n                    \"strand\": a[6],\n                    \"cds\": [],\n                    \"mane\": \"MANE_Select\" in tags,\n                }\n            else:  # CDS\n                if tid in tx:\n                    tx[tid][\"cds\"].append((int(a[3]), int(a[4])))\n    for t in tx.values():\n        t[\"cds\"].sort()\n    tx = {k: v for k, v in tx.items() if v[\"cds\"]}\n    log(\"parsed %d protein-coding transcripts\" % len(tx))\n    return tx\n\n\ndef merge_intervals(iv, flank=0, upper=None):\n    iv = sorted((max(s - flank, 1), e + flank if upper is None\n                 else min(e + flank, upper)) for s, e in iv)\n    m = []\n    for s, e in iv:\n        if m and s <= m[-1][1] + 1:\n            m[-1][1] = max(m[-1][1], e)\n        else:\n            m.append([s, e])\n    return [tuple(x) for x in m]\n\n\n# ----------------------------- k-mer index -----------------------------\ndef build_index(genome, targets):\n    mask = (1 << (2 * K)) - 1\n    index = {}\n    counts = {}\n    for s, e in targets:\n        seg = genome[s - 1:e]\n        val = 0\n        nbad = 0\n        for i, c in enumerate(seg):\n            if c == 4:\n                nbad += 1\n            val = ((val << 2) | int(c)) & mask\n            if i >= K and seg[i - K] == 4:\n                nbad -= 1\n            if i >= K - 1 and nbad == 0:\n                g = s + (i - K + 1)          # 1-based genome position\n                if val in counts and counts[val] is None:\n                    continue\n                lst = index.get(val)\n                if lst is None:\n                    index[val] = [g]\n                    counts[val] = 1\n                else:\n                    lst.append(g)\n                    n = counts[val] + 1\n                    if n > MAX_KMER_HITS:\n                        index[val] = None\n                        counts[val] = None\n                    else:\n                        counts[val] = n\n    kept = sum(1 for v in index.values() if v is not None)\n    log(\"k-mer index: %d distinct %d-mers kept (targets=%d bp)\" %\n        (kept, K, sum(e - s + 1 for s, e in targets)))\n    return index\n\n\ndef seed_votes(codes, index):\n    votes = {}\n    L = len(codes)\n    if L < K + 2:\n        return votes\n    mask = (1 << (2 * K)) - 1\n    val = 0\n    nbad = 0\n    get = index.get\n    for i in range(L):\n        c = codes[i]\n        if c == 4:\n            nbad += 1\n        val = ((val << 2) | int(c)) & mask\n        if i >= K and codes[i - K] == 4:\n            nbad -= 1\n        if i >= K - 1 and nbad == 0:\n            off = i - K + 1\n            if off % SEED_STEP:\n                continue\n            hits = get(val)\n            if hits:\n                for g in hits:\n                    d = g - off\n                    votes[d] = votes.get(d, 0) + 1\n    return votes\n\n\n# ----------------------------- placement -----------------------------\ndef best_window(mm):\n    \"\"\"Largest read window [i,j) with mismatch fraction <= WINDOW_MM_FRAC.\"\"\"\n    L = len(mm)\n    if L < MIN_ALIGNED_LEN:\n        return None\n    P = np.concatenate(([0], np.cumsum(mm))).astype(np.int32)\n    best = None\n    for i in range(0, L - MIN_ALIGNED_LEN + 1, 3):\n        j = L\n        while j - i >= MIN_ALIGNED_LEN:\n            m = int(P[j] - P[i])\n            allowed = max(4, int(WINDOW_MM_FRAC * (j - i)))\n            if m <= allowed:\n                break\n            j -= max(1, m - allowed)\n        if j - i >= MIN_ALIGNED_LEN:\n            if best is None or (j - i) > (best[1] - best[0]):\n                best = (i, j)\n    return best\n\n\ndef place_read(codes, quals, genome, index, glen):\n    \"\"\"Return (orient, gstart, left, right, mismatches, vote, ambiguous)\n    for the best placement, or None. gstart: 1-based genome position of\n    oriented-read base 0. Aligned segment is [left,right) in read coords.\"\"\"\n    rc = (3 - codes)[::-1].copy()\n    rquals = quals[::-1].copy()\n    best = None\n    for orient, seq in ((0, codes), (1, rc)):\n        votes = seed_votes(seq, index)\n        if not votes:\n            continue\n        d1 = max(votes, key=lambda d: (votes[d], -d))\n        v1 = votes[d1]\n        if v1 < MIN_VOTE:\n            continue\n        amb = False\n        for d2, v2 in votes.items():\n            if d2 != d1 and abs(d2 - d1) > 32 and v2 >= AMBIG_RATIO * v1:\n                amb = True\n                break\n        if amb:\n            if best is None or best[6]:\n                best = (orient, d1, 0, 0, 0, v1, True)\n            continue\n        L = len(seq)\n        lo = max(d1, 1)\n        hi = min(d1 + L - 1, glen)\n        if hi - lo + 1 < MIN_ALIGNED_LEN:\n            continue\n        left0 = lo - d1\n        right0 = hi - d1 + 1\n        ref = genome[lo - 1:hi]\n        seg = seq[left0:right0]\n        mm = (seg != ref) | (ref == 4)\n        win = best_window(mm)\n        if win is None:\n            continue\n        i, j = win\n        nmm = int(mm[i:j].sum())\n        cand = (orient, d1, left0 + i, left0 + j, nmm, v1, False)\n        if best is None or best[6] or (cand[4], -(cand[3] - cand[2])) < (best[4], -(best[3] - best[2])):\n            best = cand\n    if best is None or best[6]:\n        return None\n    orient, d1, left, right, nmm, v1, _ = best\n    seq = codes if orient == 0 else (3 - codes)[::-1]\n    ql = quals if orient == 0 else quals[::-1]\n    return orient, d1, left, right, seq, ql, nmm, v1\n\n\n# ----------------------------- pileup -----------------------------\ndef stream_fastq(path):\n    with gzip.open(path, \"rt\") as f:\n        while True:\n            h = f.readline()\n            if not h:\n                break\n            s = f.readline().rstrip(\"'\"\\\\n\\\")\n            f.readline()\n            q = f.readline().rstrip(\\\"\\\\n\\\")\n            yield h[1:].strip(), s, q\n\n\ndef run_pass(path, genome, index, tx, cds_starts, cds_ends, cds_pos_map,\n             glen, collect=None):\n    \\\"\\\"\\\"Map reads and pile up Q>=20 bases over CDS positions.\n    If collect is a dict {genome_pos: {...}}, gather read-level evidence\n    there instead of (as well as) counting.\\\"\\\"\\\"\n    n_cds = len(cds_pos_map)\n    flat = np.zeros(n_cds * 8, dtype=np.int32)\n    stats = Counter()\n    t0 = time.time()\n    for n, (name, s, q) in enumerate(stream_fastq(path), 1):\n        if n % 100000 == 0:\n            log(\\\"  pass read %d (%.1f/s)\\\" % (n, n / (time.time() - t0 + 1e-9)))\n        codes = CODE[np.frombuffer(s.encode(), dtype=np.uint8)]\n        quals = np.frombuffer(q.encode(), dtype=np.uint8) - 33\n        stats[\\\"total\\\"] += 1\n        pl = place_read(codes, quals, genome, index, glen)\n        if pl is None:\n            stats[\\\"unmapped\\\"] += 1\n            continue\n        orient, d1, left, right, seq, ql, nmm, vote = pl\n        stats[\\\"mapped\\\"] += 1\n        p = np.arange(d1 + left, d1 + right, dtype=np.int64)   # 1-based\n        b = seq[left:right].astype(np.int64)\n        qq = ql[left:right]\n        keep = (qq >= BASE_Q) & (b < 4)\n        p = p[keep]\n        b = b[keep]\n        if collect is not None and len(collect):\n            for cp in collect:\n                hit = np.where(p == cp)[0]\n                for hidx in hit:\n                    ev = collect[cp]\n                    ev[\\\"reads\\\"].append({\n                        \\\"read\\\": name,\n                        \\\"strand\\\": \\\"-\\\" if orient else \\\"+\\\",\n                        \\\"base\\\": BASES[b[hidx]],\n                        \\\"bq\\\": int(qq[hidx]),\n                        \\\"mismatches\\\": int(nmm),\n                        \\\"votes\\\": int(vote),\n                    })\n        if len(p) == 0:\n            continue\n        idx = np.searchsorted(cds_starts, p, side=\\\"right\\\") - 1\n        valid = (idx >= 0) & (p <= cds_ends[idx])\n        if not valid.any():\n            continue\n        idx = idx[valid]\n        lin = idx * 8 + b[valid] * 2 + orient\n        np.add.at(flat, lin, 1)\n    stats[\\\"wall_s\\\"] = round(time.time() - t0, 1)\n    return flat, stats\n\n\ndef call_variants(flat, genome, cds_pos_map, cds_starts):\n    cm = flat.reshape(-1, 8)\n    n = cm.shape[0]\n    depth = cm.sum(axis=1)\n    ref_code = genome[cds_pos_map - 1]\n    base_ct = cm[:, 0::2] + cm[:, 1::2]                    # n x 4, both strands\n    alt_ct = base_ct.copy()\n    alt_ct[np.arange(n), ref_code] = 0\n    best_alt = alt_ct.argmax(axis=1)\n    best_ct = alt_ct[np.arange(n), best_alt]\n    af = np.where(depth > 0, best_ct / np.maximum(depth, 1), 0.0)\n    mask = (depth >= MIN_DEPTH) & (best_ct >= MIN_ALT) & \\\\\n           (af >= MIN_AF) & (af <= MAX_AF)\n    cands = []\n    for i in np.where(mask)[0]:\n        pos = int(cds_pos_map[i])\n        rc = int(ref_code[i])\n        ac = int(best_alt[i])\n        cands.append({\n            \\\"chrom\\\": CHROM,\n            \\\"pos\\\": pos,\n            \\\"ref\\\": BASES[rc],\n            \\\"alt\\\": BASES[ac],\n            \\\"alt_reads\\\": int(best_ct[i]),\n            \\\"ref_reads\\\": int(depth[i] - best_ct[i]),\n            \\\"total_reads\\\": int(depth[i]),\n            \\\"allele_fraction\\\": round(int(best_ct[i]) / int(depth[i]), 4),\n            \\\"alt_fwd\\\": int(cm[i, ac * 2]),\n            \\\"alt_rev\\\": int(cm[i, ac * 2 + 1]),\n            \\\"depth_fwd\\\": int(cm[i, 0::2].sum()),\n            \\\"depth_rev\\\": int(cm[i, 1::2].sum()),\n        })\n    cands.sort(key=lambda c: -c[\\\"alt_reads\\\"])\n    log(\\\"variant candidates (CDS, depth>=%d, alt>=%d): %d\\\" %\n        (MIN_DEPTH, MIN_ALT, len(cands)))\n    return cands\n\n\n# ----------------------------- annotation -----------------------------\ndef build_tx_models(tx, genome):\n    models = {}\n    for tid, t in tx.items():\n        strand = t[\\\"strand\\\"]\n        cds = t[\\\"cds\\\"] if strand == \\\"+\\\" else list(reversed(t[\\\"cds\\\"]))\n        seq = []\n        bounds = []           # cumulative cds coordinates per segment\n        cum = 0\n        for s, e in cds:\n            seg = genome[s - 1:e]\n            if strand == \\\"-\\\":\n                seg = (3 - seg)[::-1]\n            seq.append(bytes(CHAR_OF[seg]))\n            bounds.append((cum, cum + (e - s + 1), s, e))\n            cum += e - s + 1\n        models[tid] = {\n            \\\"gene_id\\\": t[\\\"gene_id\\\"],\n            \\\"gene_name\\\": t[\\\"gene_name\\\"],\n            \\\"strand\\\": strand,\n            \\\"mane\\\": t[\\\"mane\\\"],\n            \\\"seq\\\": b\\\"\\\".join(seq),\n            \\\"bounds\\\": bounds,\n            \\\"cds\\\": t[\\\"cds\\\"],\n        }\n    return models\n\n\ndef cds_offset(models, tid, pos):\n    \\\"\\\"\\\"0-based CDS coordinate of genomic pos in transcript, or None.\\\"\\\"\\\"\n    m = models[tid]\n    for cum0, cum1, s, e in m[\\\"bounds\\\"]:\n        if s <= pos <= e:\n            if m[\\\"strand\\\"] == \\\"+\\\":\n                return cum0 + (pos - s)\n            else:\n                return cum0 + (e - pos)\n    return None\n\n\ndef annotate_candidate(c, models, tx_cds_index):\n    \\\"\\\"\\\"tx_cds_index: sorted list (start, end, tid). Returns list of\n    consequences across transcripts covering the position.\\\"\\\"\\\"\n    pos = c[\\\"pos\\\"]\n    lo = np.searchsorted([x[0] for x in tx_cds_index], pos, side=\\\"right\\\") - 1\n    out = []\n    for k in range(max(0, lo - 2), min(len(tx_cds_index), lo + 400)):\n        pass\n    # linear scan over segments overlapping pos\n    i = np.searchsorted([x[0] for x in tx_cds_index], pos, side=\\\"right\\\") - 1\n    hits = []\n    while i >= 0 and tx_cds_index[i][1] >= pos:\n        if tx_cds_index[i][0] <= pos:\n            hits.append(tx_cds_index[i][2])\n        i -= 1\n    for tid in hits:\n        m = models[tid]\n        off = cds_offset(models, tid, pos)\n        if off is None or off >= len(m[\\\"seq\\\"]):\n            continue\n        frame = off % 3\n        cs = off - frame\n        codon = bytearray(m[\\\"seq\\\"][cs:cs + 3])\n        if len(codon) < 3:\n            continue\n        ref_codon = bytes(codon).decode()\n        codon[frame] = ord(c[\\\"alt\\\"])\n        alt_codon = bytes(codon).decode()\n        ref_aa = CODON_TABLE.get(ref_codon, \\\"?\\\")\n        alt_aa = CODON_TABLE.get(alt_codon, \\\"?\\\")\n        if alt_aa == \\\"*\\\" and ref_aa \"'!= \"*\":\n            cons = \"stop_gained\"\n        elif ref_aa == \"*\" and alt_aa != \"*\":\n            cons = \"stop_lost\"\n        elif alt_aa != ref_aa:\n            cons = \"missense_variant\"\n        else:\n            cons = \"synonymous_variant\"\n        hgvs = \"p.(%s%d%s)\" % (AA3.get(ref_aa, \"?\"), cs // 3 + 1,\n                               AA3.get(alt_aa, \"?\"))\n        out.append({\n            \"transcript_id\": tid,\n            \"gene_id\": m[\"gene_id\"],\n            \"gene_name\": m[\"gene_name\"],\n            \"strand\": m[\"strand\"],\n            \"mane_select\": m[\"mane\"],\n            \"consequence\": cons,\n            \"hgvs_p\": hgvs,\n            \"ref_codon\": ref_codon,\n            \"alt_codon\": alt_codon,\n            \"cds_position\": off + 1,\n        })\n    return out\n\n\n# ----------------------------- main -----------------------------\ndef main():\n    os.makedirs(OUTDIR, exist_ok=True)\n    genome = load_fasta(FASTA)\n    glen = len(genome)\n    tx = parse_gtf(GTF)\n    models = build_tx_models(tx, genome)\n\n    # CDS merged intervals (pileup domain) and exon+flank target (index domain)\n    all_cds = []\n    all_exons = []\n    for tid, t in tx.items():\n        all_cds.extend(t[\"cds\"])\n    # exons from GTF re-parse (quick): reuse CDS flank target instead\n    targets = merge_intervals(all_cds, flank=FLANK, upper=glen)\n    cds_merged = merge_intervals(all_cds)\n    cds_starts = np.array([s for s, e in cds_merged], dtype=np.int64)\n    cds_ends = np.array([e for s, e in cds_merged], dtype=np.int64)\n    cds_pos_map = np.concatenate([np.arange(s, e + 1) for s, e in cds_merged])\n    log(\"CDS mask: %d intervals, %d bp; index target: %d intervals, %d bp\" %\n        (len(cds_merged), len(cds_pos_map), len(targets),\n         sum(e - s + 1 for s, e in targets)))\n\n    index = build_index(genome, targets)\n\n    # global CDS segment index for annotation\n    tx_cds_index = []\n    for tid, t in tx.items():\n        for s, e in t[\"cds\"]:\n            tx_cds_index.append((s, e, tid))\n    tx_cds_index.sort()\n    tx_cds_starts = np.array([x[0] for x in tx_cds_index])\n\n    log(\"=== pass 1: mapping + pileup ===\")\n    flat, stats = run_pass(FASTQ, genome, index, tx, cds_starts, cds_ends,\n                           cds_pos_map, glen)\n    cands = call_variants(flat, genome, cds_pos_map, cds_starts)\n\n    log(\"annotating candidates\")\n    for c in cands:\n        c[\"annotations\"] = annotate_candidate(c, models, tx_cds_index)\n    stop_cands = [c for c in cands\n                  if any(a[\"consequence\"] == \"stop_gained\"\n                         for a in c[\"annotations\"])]\n    log(\"stop-gained candidates: %d\" % len(stop_cands))\n\n    # ---- read-level evidence for stop-gained candidates (pass 2) ----\n    collect = {c[\"pos\"]: {\"reads\": []} for c in stop_cands}\n    if collect:\n        log(\"=== pass 2: read-level evidence for %d positions ===\" %\n            len(collect))\n        _, stats2 = run_pass(FASTQ, genome, index, tx, cds_starts, cds_ends,\n                             cds_pos_map, glen, collect=collect)\n\n    # ---- select final variant ----\n    def score(c):\n        return (c[\"alt_reads\"], c[\"allele_fraction\"])\n    stop_cands.sort(key=score, reverse=True)\n    final = stop_cands[0] if stop_cands else None\n\n    if final is not None:\n        ev = collect.get(final[\"pos\"], {\"reads\": []})\n        alt_reads = [r for r in ev[\"reads\"] if r[\"base\"] == final[\"alt\"]]\n        final[\"evidence\"] = {\n            \"n_supporting_reads\": len(alt_reads),\n            \"supporting_strands\": {\n                \"+\": sum(1 for r in alt_reads if r[\"strand\"] == \"+\"),\n                \"-\": sum(1 for r in alt_reads if r[\"strand\"] == \"-\"),\n            },\n            \"mean_base_quality_alt\": round(float(np.mean(\n                [r[\"bq\"] for r in alt_reads])), 2) if alt_reads else None,\n            \"min_base_quality_alt\": int(min(\n                (r[\"bq\"] for r in alt_reads), default=-1)),\n            \"mean_mismatches_supporting\": round(float(np.mean(\n                [r[\"mismatches\"] for r in alt_reads])), 3) if alt_reads else None,\n            \"all_reads_at_pos\": len(ev[\"reads\"]),\n        }\n        ann = [a for a in final[\"annotations\"]\n               if a[\"consequence\"] == \"stop_gained\"]\n        ann.sort(key=lambda a: (not a[\"mane_select\"], a[\"transcript_id\"]))\n        final[\"reported_annotation\"] = ann[0]\n\n    # ---------------- outputs ----------------\n    with open(os.path.join(OUTDIR, \"variant.tsv\"), \"w\") as f:\n        f.write(\"chrom'\"\\\\tpos\\\\tref\\\\talt\\\\tgene\\\\tconsequence\\\\talt_reads\\\\t\\\"\n                \\\"total_reads\\\\tallele_fraction\\\\n\\\")\n        if final is not None:\n            a = final[\\\"reported_annotation\\\"]\n            f.write(\\\"%s\\\\t%d\\\\t%s\\\\t%s\\\\t%s\\\\t%s\\\\t%d\\\\t%d\\\\t%.4f\\\\n\\\" % (\n                final[\\\"chrom\\\"], final[\\\"pos\\\"], final[\\\"ref\\\"], final[\\\"alt\\\"],\n                a[\\\"gene_name\\\"], a[\\\"consequence\\\"], final[\\\"alt_reads\\\"],\n                final[\\\"total_reads\\\"], final[\\\"allele_fraction\\\"]))\n\n    # coverage stats\n    cm = flat.reshape(-1, 8)\n    depth = cm.sum(axis=1)\n    cov_stats = {\n        \\\"cds_positions\\\": int(len(depth)),\n        \\\"positions_ge_10x\\\": int((depth >= 10).sum()),\n        \\\"fraction_cds_ge_10x\\\": round(float((depth >= 10).mean()), 4),\n        \\\"mean_cds_depth\\\": round(float(depth.mean()), 2),\n    }\n\n    evidence = {\n        \\\"reference\\\": {\n            \\\"genome_build\\\": \\\"GRCh38 (primary assembly, chr9)\\\",\n            \\\"reference_fasta\\\": \\\"GRCh38_chr9.fa.gz (Broad GATK bundle, chr9)\\\",\n            \\\"coordinate_system\\\": \\\"chr9, 1-based\\\",\n        },\n        \\\"annotation\\\": {\n            \\\"source\\\": \\\"GENCODE v47 (Ensembl 113), chr9 records\\\",\n            \\\"file\\\": \\\"gencode.v47.chr9.annotation.gtf.gz\\\",\n            \\\"biotype_filter\\\": \\\"protein_coding genes/transcripts\\\",\n        },\n        \\\"pipeline\\\": {\n            \\\"aligner\\\": \\\"custom seed-and-verify mapper (analysis.py)\\\",\n            \\\"seed_k\\\": K,\n            \\\"seed_step\\\": SEED_STEP,\n            \\\"index_target\\\": \\\"protein-coding CDS +/- %d bp\\\" % FLANK,\n            \\\"min_seed_votes\\\": MIN_VOTE,\n            \\\"max_mismatch_fraction\\\": WINDOW_MM_FRAC,\n            \\\"min_base_quality\\\": BASE_Q,\n            \\\"min_depth\\\": MIN_DEPTH,\n            \\\"min_alt_reads\\\": MIN_ALT,\n        },\n        \\\"read_stats\\\": dict(stats),\n        \\\"coverage\\\": cov_stats,\n        \\\"candidate_snvs_total\\\": len(cands),\n        \\\"stop_gained_candidates\\\": [\n            {k: v for k, v in c.items() if k not in (\\\"annotations\\\",)} |\n            {\\\"annotations\\\": c[\\\"annotations\\\"]}\n            for c in stop_cands\n        ],\n        \\\"final_variant\\\": final,\n    }\n    with open(os.path.join(OUTDIR, \\\"evidence.json\\\"), \\\"w\\\") as f:\n        json.dump(evidence, f, indent=2)\n\n    # console summary\n    print(\\\"\\\\n=== SUMMARY ===\\\")\n    print(\\\"reads total/mapped: %d / %d\\\" % (stats[\\\"total\\\"], stats[\\\"mapped\\\"]))\n    print(\\\"candidates: %d ; stop_gained: %d\\\" % (len(cands), len(stop_cands)))\n    if final is not None:\n        a = final[\\\"reported_annotation\\\"]\n        print(\\\"FINAL: %s:%d %s>%s %s %s AF=%.4f (%d/%d) %s\\\" % (\n            final[\\\"chrom\\\"], final[\\\"pos\\\"], final[\\\"ref\\\"], final[\\\"alt\\\"],\n            a[\\\"gene_name\\\"], a[\\\"consequence\\\"], final[\\\"allele_fraction\\\"],\n            final[\\\"alt_reads\\\"], final[\\\"total_reads\\\"], a[\\\"hgvs_p\\\"]))\n    for c in stop_cands[1:]:\n        a = c[\\\"annotations\\\"][0]\n        print(\\\"ALT:   %s:%d %s>%s %s AF=%.4f\\\" % (\n            c[\\\"chrom\\\"], c[\\\"pos\\\"], c[\\\"ref\\\"], c[\\\"alt\\\"], a[\\\"gene_name\\\"],\n            c[\\\"allele_fraction\\\"]))\n    print(\\\"wrote output/variant.tsv and output/evidence.json\\\")\n\n\nif __name__ == \\\"__main__\\\":\n    main()\n'@ -Encoding utf8; (Get-Item output/analysis.py).Length\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Set-Content -Path output/analysis.py -Value @'\n#\"'!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nMosaic nonsense (stop-gained) SNV detection in chr9 exome reads.\n\nPure-Python / numpy pipeline (no external aligner required):\n  1. Load GRCh38 chr9 reference and GENCODE v47 chr9 annotation.\n  2. Build a 16-mer index over protein-coding exon regions (+/-100 bp).\n  3. Place each read by seed voting (both orientations), verify ungapped,\n     trim poorly matching ends, and filter multimappers.\n  4. Pile up Q>=20 bases over CDS positions and call SNV candidates.\n  5. Annotate candidates against protein-coding transcripts; select the\n     high-confidence mosaic nonsense SNV in a LoF-intolerant gene.\n\nOutputs (relative to the workspace root):\n  output/variant.tsv, output/evidence.json, output/report.md\n\"\"\"\nimport gzip\nimport json\nimport os\nimport sys\nimport time\n\nimport numpy as np\n\n# ----------------------------- configuration -----------------------------\nK = 16                 # seed k-mer length\nSEED_STEP = 3          # seed spacing within reads\nFLANK = 100            # bp flanking exons included in alignment target\nMAX_KMER_HITS = 256    # k-mers with more hits are masked as repetitive\nMIN_VOTE = 5           # minimum seed votes for a placement\nAMBIG_RATIO = 0.8      # second-best vote >= ratio*best -> multimapper\nWINDOW_MM_FRAC = 0.05  # max mismatch fraction inside aligned window\nMIN_ALIGNED_LEN = 50   # minimum aligned read length after trimming\nBASE_Q = 20            # minimum base quality for pileup counting\nMIN_DEPTH = 8          # minimum depth to consider a position\nMIN_ALT = 3            # minimum alt-read count for a candidate\nMIN_AF = 0.02          # candidate allele-fraction window\nMAX_AF = 0.98\nCHROM = \"chr9\"\n\nBASES = \"ACGT\"\nSTOP_CODONS = {\"TAA\", \"TAG\", \"TGA\"}\nCODON_TABLE = {\n    \"TTT\": \"F\", \"TTC\": \"F\", \"TTA\": \"L\", \"TTG\": \"L\",\n    \"CTT\": \"L\", \"CTC\": \"L\", \"CTA\": \"L\", \"CTG\": \"L\",\n    \"ATT\": \"I\", \"ATC\": \"I\", \"ATA\": \"I\", \"ATG\": \"M\",\n    \"GTT\": \"V\", \"GTC\": \"V\", \"GTA\": \"V\", \"GTG\": \"V\",\n    \"TCT\": \"S\", \"TCC\": \"S\", \"TCA\": \"S\", \"TCG\": \"S\",\n    \"CCT\": \"P\", \"CCC\": \"P\", \"CCA\": \"P\", \"CCG\": \"P\",\n    \"ACT\": \"T\", \"ACC\": \"T\", \"ACA\": \"T\", \"ACG\": \"T\",\n    \"GCT\": \"A\", \"GCC\": \"A\", \"GCA\": \"A\", \"GCG\": \"A\",\n    \"TAT\": \"Y\", \"TAC\": \"Y\", \"TAA\": \"*\", \"TAG\": \"*\",\n    \"CAT\": \"H\", \"CAC\": \"H\", \"CAA\": \"Q\", \"CAG\": \"Q\",\n    \"AAT\": \"N\", \"AAC\": \"N\", \"AAA\": \"K\", \"AAG\": \"K\",\n    \"GAT\": \"D\", \"GAC\": \"D\", \"GAA\": \"E\", \"GAG\": \"E\",\n    \"TGT\": \"C\", \"TGC\": \"C\", \"TGA\": \"*\", \"TGG\": \"W\",\n    \"CGT\": \"R\", \"CGC\": \"R\", \"CGA\": \"R\", \"CGG\": \"R\",\n    \"AGT\": \"S\", \"AGC\": \"S\", \"AGA\": \"R\", \"AGG\": \"R\",\n    \"GGT\": \"G\", \"GGC\": \"G\", \"GGA\": \"G\", \"GGG\": \"G\",\n}\nAA3 = {\n    \"A\": \"Ala\", \"R\": \"Arg\", \"N\": \"Asn\", \"D\": \"Asp\", \"C\": \"Cys\",\n    \"Q\": \"Gln\", \"E\": \"Glu\", \"G\": \"Gly\", \"H\": \"His\", \"I\": \"Ile\",\n    \"L\": \"Leu\", \"K\": \"Lys\", \"M\": \"Met\", \"F\": \"Phe\", \"P\": \"Pro\",\n    \"S\": \"Ser\", \"T\": \"Thr\", \"W\": \"Trp\", \"Y\": \"Tyr\", \"V\": \"Val\",\n    \"*\": \"Ter\",\n}\n\nSCRIPT = os.path.abspath(__file__)\nROOT = os.path.dirname(os.path.dirname(SCRIPT))          # workspace root\nINPUTS = os.path.join(ROOT, \"inputs\")\nOUTDIR = os.path.join(ROOT, \"output\")\nFASTA = os.path.join(INPUTS, \"reference\", \"GRCh38_chr9.fa.gz\")\nGTF = os.path.join(INPUTS, \"reference\", \"gencode.v47.chr9.annotation.gtf.gz\")\nFASTQ = os.path.join(INPUTS, \"deleterious.mutation.q2.R1.fq.gz\")\n\nCODE = np.full(256, 4, dtype=np.uint8)\nfor _i, _b in enumerate(b\"ACGT\"):\n    CODE[_b] = _i\n    CODE[_b + 32] = _i          # lowercase\nCHAR_OF = np.array([ord(\"A\"), ord(\"C\"), ord(\"G\"), ord(\"T\"), ord(\"N\")],\n                   dtype=np.uint8)\n\n\ndef log(msg):\n    print(\"[%s] %s\" % (time.strftime(\"%H:%M:%S\"), msg), flush=True)\n\n\n# ----------------------------- reference -----------------------------\ndef load_fasta(path):\n    with gzip.open(path, \"rb\") as f:\n        raw = f.read()\n    lines = raw.split(b\"'\"\\\\n\\\")\n    seq = b\\\"\\\".join(l.strip() for l in lines if l and not l.startswith(b\\\">\\\"))\n    seq = seq.upper()\n    arr = np.frombuffer(seq, dtype=np.uint8).copy()\n    codes = CODE[arr]\n    log(\\\"loaded %s: %d bp\\\" % (os.path.basename(path), len(codes)))\n    return codes\n\n\n# ----------------------------- annotation -----------------------------\ndef parse_gtf(path):\n    \\\"\\\"\\\"Return transcripts of protein-coding genes:\n    tid -> dict(gene_id, gene_name, strand, cds=[(start,end)...], mane=bool)\n    plus merged interval helpers.\\\"\\\"\\\"\n    tx = {}\n    with gzip.open(path, \\\"rt\\\") as f:\n        for line in f:\n            if line.startswith(\\\"#\\\"):\n                continue\n            a = line.rstrip(\\\"\\\\n\\\").split(\\\"\\\\t\\\")\n            feat = a[2]\n            if feat not in (\\\"transcript\\\", \\\"CDS\\\"):\n                continue\n            attr = {}\n            tags = []\n            for kv in a[8].split(\\\";\\\"):\n                kv = kv.strip()\n                if not kv:\n                    continue\n                if kv.startswith(\\\"tag \\\"):\n                    tags.append(kv.split('\\\"')[1])\n                    continue\n                if '\\\"' in kv:\n                    key, val = kv.split(\\\" \\\", 1)\n                    attr[key] = val.strip('\\\"')\n                else:\n                    key, val = kv.split(\\\" \\\", 1)\n                    attr[key] = val\n            if attr.get(\\\"gene_type\\\") \"'!= \"protein_coding\":\n                continue\n            tid = attr[\"transcript_id\"]\n            if feat == \"transcript\":\n                if attr.get(\"transcript_type\") != \"protein_coding\":\n                    continue\n                tx[tid] = {\n                    \"gene_id\": attr[\"gene_id\"],\n                    \"gene_name\": attr.get(\"gene_name\", \"\"),\n                    \"strand\": a[6],\n                    \"cds\": [],\n                    \"mane\": \"MANE_Select\" in tags,\n                }\n            else:  # CDS\n                if tid in tx:\n                    tx[tid][\"cds\"].append((int(a[3]), int(a[4])))\n    for t in tx.values():\n        t[\"cds\"].sort()\n    tx = {k: v for k, v in tx.items() if v[\"cds\"]}\n    log(\"parsed %d protein-coding transcripts\" % len(tx))\n    return tx\n\n\ndef merge_intervals(iv, flank=0, upper=None):\n    iv = sorted((max(s - flank, 1), e + flank if upper is None\n                 else min(e + flank, upper)) for s, e in iv)\n    m = []\n    for s, e in iv:\n        if m and s <= m[-1][1] + 1:\n            m[-1][1] = max(m[-1][1], e)\n        else:\n            m.append([s, e])\n    return [tuple(x) for x in m]\n\n\n# ----------------------------- k-mer index -----------------------------\ndef build_index(genome, targets):\n    mask = (1 << (2 * K)) - 1\n    index = {}\n    counts = {}\n    for s, e in targets:\n        seg = genome[s - 1:e]\n        val = 0\n        nbad = 0\n        for i, c in enumerate(seg):\n            if c == 4:\n                nbad += 1\n            val = ((val << 2) | int(c)) & mask\n            if i >= K and seg[i - K] == 4:\n                nbad -= 1\n            if i >= K - 1 and nbad == 0:\n                g = s + (i - K + 1)          # 1-based genome position\n                if val in counts and counts[val] is None:\n                    continue\n                lst = index.get(val)\n                if lst is None:\n                    index[val] = [g]\n                    counts[val] = 1\n                else:\n                    lst.append(g)\n                    n = counts[val] + 1\n                    if n > MAX_KMER_HITS:\n                        index[val] = None\n                        counts[val] = None\n                    else:\n                        counts[val] = n\n    kept = sum(1 for v in index.values() if v is not None)\n    log(\"k-mer index: %d distinct %d-mers kept (targets=%d bp)\" %\n        (kept, K, sum(e - s + 1 for s, e in targets)))\n    return index\n\n\ndef seed_votes(codes, index):\n    votes = {}\n    L = len(codes)\n    if L < K + 2:\n        return votes\n    mask = (1 << (2 * K)) - 1\n    val = 0\n    nbad = 0\n    get = index.get\n    for i in range(L):\n        c = codes[i]\n        if c == 4:\n            nbad += 1\n        val = ((val << 2) | int(c)) & mask\n        if i >= K and codes[i - K] == 4:\n            nbad -= 1\n        if i >= K - 1 and nbad == 0:\n            off = i - K + 1\n            if off % SEED_STEP:\n                continue\n            hits = get(val)\n            if hits:\n                for g in hits:\n                    d = g - off\n                    votes[d] = votes.get(d, 0) + 1\n    return votes\n\n\n# ----------------------------- placement -----------------------------\ndef best_window(mm):\n    \"\"\"Largest read window [i,j) with mismatch fraction <= WINDOW_MM_FRAC.\"\"\"\n    L = len(mm)\n    if L < MIN_ALIGNED_LEN:\n        return None\n    P = np.concatenate(([0], np.cumsum(mm))).astype(np.int32)\n    best = None\n    for i in range(0, L - MIN_ALIGNED_LEN + 1, 3):\n        j = L\n        while j - i >= MIN_ALIGNED_LEN:\n            m = int(P[j] - P[i])\n            allowed = max(4, int(WINDOW_MM_FRAC * (j - i)))\n            if m <= allowed:\n                break\n            j -= max(1, m - allowed)\n        if j - i >= MIN_ALIGNED_LEN:\n            if best is None or (j - i) > (best[1] - best[0]):\n                best = (i, j)\n    return best\n\n\ndef place_read(codes, quals, genome, index, glen):\n    \"\"\"Return (orient, gstart, left, right, mismatches, vote, ambiguous)\n    for the best placement, or None. gstart: 1-based genome position of\n    oriented-read base 0. Aligned segment is [left,right) in read coords.\"\"\"\n    rc = (3 - codes)[::-1].copy()\n    rquals = quals[::-1].copy()\n    best = None\n    for orient, seq in ((0, codes), (1, rc)):\n        votes = seed_votes(seq, index)\n        if not votes:\n            continue\n        d1 = max(votes, key=lambda d: (votes[d], -d))\n        v1 = votes[d1]\n        if v1 < MIN_VOTE:\n            continue\n        amb = False\n        for d2, v2 in votes.items():\n            if d2 != d1 and abs(d2 - d1) > 32 and v2 >= AMBIG_RATIO * v1:\n                amb = True\n                break\n        if amb:\n            if best is None or best[6]:\n                best = (orient, d1, 0, 0, 0, v1, True)\n            continue\n        L = len(seq)\n        lo = max(d1, 1)\n        hi = min(d1 + L - 1, glen)\n        if hi - lo + 1 < MIN_ALIGNED_LEN:\n            continue\n        left0 = lo - d1\n        right0 = hi - d1 + 1\n        ref = genome[lo - 1:hi]\n        seg = seq[left0:right0]\n        mm = (seg != ref) | (ref == 4)\n        win = best_window(mm)\n        if win is None:\n            continue\n        i, j = win\n        nmm = int(mm[i:j].sum())\n        cand = (orient, d1, left0 + i, left0 + j, nmm, v1, False)\n        if best is None or best[6] or (cand[4], -(cand[3] - cand[2])) < (best[4], -(best[3] - best[2])):\n            best = cand\n    if best is None or best[6]:\n        return None\n    orient, d1, left, right, nmm, v1, _ = best\n    seq = codes if orient == 0 else (3 - codes)[::-1]\n    ql = quals if orient == 0 else quals[::-1]\n    return orient, d1, left, right, seq, ql, nmm, v1\n\n\n# ----------------------------- pileup -----------------------------\ndef stream_fastq(path):\n    with gzip.open(path, \"rt\") as f:\n        while True:\n            h = f.readline()\n            if not h:\n                break\n            s = f.readline().rstrip(\"'\"\\\\n\\\")\n            f.readline()\n            q = f.readline().rstrip(\\\"\\\\n\\\")\n            yield h[1:].strip(), s, q\n\n\ndef run_pass(path, genome, index, tx, cds_starts, cds_ends, cds_pos_map,\n             glen, collect=None):\n    \\\"\\\"\\\"Map reads and pile up Q>=20 bases over CDS positions.\n    If collect is a dict {genome_pos: {...}}, gather read-level evidence\n    there instead of (as well as) counting.\\\"\\\"\\\"\n    n_cds = len(cds_pos_map)\n    flat = np.zeros(n_cds * 8, dtype=np.int32)\n    stats = Counter()\n    t0 = time.time()\n    for n, (name, s, q) in enumerate(stream_fastq(path), 1):\n        if n % 100000 == 0:\n            log(\\\"  pass read %d (%.1f/s)\\\" % (n, n / (time.time() - t0 + 1e-9)))\n        codes = CODE[np.frombuffer(s.encode(), dtype=np.uint8)]\n        quals = np.frombuffer(q.encode(), dtype=np.uint8) - 33\n        stats[\\\"total\\\"] += 1\n        pl = place_read(codes, quals, genome, index, glen)\n        if pl is None:\n            stats[\\\"unmapped\\\"] += 1\n            continue\n        orient, d1, left, right, seq, ql, nmm, vote = pl\n        stats[\\\"mapped\\\"] += 1\n        p = np.arange(d1 + left, d1 + right, dtype=np.int64)   # 1-based\n        b = seq[left:right].astype(np.int64)\n        qq = ql[left:right]\n        keep = (qq >= BASE_Q) & (b < 4)\n        p = p[keep]\n        b = b[keep]\n        if collect is not None and len(collect):\n            for cp in collect:\n                hit = np.where(p == cp)[0]\n                for hidx in hit:\n                    ev = collect[cp]\n                    ev[\\\"reads\\\"].append({\n                        \\\"read\\\": name,\n                        \\\"strand\\\": \\\"-\\\" if orient else \\\"+\\\",\n                        \\\"base\\\": BASES[b[hidx]],\n                        \\\"bq\\\": int(qq[hidx]),\n                        \\\"mismatches\\\": int(nmm),\n                        \\\"votes\\\": int(vote),\n                    })\n        if len(p) == 0:\n            continue\n        idx = np.searchsorted(cds_starts, p, side=\\\"right\\\") - 1\n        valid = (idx >= 0) & (p <= cds_ends[idx])\n        if not valid.any():\n            continue\n        idx = idx[valid]\n        lin = idx * 8 + b[valid] * 2 + orient\n        np.add.at(flat, lin, 1)\n    stats[\\\"wall_s\\\"] = round(time.time() - t0, 1)\n    return flat, stats\n\n\ndef call_variants(flat, genome, cds_pos_map, cds_starts):\n    cm = flat.reshape(-1, 8)\n    n = cm.shape[0]\n    depth = cm.sum(axis=1)\n    ref_code = genome[cds_pos_map - 1]\n    base_ct = cm[:, 0::2] + cm[:, 1::2]                    # n x 4, both strands\n    alt_ct = base_ct.copy()\n    alt_ct[np.arange(n), ref_code] = 0\n    best_alt = alt_ct.argmax(axis=1)\n    best_ct = alt_ct[np.arange(n), best_alt]\n    af = np.where(depth > 0, best_ct / np.maximum(depth, 1), 0.0)\n    mask = (depth >= MIN_DEPTH) & (best_ct >= MIN_ALT) & \\\\\n           (af >= MIN_AF) & (af <= MAX_AF)\n    cands = []\n    for i in np.where(mask)[0]:\n        pos = int(cds_pos_map[i])\n        rc = int(ref_code[i])\n        ac = int(best_alt[i])\n        cands.append({\n            \\\"chrom\\\": CHROM,\n            \\\"pos\\\": pos,\n            \\\"ref\\\": BASES[rc],\n            \\\"alt\\\": BASES[ac],\n            \\\"alt_reads\\\": int(best_ct[i]),\n            \\\"ref_reads\\\": int(depth[i] - best_ct[i]),\n            \\\"total_reads\\\": int(depth[i]),\n            \\\"allele_fraction\\\": round(int(best_ct[i]) / int(depth[i]), 4),\n            \\\"alt_fwd\\\": int(cm[i, ac * 2]),\n            \\\"alt_rev\\\": int(cm[i, ac * 2 + 1]),\n            \\\"depth_fwd\\\": int(cm[i, 0::2].sum()),\n            \\\"depth_rev\\\": int(cm[i, 1::2].sum()),\n        })\n    cands.sort(key=lambda c: -c[\\\"alt_reads\\\"])\n    log(\\\"variant candidates (CDS, depth>=%d, alt>=%d): %d\\\" %\n        (MIN_DEPTH, MIN_ALT, len(cands)))\n    return cands\n\n\n# ----------------------------- annotation -----------------------------\ndef build_tx_models(tx, genome):\n    models = {}\n    for tid, t in tx.items():\n        strand = t[\\\"strand\\\"]\n        cds = t[\\\"cds\\\"] if strand == \\\"+\\\" else list(reversed(t[\\\"cds\\\"]))\n        seq = []\n        bounds = []           # cumulative cds coordinates per segment\n        cum = 0\n        for s, e in cds:\n            seg = genome[s - 1:e]\n            if strand == \\\"-\\\":\n                seg = (3 - seg)[::-1]\n            seq.append(bytes(CHAR_OF[seg]))\n            bounds.append((cum, cum + (e - s + 1), s, e))\n            cum += e - s + 1\n        models[tid] = {\n            \\\"gene_id\\\": t[\\\"gene_id\\\"],\n            \\\"gene_name\\\": t[\\\"gene_name\\\"],\n            \\\"strand\\\": strand,\n            \\\"mane\\\": t[\\\"mane\\\"],\n            \\\"seq\\\": b\\\"\\\".join(seq),\n            \\\"bounds\\\": bounds,\n            \\\"cds\\\": t[\\\"cds\\\"],\n        }\n    return models\n\n\ndef cds_offset(models, tid, pos):\n    \\\"\\\"\\\"0-based CDS coordinate of genomic pos in transcript, or None.\\\"\\\"\\\"\n    m = models[tid]\n    for cum0, cum1, s, e in m[\\\"bounds\\\"]:\n        if s <= pos <= e:\n            if m[\\\"strand\\\"] == \\\"+\\\":\n                return cum0 + (pos - s)\n            else:\n                return cum0 + (e - pos)\n    return None\n\n\ndef annotate_candidate(c, models, tx_cds_index):\n    \\\"\\\"\\\"tx_cds_index: sorted list (start, end, tid). Returns list of\n    consequences across transcripts covering the position.\\\"\\\"\\\"\n    pos = c[\\\"pos\\\"]\n    lo = np.searchsorted([x[0] for x in tx_cds_index], pos, side=\\\"right\\\") - 1\n    out = []\n    for k in range(max(0, lo - 2), min(len(tx_cds_index), lo + 400)):\n        pass\n    #