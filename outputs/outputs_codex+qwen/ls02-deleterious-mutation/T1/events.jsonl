{"type":"item.started","item":{"id":"item_134","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$script = @'\"'\n#\"'!/usr/bin/env python3\nimport subprocess, re\n\nWS = '\"'.'\nTARGETS = [(127661125, 'G', 'T'), (114196007, 'C', 'T')]\n\nCIGAR_RE = re.compile(r'(\\\\d+)([MIDNSHP=X])')\n\ndef base_at(read_start, cigar, qseq, qual, pos):\n    \\\"\\\"\\\"Return (base, baseQ, read_offset) at reference pos (1-based), or None.\\\"\\\"\\\"\n    rpos = read_start\n    qoff = 0\n    for length, op in CIGAR_RE.findall(cigar):\n        length = int(length)\n        if op in 'M=X':\n            if rpos <= pos < rpos + length:\n                i = qoff + (pos - rpos)\n                return qseq[i], ord(qual[i]) - 33, i\n            rpos += length\n            qoff += length\n        elif op == 'I':\n            qoff += length\n        elif op == 'D':\n            rpos += length\n        elif op in 'NSH':\n            if op in 'NS':\n                rpos += length if op == 'N' else 0\n                qoff += length if op == 'S' else 0\n            # H: neither\n        elif op == 'P':\n            pass\n        if rpos > pos and op in 'M=XD':\n            break\n    return None\n\nfor pos, ref, alt in TARGETS:\n    print(f'\\\\n===== chr9:{pos} {ref}>{alt} =====')\n    out = subprocess.run(\n        ['samtools', 'view', 'work/aln.nodup.bam', f'chr9:{pos}-{pos}'],\n        capture_output=True, text=True).stdout\n    alt_reads, ref_reads = [], []\n    for line in out.strip().split('\\\\n'):\n        f = line.split('\\\\t')\n        qname, flag, rstart, cigar, mapq, qseq, qual = f[0], int(f[1]), int(f[3]), f[5], int(f[4]), f[9], f[10]\n        res = base_at(rstart, cigar, qseq, qual, pos)\n        if res is None:\n            continue\n        b, bq, roff = res\n        if rstart <= pos <= rstart + len(qseq):\n            dist_end = min(roff, len(qseq) - 1 - roff)\n        else:\n            dist_end = -1\n        info = (qname, flag & 16 \"'!= 0, mapq, b, bq, roff, dist_end, rstart)\n        if b.upper() == alt:\n            alt_reads.append(info)\n        elif b.upper() == ref:\n            ref_reads.append(info)\n    print(f'\"'ALT reads ({len(alt_reads)}):')\n    for qname, rev, mq, b, bq, roff, de, rs in alt_reads:\n        print(f'  {qname} strand={\\\"-\\\" if rev else \\\"+\\\"} mapq={mq} base={b} baseQ={bq} read_pos={roff} dist_to_end={de} align_start={rs}')\n    print(f'REF reads: {len(ref_reads)}')\n    import collections\n    print('  ref baseQ dist:', collections.Counter(min(bq, 41) for *_, bq, *_ in []) if False else '', end='')\n    bqs = [x[4] for x in ref_reads]\n    if bqs:\n        print(f'  ref baseQ min={min(bqs)} max={max(bqs)}')\n'@\n[System.IO.File]::WriteAllText(\\\"\"'$PWD'\"\\\\work\\\\readlevel.py\\\", \"'$script, (New-Object System.Text.UTF8Encoding $false)); wsl -d Ubuntu -- bash -c '\"'cd \"'$HOME/ws && export PATH=$HOME/biotools/usr/bin:$PATH && export LD_LIBRARY_PATH=$HOME/biotools/usr/lib/x86_64-linux-gnu && python3 work/readlevel.py'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
