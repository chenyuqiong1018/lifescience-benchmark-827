{"type":"item.started","item":{"id":"item_164","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$script = @'\"'\n#\"'!/usr/bin/env python3\nimport sys\nsys.path.insert(0, '\"'work')\nfrom annotate import load_fasta, load_gtf, GeneIndex, annotate_snv\n\nseqs = load_fasta('work/GRCh38_chr9.fa')\ntxs = load_gtf('inputs/reference/gencode.v47.chr9.annotation.gtf.gz', seqs)\nidx = GeneIndex(txs)\nprint('STXBP1 gene_id:', set(t.gid for t in txs.values() if t.gene_name == 'STXBP1'))\n\nseen = set()\nwith open('work/allsites.tsv') as f:\n    for line in f:\n        chrom, pos, ref, alt, dp, ad = line.rstrip('\\\\n').split('\\\\t')\n        alts = alt.split(',')\n        ads = ad.split(',') if ad else []\n        if len(ads) < 2:\n            continue\n        try:\n            counts = [int(x) for x in ads]\n        except ValueError:\n            continue\n        tot = sum(counts)\n        if tot < 8:\n            continue\n        pos = int(pos)\n        for i, a in enumerate(alts):\n            if a == '<*>':\n                continue\n            ac = counts[i + 1] if i + 1 < len(counts) else 0\n            if ac < 2:\n                continue\n            af = ac / tot\n            if not (0.02 <= af <= 0.98):\n                continue\n            anns = annotate_snv(idx, pos, ref, a)\n            for an in anns:\n                if an['consequence'] == 'stop_gained':\n                    key = (pos, ref, a, an['gene'])\n                    if key in seen:\n                        continue\n                    seen.add(key)\n                    print(f\\\"pos={pos} {ref}>{a} gene={an['gene']} tx={an['transcript']} aa={an['aa']} AF={af:.3f} ({ac}/{tot})\\\")\nprint('total unique stop_gained (ac>=2, AF 0.02-0.98):', len(seen))\n'@\n[System.IO.File]::WriteAllText(\\\"\"'$PWD'\"\\\\work\\\\discover_low.py\\\", \"'$script, (New-Object System.Text.UTF8Encoding $false)); wsl -d Ubuntu -- bash -c '\"'cd \"'$HOME/ws && python3 work/discover_low.py'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
