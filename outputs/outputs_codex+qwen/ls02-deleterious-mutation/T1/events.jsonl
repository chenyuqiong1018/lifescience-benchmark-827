{"type":"item.started","item":{"id":"item_125","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$script = @'\"'\n#\"'!/usr/bin/env python3\nimport sys, collections\nsys.path.insert(0, '\"'work')\nfrom annotate import load_fasta, load_gtf, GeneIndex, annotate_snv\n\nseqs = load_fasta('work/GRCh38_chr9.fa')\ntxs = load_gtf('inputs/reference/gencode.v47.chr9.annotation.gtf.gz', seqs)\nidx = GeneIndex(txs)\n\n# ---- 1) scan allsites.tsv for mosaic-ish sites ----\ncands = {}\nwith open('work/allsites.tsv') as f:\n    for line in f:\n        chrom, pos, ref, alt, dp, ad = line.rstrip('\\\\n').split('\\\\t')\n        if '<*>' in alt and ',' not in alt:\n            continue\n        alts = alt.split(',')\n        ads = ad.split(',') if ad else []\n        if len(ads) < 2:\n            continue\n        try:\n            counts = [int(x) for x in ads]\n        except ValueError:\n            continue\n        tot = sum(counts)\n        if tot < 10:\n            continue\n        pos = int(pos)\n        for i, a in enumerate(alts):\n            if a == '<*>':\n                continue\n            ac = counts[i + 1] if i + 1 < len(counts) else 0\n            if ac < 3:\n                continue\n            af = ac / tot\n            if 0.03 <= af <= 0.97:\n                cands[(pos, ref, a)] = (ac, tot, af)\nprint('candidate alt sites (AF 0.03-0.97, ac>=3, dp>=10):', len(cands))\n\n# ---- 2) also parse called variants from VCF ----\nvcf_cands = {}\nwith open('work/calls.vcf') as f:\n    for line in f:\n        if line.startswith('#'):\n            continue\n        fields = line.rstrip('\\\\n').split('\\\\t')\n        chrom, pos, vid, ref, alt, qual, filt, info, fmt, smp = fields[:10]\n        pos = int(pos)\n        if len(ref) \"'!= 1 or '\"',' in alt:\n            # handle multi-allelic SNVs only\n            pass\n        d = dict(zip(fmt.split(':'), smp.split(':')))\n        ads = [int(x) for x in d.get('AD', '0,0').split(',')]\n        tot = sum(ads)\n        if tot == 0:\n            continue\n        for i, a in enumerate(alt.split(',')):\n            if len(a) \"'!= 1 or len(ref) != 1:\n                continue\n            ac = ads[i + 1] if i + 1 < len(ads) else 0\n            af = ac / tot\n            if 0.03 <= af <= 0.97 and ac >= 3:\n                key = (pos, ref, a)\n                if key not in cands:\n                    cands[key] = (ac, tot, af)\n\nprint('\"'total candidates after VCF merge:', len(cands))\n\n# ---- 3) annotate ----\nresults = []\nfor (pos, ref, alt), (ac, tot, af) in cands.items():\n    anns = annotate_snv(idx, pos, ref, alt)\n    for an in anns:\n        results.append(dict(pos=pos, ref=ref, alt=alt, alt_reads=ac, total=tot, af=af, **an))\n\n# stop-gained summary\nsg = [r for r in results if r['consequence'] == 'stop_gained']\nprint('\\\\nstop_gained annotations:', len(sg))\nfor r in sorted(sg, key=lambda x: x['pos']):\n    print(f\\\"pos={r['pos']} {r['ref']}>{r['alt']} gene={r['gene']} tx={r['transcript']} aa={r['aa']} codon={r['codon']} AF={r['af']:.3f} ({r['alt_reads']}/{r['total']})\\\")\n\n# all consequences distribution\ncc = collections.Counter(r['consequence'] for r in results)\nprint('\\\\nconsequence distribution:', dict(cc))\n\n# genes with stop_gained\ngenes = collections.Counter(r['gene'] for r in sg)\nprint('\\\\ngenes with stop_gained:', dict(genes))\n'@\n[System.IO.File]::WriteAllText(\\\"\"'$PWD'\"\\\\work\\\\discover.py\\\", \"'$script, (New-Object System.Text.UTF8Encoding $false)); wsl -d Ubuntu -- bash -c '\"'cd \"'$HOME/ws && python3 work/discover.py'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
