{"type":"item.started","item":{"id":"item_150","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$script = @'\"'\n#\"'!/usr/bin/env python3\nfrom math import comb, log10\n\nn, k = 47, 6\n\ndef binom_cdf_le(n, k, p):\n    return sum(comb(n, i) * p**i * (1 - p)**(n - i) for i in range(0, k + 1))\n\ndef binom_cdf_ge(n, k, p):\n    return sum(comb(n, i) * p**i * (1 - p)**(n - i) for i in range(k, n + 1))\n\n# mosaic vs germline het: probability of seeing <= 6 ALT of 47 if true AF = 0.5\np_het = binom_cdf_le(n, k, 0.5)\n# vs sequencing error: probability of seeing >= 6 ALT of 47 if error rate = 0.01\np_err = binom_cdf_ge(n, k, 0.01)\n# vs error 0.005\np_err2 = binom_cdf_ge(n, k, 0.005)\nprint(f'\"'AF = {k}/{n} = {k / n:.4f}')\nprint(f'P(X<={k} | AF=0.5, n={n}) = {p_het:.3e}  (rejects germline het)')\nprint(f'P(X>={k} | err=0.01, n={n}) = {p_err:.3e}  (rejects pure error)')\nprint(f'P(X>={k} | err=0.005, n={n}) = {p_err2:.3e}')\n# two-sided-ish: also P(X>=k | AF=0.5) for completeness\nprint(f'P(X>={k} | AF=0.5) = {binom_cdf_ge(n, k, 0.5):.4f}')\n'@\n[System.IO.File]::WriteAllText(\\\"\"'$PWD'\"\\\\work\\\\stats.py\\\", \"'$script, (New-Object System.Text.UTF8Encoding $false)); wsl -d Ubuntu -- bash -c '\"'cd \"'$HOME/ws && python3 work/stats.py'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
