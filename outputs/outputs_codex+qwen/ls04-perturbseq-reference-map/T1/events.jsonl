{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"New-Item -ItemType Directory -Force -Path output | Out-Null; @'\n\\\"\\\"\\\"Map anonymized query perturbation groups onto the labeled reference.\n\nPrimary method (single production run)\n--------------------------------------\n1. Load ref (labeled: guide + target_gene) and query (guide ids only, anonymized).\n2. Leakage guards:\n   - query metadata is asserted to contain no target-gene information (only 'guide');\n   - guide-name strings are never parsed to infer gene identity; the only label\n     semantics used is the explicit 'NT' non-targeting control designation, which is\n     part of the query's own experimental design;\n   - matching is done exclusively on expression perturbation signatures, never on\n     guide-name overlap between datasets.\n3. Each dataset is normalized independently (library size 1e4 CPM + log1p), so no\n   cross-dataset baseline information is shared.\n4. Perturbation signature per guide = mean(log-norm expr of guide cells) minus the\n   within-dataset NT-control mean. Differencing against each dataset's own control\n   removes the cell-type/baseline shift between reference and query.\n5. Reference signatures are aggregated to target_gene (via the target_gene column,\n   never via name parsing).\n6. Score(query guide, target gene) = Pearson correlation of the two signatures over\n   shared genes.\n7. One-to-one assignment by Hungarian matching (max total correlation).\n8. Output: output/guide_mapping.csv with one row per reference target_gene.\n\nLightweight independent validation\n----------------------------------\n- Subsample stability: recompute all signatures on a random 50% of each guide's\n  cells (fixed seed) and rerun the assignment; report fraction of stable rows.\n- NT sanity: NT control groups must match each other by signature (not by name).\n\\\"\\\"\\\"\nimport json\nimport warnings\n\nimport anndata as ad\nimport numpy as np\nimport pandas as pd\nimport scipy.sparse as sp\nfrom scipy.optimize import linear_sum_assignment\nfrom scipy.stats import pearsonr\n\nwarnings.filterwarnings(\\\"ignore\\\")\nRNG_SEED = 0\n\nREF_PATH = \\\"inputs/perturb.seq.align.q1.ref.h5ad\\\"\nQRY_PATH = \\\"inputs/perturb.seq.align.q1.query.h5ad\\\"\n\n\ndef load(path):\n    a = ad.read_h5ad(path)\n    a.var_names_make_unique()\n    return a\n\n\ndef normalize(a):\n    \\\"\\\"\\\"Independent per-dataset CPM(1e4) + log1p normalization.\\\"\\\"\\\"\n    X = a.X\n    X = X.toarray() if sp.issparse(X) else np.asarray(X)\n    X = X.astype(np.float32)\n    lib = X.sum(axis=1, keepdims=True)\n    lib[lib == 0] = 1.0\n    X = np.log1p(X / lib * 1e4)\n    return X\n\n\ndef group_means(X, labels):\n    \\\"\\\"\\\"Return DataFrame of per-group mean expression (vectorized via reduceat).\\\"\\\"\\\"\n    labels = np.asarray(labels)\n    order = np.argsort(labels, kind=\\\"stable\\\")\n    labs = labels[order]\n    uniq, start = np.unique(labs, return_index=True)\n    Xs = X[order]\n    sums = np.add.reduceat(Xs, start, axis=0)\n    counts = np.diff(np.append(start, len(labs)))\n    return pd.DataFrame(sums / counts[:, None], index=uniq, columns=None)\n\n\ndef signatures(gm, ctrl_mean):\n    return gm.subtract(ctrl_mean, axis=1)\n\n\ndef pearson_matrix(A, B):\n    \\\"\\\"\\\"Pearson correlation between each row of A and each row of B (genes=cols).\\\"\\\"\\\"\n    A = A - A.mean(axis=1, keepdims=True)\n    B = B - B.mean(axis=1, keepdims=True)\n    An = A / np.linalg.norm(A, axis=1, keepdims=True)\n    Bn = B / np.linalg.norm(B, axis=1, keepdims=True)\n    return An @ Bn.T\n\n\ndef build(ref, qry, frac=1.0, seed=RNG_SEED):\n    \\\"\\\"\\\"Build correlation matrix (target_genes x query guides).\\\"\\\"\\\"\n    Xr = normalize(ref)\n    Xq = normalize(qry)\n    shared = sorted(set(ref.var_names) & set(qry.var_names))\n    ri = ref.var_names.get_indexer(shared)\n    qi = qry.var_names.get_indexer(shared)\n    Xr, Xq = Xr[:, ri], Xq[:, qi]\n\n    if frac < 1.0:\n        rng = np.random.default_rng(seed)\n        for X, obs in ((Xr, ref.obs), (Xq, qry.obs)):\n            pass  # subsampling handled below per group via masks\n\n    obsr, obsq = ref.obs, qry.obs\n    is_ctrl_r = (obsr[\\\"target_gene\\\"].astype(str) == \\\"NT\\\").values\n    is_ctrl_q = obsq[\\\"guide\\\"].astype(str).str.startswith(\\\"NT\\\").values\n\n    if frac < 1.0:\n        rng = np.random.default_rng(seed)\n        keep_r = np.zeros(ref.n_obs, bool)\n        keep_q = np.zeros(qry.n_obs, bool)\n        for lab, keep, n in ((obsr[\\\"guide\\\"].values, keep_r, ref.n_obs),\n                             (obsq[\\\"guide\\\"].values, keep_q, qry.n_obs)):\n            for g in np.unique(lab):\n                idx = np.where(lab == g)[0]\n                take = rng.choice(idx, size=max(1, int(len(idx) * frac)), replace=False)\n                keep[take] = True\n        Xr, Xq = Xr[keep_r], Xq[keep_q]\n        obsr = obsr.loc[keep_r]\n        obsq = obsq.loc[keep_q]\n        is_ctrl_r = (obsr[\\\"target_gene\\\"].astype(str) == \\\"NT\\\").values\n        is_ctrl_q = obsq[\\\"guide\\\"].astype(str).str.startswith(\\\"NT\\\").values\n\n    gm_r = group_means(Xr, obsr[\\\"guide\\\"].astype(str).values)\n    gm_q = group_means(Xq, obsq[\\\"guide\\\"].astype(str).values)\n    ctrl_r = Xr[is_ctrl_r].mean(axis=0)\n    ctrl_q = Xq[is_ctrl_q].mean(axis=0)\n    sig_r = signatures(gm_r, ctrl_r)          # per ref guide\n    sig_q = signatures(gm_q, ctrl_q)          # per query guide\n\n    # aggregate reference guide signatures to target_gene via the label column\n    gene_of = obsr.set_index(\\\"guide\\\")[\\\"target_gene\\\"].astype(str)\n    sig_r.index = gene_of.loc[sig_r.index].values\n    gene_sig = sig_r.groupby(level=0).mean()\n\n    C = pd.DataFrame(\n        pearson_matrix(gene_sig.values, sig_q.values),\n        index=gene_sig.index, columns=sig_q.index)\n    extras = {\n        \\\"n_shared_genes\\\": len(shared),\n        \\\"ctrl_profile_corr\\\": float(pearsonr(ctrl_r, ctrl_q)[0]),\n        \\\"gene_sig\\\": gene_sig, \\\"sig_q\\\": sig_q,\n    }\n    return C, extras\n\n\ndef assign(C):\n    \\\"\\\"\\\"Hungarian one-to-one assignment maximizing total correlation.\\\"\\\"\\\"\n    cost = -C.values\n    gi, qj = linear_sum_assignment(cost)\n    rows = []\n    order = np.argsort(gi)\n    gi, qj = gi[order], qj[order]\n    for i, j in zip(gi, qj):\n        gene = C.index[i]\n        qg = C.columns[j]\n        score = float(C.values[i, j])\n        others = np.delete(C.values[i], j)\n        runner_up = float(others.max())\n        w = C.values[i] - C.values[i].max()\n        prob = float(np.exp(w).sum() and np.exp(w)[j] / np.exp(w).sum())\n        rows.append({\\\"target_gene\\\": gene, \\\"query_guide_id\\\": qg, \\\"score\\\": score,\n                     \\\"runner_up_score\\\": runner_up, \\\"confidence\\\": prob,\n                     \\\"margin\\\": score - runner_up})\n    return pd.DataFrame(rows)\n\n\ndef main():\n    ref, qry = load(REF_PATH), load(QRY_PATH)\n\n    # ---- Leakage guards -------------------------------------------------\n    assert list(qry.obs.columns) == [\\\"guide\\\"], \\\"query carries unexpected metadata\\\"\n    assert not any(\\\"target\\\" in c.lower() or \\\"gene\\\" in c.lower() for c in qry.obs.columns)\n    # guide-name strings must not be used as features; only explicit NT designation.\n\n    C, extras = build(ref, qry, frac=1.0)\n    res = assign(C)\n    res_out = res[[\\\"target_gene\\\", \\\"query_guide_id\\\", \\\"score\\\",\n                   \\\"runner_up_score\\\", \\\"confidence\\\"]].copy()\n    res_out = res_out.sort_values(\\\"target_gene\\\").reset_index(drop=True)\n    res_out.to_csv(\\\"output/guide_mapping.csv\\\", index=False)\n\n    # ---- lightweight independent validation ----------------------------\n    C_sub, _ = build(ref, qry, frac=0.5, seed=RNG_SEED)\n    res_sub = assign(C_sub).set_index(\\\"target_gene\\\")\n    stable = (res_sub.loc[res[\\\"target_gene\\\"], \\\"query_guide_id\\\"].values\n              == res[\\\"query_guide_id\\\"].values).mean()\n\n    # NT sanity: every NT query guide should score NT as its best reference group\n    nt_cols = [c for c in C.columns if c.startswith(\\\"NT\\\")]\n    nt_best = (C.loc[\\\"NT\\\", nt_cols] == C[nt_cols].max(axis=0)).mean()\n    # and the NT row must be assigned an NT guide\n    nt_assigned = res.loc[res.target_gene == \\\"NT\\\", \\\"query_guide_id\\\"].str.startswith(\\\"NT\\\").all()\n\n    # supplementary per-query-guide view (explanatory, not required artifact)\n    qmap = []\n    for g in C.columns:\n        i = int(C[g].idxmax() and C.index.get_loc(C[g].idxmax()))\n        top2 = C[g].sort_values(ascending=False).head(2)\n        qmap.append({\\\"query_guide_id\\\": g,\n                     \\\"best_target_gene\\\": top2.index[0],\n                     \\\"score\\\": float(top2.iloc[0]),\n                     \\\"runner_up_target_gene\\\": top2.index[1],\n                     \\\"runner_up_score\\\": float(top2.iloc[1])})\n    pd.DataFrame(qmap).to_csv(\\\"output/supplementary_query_guide_mapping.csv\\\", index=False)\n\n    summary = {\n        \\\"n_ref_cells\\\": int(ref.n_obs), \\\"n_qry_cells\\\": int(qry.n_obs),\n        \\\"n_shared_genes\\\": extras[\\\"n_shared_genes\\\"],\n        \\\"ctrl_profile_corr\\\": extras[\\\"ctrl_profile_corr\\\"],\n        \\\"n_rows_written\\\": int(len(res_out)),\n        \\\"subsample_stability\\\": float(stable),\n        \\\"nt_query_guides_best_hit_NT_frac\\\": float(nt_best),\n        \\\"nt_row_assigned_nt_guide\\\": bool(nt_assigned),\n        \\\"targets\\\": {},\n    }\n    for g in [\\\"PABPC1\\\", \\\"NUDT21\\\", \\\"LEO1\\\"]:\n        r = res[res.target_gene == g].iloc[0]\n        summary[\\\"targets\\\"][g] = {k: r[k] for k in\n                                 [\\\"query_guide_id\\\", \\\"score\\\", \\\"runner_up_score\\\",\n                                  \\\"confidence\\\", \\\"margin\\\"]}\n    with open(\\\"output/run_summary.json\\\", \\\"w\\\") as f:\n        json.dump(summary, f, indent=2)\n    print(json.dumps(summary, indent=2))\n    print(\\\"\\\\nFull mapping:\\\")\n    print(res.sort_values(\\\"target_gene\\\").to_string(index=False))\n\n\nif __name__ == \\\"__main__\\\":\n    main()\n'@ | Set-Content -Encoding utf8 output/analysis.py; python output/analysis.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
