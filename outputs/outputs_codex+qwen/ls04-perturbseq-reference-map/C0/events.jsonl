{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport warnings; warnings.filterwarnings(\\\"ignore\\\")\nimport numpy as np, pandas as pd, json, anndata as ad\nfrom scipy.optimize import nnls\n\nq = ad.read_h5ad(\\\"inputs/perturb.seq.align.q1.query.h5ad\\\")\nr = ad.read_h5ad(\\\"inputs/perturb.seq.align.q1.ref.h5ad\\\")\ncommon = q.var_names.intersection(r.var_names); q, r = q[:,common].copy(), r[:,common].copy()\ndef log1p_cpm(X):\n    X = np.asarray(X.toarray() if hasattr(X,\\\"toarray\\\") else X, dtype=np.float32)\n    s = X.sum(1); s[s==0]=1\n    return np.log1p(X*(1e4/s[:,None]))\nqX, rX = log1p_cpm(q.X), log1p_cpm(r.X)\nql = q.obs[\\\"guide\\\"].astype(str).values; rl = r.obs[\\\"guide\\\"].astype(str).values\ntg = r.obs[\\\"target_gene\\\"].astype(str).values\nqnt = qX[[s.startswith(\\\"NT\\\") for s in ql]].mean(0)\nrnt = rX[[s.startswith(\\\"NT\\\") for s in rl]].mean(0)\nrs_g = {g: rX[rl==g].mean(0)-rnt for g in pd.unique(rl) if not g.startswith(\\\"NT\\\")}\ngog = dict(zip(rl, tg))\ngenes = sorted(set(tg)-{\\\"NT\\\"})\nrs = {t: np.mean([rs_g[g] for g in rs_g if gog[g]==t],0) for t in genes}\nqs = {g: qX[ql==g].mean(0)-qnt for g in pd.unique(ql) if not g.startswith(\\\"NT\\\")}\n\nS = np.vstack([rs[t] for t in genes])\nN = np.vstack([rX[(rl==g)].mean(0)-rnt for g in pd.unique(rl) if g.startswith(\\\"NT\\\")])\nf = S.var(0)/(N.var(0)+1e-8)\nfi = np.argsort(f)[::-1][:1500]\nR = np.vstack([rs[t][fi] for t in genes]).T  # genes x features -> features x genes\n\nfor gname in (\\\"guide14\\\",\\\"guide28\\\",\\\"guide23\\\",\\\"guide1\\\",\\\"guide10\\\"):\n    w, res = nnls(R, qs[gname][fi])\n    o = np.argsort(w)[::-1][:6]\n    tot = w.sum()\n    top = \\\", \\\".join(f\\\"{genes[j]}={w[j]/tot:.2f}\\\" for j in o if w[j]>0)\n    print(f\\\"{gname}: NNLS weights -> {top}\\\")\n\n# guide1 full correlation vector top 12\ndef pearson(A,B):\n    A=A-A.mean(1,keepdims=True); B=B-B.mean(1,keepdims=True)\n    return (A/np.linalg.norm(A,axis=1,keepdims=True))@(B/np.linalg.norm(B,axis=1,keepdims=True)).T\nQ1 = qs[\\\"guide1\\\"][fi][None,:]\nC1 = pearson(Q1, np.vstack([rs[t][fi] for t in genes]))[0]\no = np.argsort(C1)[::-1][:12]\nprint(\\\"guide1 top12:\\\", \\\", \\\".join(f\\\"{genes[j]}={C1[j]:.3f}\\\" for j in o))\n# which guides have significant best-hit under quick null (shuffle 100x)\nrng = np.random.default_rng(0)\nQ = np.vstack([qs[g][fi] for g in sorted(qs, key=lambda g:int(g.replace(\\\"guide\\\",\\\"\\\")))])\nqo = sorted(qs, key=lambda g:int(g.replace(\\\"guide\\\",\\\"\\\")))\nRm = np.vstack([rs[t][fi] for t in genes])\nC = pearson(Q, Rm)\nnull95 = []\nfor b in range(100):\n    qp = Q[:, rng.permutation(1500)]\n    null95.append(np.percentile(pearson(qp, Rm).max(1), 95))\nthr = float(np.mean(null95))\nprint(f\\\"\\\\nnull 95th-pct max-r threshold ~ {thr:.3f}\\\")\nfor i,g in enumerate(qo):\n    if C[i].max() < thr:\n        print(f\\\"  UNMAPPED (weak): {g} n={int((ql==g).sum())} max_r={C[i].max():.3f}\\\")\n'@ | Set-Content -Encoding utf8 scratch_unmix.py; python scratch_unmix.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
