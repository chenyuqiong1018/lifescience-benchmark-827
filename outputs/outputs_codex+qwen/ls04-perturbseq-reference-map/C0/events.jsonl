{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '@\"\nimport anndata as ad, warnings, numpy as np, scanpy as sc\nwarnings.filterwarnings(\"ignore\")\n\nq = ad.read_h5ad(\"inputs/perturb.seq.align.q1.query.h5ad\")\nr = ad.read_h5ad(\"inputs/perturb.seq.align.q1.ref.h5ad\")\ncommon = q.var_names.intersection(r.var_names)\nprint(\"n common genes:\", len(common), \"of\", q.n_vars, r.n_vars)\nq = q[:, common].copy(); r = r[:, common].copy()\nq.obs[\"dataset\"] = \"query\"; r.obs[\"dataset\"] = \"ref\"\na = ad.concat([q, r], join=\"inner\")\nsc.pp.normalize_total(a, target_sum=1e4)\nsc.pp.log1p(a)\nsc.pp.highly_variable_genes(a, n_top_genes=2000, flavor=\"seurat_v3\" if False else \"seurat\")\nsc.pp.scale(a, max_value=10)\nsc.tl.pca(a, n_comps=30)\nimport pandas as pd\npcs = a.obsm[\"X_pca\"]\nds = a.obs[\"dataset\"].values\n# separation between datasets on PCs\nfrom numpy import mean\nfor i in range(5):\n    mq = pcs[ds==\"query\", i].mean(); mr = pcs[ds==\"ref\", i].mean()\n    sq = pcs[ds==\"query\", i].std(); sr = pcs[ds==\"ref\", i].std()\n    print(f\"PC{i+1}: query mean {mq:.2f} +/- {sq:.2f} | ref mean {mr:.2f} +/- {sr:.2f} | sep {(mq-mr)/np.sqrt((sq**2+sr**2)/2):.2f}\")\n# within query: is there multi-celltype structure? NT vs guides on PC1/PC2\ng = a.obs[\"guide\"].astype(str)\nnt = g.str.startswith(\"NT\")\nprint(\"query PC1 NT mean\", pcs[(ds==\"query\")&nt.values,0].mean(), \"guide mean\", pcs[(ds==\"query\")&(~nt.values),0].mean())\nprint(\"ref  PC1 NT mean\", pcs[(ds==\"ref\")&nt.values,0].mean(), \"guide mean\", pcs[(ds==\"ref\")&(~nt.values),0].mean())\n# UMAP for eyeball\nsc.pp.neighbors(a); sc.tl.umap(a)\num = a.obsm[\"X_umap\"]\nprint(\"UMAP query centroid\", um[ds==\"query\"].mean(0), \"ref centroid\", um[ds==\"ref\"].mean(0))\n# variance explained by dataset vs guide (simple: mean inter vs intra)\nfrom collections import Counter\nprint(\"guide counts per dataset:\", Counter(ds))\n\"@ | Set-Content -Encoding utf8 scratch_shift.py; python scratch_shift.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
