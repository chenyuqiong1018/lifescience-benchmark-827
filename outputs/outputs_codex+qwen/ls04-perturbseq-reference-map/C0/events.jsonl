{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport warnings; warnings.filterwarnings(\\\"ignore\\\")\nimport numpy as np, pandas as pd, anndata as ad\nfrom scipy.optimize import nnls\n\nq = ad.read_h5ad(\\\"inputs/perturb.seq.align.q1.query.h5ad\\\")\nr = ad.read_h5ad(\\\"inputs/perturb.seq.align.q1.ref.h5ad\\\")\ncommon = q.var_names.intersection(r.var_names); q, r = q[:,common].copy(), r[:,common].copy()\ndef log1p_cpm(X):\n    X = np.asarray(X.toarray() if hasattr(X,\\\"toarray\\\") else X, dtype=np.float32)\n    s = X.sum(1); s[s==0]=1\n    return np.log1p(X*(1e4/s[:,None]))\nqX, rX = log1p_cpm(q.X), log1p_cpm(r.X)\nql = q.obs[\\\"guide\\\"].astype(str).values; rl = r.obs[\\\"guide\\\"].astype(str).values\ntg = r.obs[\\\"target_gene\\\"].astype(str).values\nqnt = qX[[s.startswith(\\\"NT\\\") for s in ql]].mean(0)\nrnt = rX[[s.startswith(\\\"NT\\\") for s in rl]].mean(0)\nrs_g = {g: rX[rl==g].mean(0)-rnt for g in pd.unique(rl) if not g.startswith(\\\"NT\\\")}\ngog = dict(zip(rl, tg))\ngenes = sorted(set(tg)-{\\\"NT\\\"})\nrs = {t: np.mean([rs_g[g] for g in rs_g if gog[g]==t],0) for t in genes}\nqs = {g: qX[ql==g].mean(0)-qnt for g in pd.unique(ql) if not g.startswith(\\\"NT\\\")}\nqo = sorted(qs, key=lambda g:int(g.replace(\\\"guide\\\",\\\"\\\")))\nS = np.vstack([rs[t] for t in genes])\nN = np.vstack([rX[(rl==g)].mean(0)-rnt for g in pd.unique(rl) if g.startswith(\\\"NT\\\")])\nf = S.var(0)/(N.var(0)+1e-8)\nfi = np.argsort(f)[::-1][:1500]\nRm = np.vstack([rs[t][fi] for t in genes])\ndef pearson(A,B):\n    A=A-A.mean(1,keepdims=True); B=B-B.mean(1,keepdims=True)\n    return (A/np.linalg.norm(A,axis=1,keepdims=True))@(B/np.linalg.norm(B,axis=1,keepdims=True)).T\nM = pearson(Rm, Rm)\n# connected components at r>=0.85\nadj = {t:set() for t in genes}\nfor i in range(len(genes)):\n    for j in range(i+1, len(genes)):\n        if M[i,j] >= 0.85:\n            adj[genes[i]].add(genes[j]); adj[genes[j]].add(genes[i])\nseen=set(); comps=[]\nfor t in genes:\n    if t in seen: continue\n    stack=[t]; comp=set(); seen.add(t)\n    while stack:\n        x=stack.pop(); comp.add(x)\n        for y in adj[x]:\n            if y not in seen: seen.add(y); stack.append(y)\n    comps.append(sorted(comp))\nprint(\\\"clusters at r>=0.85:\\\")\nfor c in comps:\n    if len(c)>1: print(\\\"  \\\", c)\n# first-shell neighbors (r>=0.65 to any member) for multi-gene clusters\nfor c in comps:\n    if len(c)<2: continue\n    neigh = set()\n    for t in genes:\n        if t in c: continue\n        if any(M[genes.index(t), genes.index(m)]>=0.65 for m in c): neigh.add(t)\n    print(f\\\"  cluster {c} neighbors(0.65): {sorted(neigh)}\\\")\n# cluster-NNLS resolution for guides whose greedy hit is in a multi-gene cluster\nQ = np.vstack([qs[g][fi] for g in qo])\nC = pearson(Q, Rm)\ngreedy = [genes[int(np.argmax(C[i]))] for i in range(len(qo))]\nfor c in comps:\n    if len(c)<2: continue\n    members = sorted(c)\n    idx = [genes.index(t) for t in members]\n    Rc = Rm[idx].T  # features x members\n    for i,g in enumerate(qo):\n        if greedy[i] not in c: continue\n        w,_ = nnls(Rc, qs[g][fi])\n        wn = w/(w.sum()+1e-12)\n        pick = members[int(np.argmax(wn))]\n        tag = \\\"FLIP->\\\"+pick if pick\"'!=greedy[i] else \"keep\"\n        print(f\"{g:9s} greedy={greedy[i]:6s} clusterNNLS={dict(zip(members,np.round(wn,3)))} {tag}\")\n'\"'@ | Set-Content -Encoding utf8 scratch_cluster.py; python scratch_cluster.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
