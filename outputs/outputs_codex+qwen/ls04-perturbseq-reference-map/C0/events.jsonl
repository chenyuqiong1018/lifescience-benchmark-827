{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport warnings; warnings.filterwarnings(\\\"ignore\\\")\nimport anndata as ad, numpy as np, pandas as pd\nfrom scipy.optimize import linear_sum_assignment\n\nq = ad.read_h5ad(\\\"inputs/perturb.seq.align.q1.query.h5ad\\\")\nr = ad.read_h5ad(\\\"inputs/perturb.seq.align.q1.ref.h5ad\\\")\ncommon = q.var_names.intersection(r.var_names)\nq, r = q[:, common].copy(), r[:, common].copy()\n\ndef densify(X):\n    return np.asarray(X.toarray() if hasattr(X, \\\"toarray\\\") else X, dtype=np.float32)\n\ndef log1p_cpm(X):\n    X = densify(X); s = X.sum(1); s[s==0]=1\n    return np.log1p(X * (1e4 / s[:, None]))\n\nqX, rX = log1p_cpm(q.X), log1p_cpm(r.X)\nql = q.obs[\\\"guide\\\"].astype(str).values\nrl = r.obs[\\\"guide\\\"].astype(str).values\ntg = r.obs[\\\"target_gene\\\"].astype(str).values\nisnt = np.array([s.startswith(\\\"NT\\\") for s in ql])\nisnt_r = np.array([s.startswith(\\\"NT\\\") for s in rl])\n\ndef regress_pcs(X, npc):\n    if npc == 0: return X\n    Xc = X - X.mean(0)\n    # randomized SVD via numpy (small enough): use full SVD on centered matrix\n    U, Ssv, Vt = np.linalg.svd(Xc, full_matrices=False)\n    proj = Xc @ Vt[:npc].T @ Vt[:npc]\n    return (Xc - proj) + X.mean(0)\n\ndef build(npc):\n    qx = regress_pcs(qX, npc); rx = regress_pcs(rX, npc)\n    qnt = qx[isnt].mean(0); rnt = rx[isnt_r].mean(0)\n    def sigs(X, lab, base):\n        out, ns = {}, {}\n        for g in pd.unique(lab):\n            if g.startswith(\\\"NT\\\"): continue\n            out[g] = X[lab==g].mean(0) - base; ns[g] = int((lab==g).sum())\n        return out, ns\n    qs, qn = sigs(qx, ql, qnt)\n    rs_g, rn = sigs(rx, rl, rnt)\n    gog = dict(zip(rl, tg))\n    genes = sorted(set(tg)-{\\\"NT\\\"})\n    rs = {t: np.mean([rs_g[g] for g in rs_g if gog[g]==t],0) for t in genes}\n    # F-ratio features: var across ref gene sigs / var across NT-group sigs (ref only)\n    S = np.vstack([rs[t] for t in genes])\n    nt_sigs = []\n    for g in pd.unique(rl[isnt_r]):\n        nt_sigs.append(rx[(rl==g)].mean(0) - rnt)\n    N = np.vstack(nt_sigs)\n    f = S.var(0) / (N.var(0) + 1e-8)\n    return qs, qn, rs, genes, f\n\ndef score(npc, K):\n    qs, qn, rs, genes, f = build(npc)\n    fi = np.argsort(f)[::-1][:K]\n    qo = sorted(qs, key=lambda g: int(g.replace(\\\"guide\\\",\\\"\\\")))\n    Q = np.vstack([qs[g][fi] for g in qo])\n    R = np.vstack([rs[t][fi] for t in genes])\n    def pearson(A,B):\n        A = A - A.mean(1,keepdims=True); B = B - B.mean(1,keepdims=True)\n        return (A/np.linalg.norm(A,axis=1,keepdims=True)) @ (B/np.linalg.norm(B,axis=1,keepdims=True)).T\n    C = pearson(Q,R)\n    best = {qo[i]: genes[int(np.argmax(C[i]))] for i in range(len(qo))}\n    return qo, genes, C, best, qn\n\nfor npc in (0, 10):\n    for K in (1500,):\n        qo, genes, C, best, qn = score(npc, K)\n        from collections import Counter\n        c = Counter(best.values())\n        mult = {g:n for g,n in c.items() if n>1}\n        # guide14 discrimination among PAF complex\n        i14 = qo.index(\\\"guide14\\\")\n        paf = {t: round(float(C[i14, genes.index(t)]),4) for t in [\\\"CTR9\\\",\\\"PAF1\\\",\\\"CDC73\\\",\\\"LEO1\\\"]}\n        i13 = qo.index(\\\"guide13\\\"); i18 = qo.index(\\\"guide18\\\")\n        print(f\\\"npc={npc} K={K}\\\")\n        print(\\\"  guide14 PAF-complex r:\\\", paf)\n        print(\\\"  NUDT21 best for guide13:\\\", best[\\\"guide13\\\"], round(float(C[i13,genes.index('NUDT21')]),3))\n        print(\\\"  PABPC1 best for guide18:\\\", best[\\\"guide18\\\"], round(float(C[i18,genes.index('PABPC1')]),3))\n        print(\\\"  multi-hit genes:\\\", mult)\n        print(\\\"  LEO1 hits:\\\", [g for g,t in best.items() if t==\\\"LEO1\\\"])\n        # Hungarian\n        cost = -C\n        row, col = linear_sum_assignment(cost)\n        hung = {qo[i]: genes[col[i]] for i in range(len(qo))}\n        diff = [(g, best[g], hung[g]) for g in qo if best[g]\"'!=hung[g]]\n        print(\"  hungarian vs greedy diffs:\", len(diff))\n        for g,b,h in diff: print(\"    \", g, b, \"->\", h)\n        print(\"  hungarian PAF:\", {g:t for g,t in hung.items() if t in (\"CTR9\",\"PAF1\",\"CDC73\",\"LEO1\")})\n        print(\"  hungarian PABPC1/NUDT21/LEO1:\", [g for g,t in hung.items() if t==\"PABPC1\"], [g for g,t in hung.items() if t==\"NUDT21\"], [g for g,t in hung.items() if t==\"LEO1\"])\n        print()\n'\"'@ | Set-Content -Encoding utf8 scratch_variant.py; python scratch_variant.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
