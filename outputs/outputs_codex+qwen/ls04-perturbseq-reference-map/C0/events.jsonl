{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport warnings; warnings.filterwarnings(\\\"ignore\\\")\nimport numpy as np, pandas as pd, json\nC = np.load(\\\"scratch_C.npy\\\")\nidx = json.load(open(\\\"scratch_idx.json\\\"))\nqo, genes = idx[\\\"qo\\\"], idx[\\\"genes\\\"]\n\n# load signatures again quickly (reuse code path)\nimport anndata as ad\nq = ad.read_h5ad(\\\"inputs/perturb.seq.align.q1.query.h5ad\\\")\nr = ad.read_h5ad(\\\"inputs/perturb.seq.align.q1.ref.h5ad\\\")\ncommon = q.var_names.intersection(r.var_names); q, r = q[:,common].copy(), r[:,common].copy()\ndef log1p_cpm(X):\n    X = np.asarray(X.toarray() if hasattr(X,\\\"toarray\\\") else X, dtype=np.float32)\n    s = X.sum(1); s[s==0]=1\n    return np.log1p(X*(1e4/s[:,None]))\nqX, rX = log1p_cpm(q.X), log1p_cpm(r.X)\nql = q.obs[\\\"guide\\\"].astype(str).values; rl = r.obs[\\\"guide\\\"].astype(str).values\ntg = r.obs[\\\"target_gene\\\"].astype(str).values\nqnt = qX[[s.startswith(\\\"NT\\\") for s in ql]].mean(0)\nrnt = rX[[s.startswith(\\\"NT\\\") for s in rl]].mean(0)\nrs_g = {g: rX[rl==g].mean(0)-rnt for g in pd.unique(rl) if not g.startswith(\\\"NT\\\")}\ngog = dict(zip(rl, tg))\nrs = {t: np.mean([rs_g[g] for g in rs_g if gog[g]==t],0) for t in sorted(set(tg)-{\\\"NT\\\"})}\nqs = {g: qX[ql==g].mean(0)-qnt for g in pd.unique(ql) if not g.startswith(\\\"NT\\\")}\n\npaf = [\\\"PAF1\\\",\\\"CTR9\\\",\\\"CDC73\\\",\\\"LEO1\\\"]\nP = np.vstack([rs[t] for t in paf])\n# within-complex discriminating features: high var across 4 PAF sigs, low across NT-group sigs\nN = np.vstack([rX[(rl==g)].mean(0)-rnt for g in pd.unique(rl) if g.startswith(\\\"NT\\\")])\nfwin = P.var(0)/(N.var(0)+1e-8)\ndef pearson(A,B):\n    A=A-A.mean(1,keepdims=True); B=B-B.mean(1,keepdims=True)\n    return (A/np.linalg.norm(A,axis=1,keepdims=True))@(B/np.linalg.norm(B,axis=1,keepdims=True)).T\nfor K in (200, 500, 1000):\n    fi = np.argsort(fwin)[::-1][:K]\n    R4 = np.vstack([rs[t][fi] for t in paf])\n    print(f\\\"within-PAF features K={K}:\\\")\n    for gname in (\\\"guide14\\\",\\\"guide28\\\",\\\"guide10\\\",\\\"guide32\\\",\\\"guide23\\\"):\n        Qv = qs[gname][fi][None,:]\n        rr = pearson(Qv, R4)[0]\n        print(\\\"  \\\", gname, {t: round(float(x),3) for t,x in zip(paf, rr)})\n    # mutual correlations among PAF ref sigs on these features\n    M = pearson(R4, R4)\n    print(\\\"   ref PAF mutual r:\\\", np.round(M,2).tolist())\n\n# partial correlation: remove shared PAF component\ncomp = P.mean(0)\ndef resid(v):\n    b = np.polyfit(comp, v, 1)\n    return v - np.polyval(b, comp)\nprint(\\\"\\\\npartial (shared-complex removed), all genes:\\\")\nfi_all = None\nfor gname in (\\\"guide14\\\",\\\"guide28\\\",\\\"guide10\\\"):\n    gv = resid(qs[gname])\n    out = {}\n    for t in paf:\n        tv = resid(rs[t])\n        out[t] = round(float(np.corrcoef(gv, tv)[0,1]),3)\n    print(\\\"  \\\", gname, out)\n'@ | Set-Content -Encoding utf8 scratch_paf.py; python scratch_paf.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
