{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport warnings; warnings.filterwarnings(\\\"ignore\\\")\nimport anndata as ad, numpy as np, pandas as pd\n\nq = ad.read_h5ad(\\\"inputs/perturb.seq.align.q1.query.h5ad\\\")\nr = ad.read_h5ad(\\\"inputs/perturb.seq.align.q1.ref.h5ad\\\")\ncommon = q.var_names.intersection(r.var_names)\nq, r = q[:, common].copy(), r[:, common].copy()\n\ndef densify(X):\n    return np.asarray(X.toarray() if hasattr(X,\\\"toarray\\\") else X, dtype=np.float32)\ndef log1p_cpm(X):\n    X = densify(X); s = X.sum(1); s[s==0]=1\n    return np.log1p(X*(1e4/s[:,None]))\nqX, rX = log1p_cpm(q.X), log1p_cpm(r.X)\nql = q.obs[\\\"guide\\\"].astype(str).values; rl = r.obs[\\\"guide\\\"].astype(str).values\ntg = r.obs[\\\"target_gene\\\"].astype(str).values\nisnt = np.array([s.startswith(\\\"NT\\\") for s in ql]); isnt_r = np.array([s.startswith(\\\"NT\\\") for s in rl])\nqnt = qX[isnt].mean(0); rnt = rX[isnt_r].mean(0)\nqs, qn = {}, {}\nfor g in pd.unique(ql):\n    if g.startswith(\\\"NT\\\"): continue\n    qs[g] = qX[ql==g].mean(0)-qnt; qn[g]=int((ql==g).sum())\nrs_g, rn = {}, {}\nfor g in pd.unique(rl):\n    if g.startswith(\\\"NT\\\"): continue\n    rs_g[g] = rX[rl==g].mean(0)-rnt; rn[g]=int((rl==g).sum())\ngog = dict(zip(rl, tg)); genes = sorted(set(tg)-{\\\"NT\\\"})\nrs = {t: np.mean([rs_g[g] for g in rs_g if gog[g]==t],0) for t in genes}\nS = np.vstack([rs[t] for t in genes])\nN = np.vstack([rX[(rl==g)].mean(0)-rnt for g in pd.unique(rl[isnt_r])])\nf = S.var(0)/(N.var(0)+1e-8)\nK=1500; fi = np.argsort(f)[::-1][:K]\nqo = sorted(qs, key=lambda g:int(g.replace(\\\"guide\\\",\\\"\\\")))\nQ = np.vstack([qs[g][fi] for g in qo]); R = np.vstack([rs[t][fi] for t in genes])\ndef pearson(A,B):\n    A=A-A.mean(1,keepdims=True); B=B-B.mean(1,keepdims=True)\n    return (A/np.linalg.norm(A,axis=1,keepdims=True))@(B/np.linalg.norm(B,axis=1,keepdims=True)).T\nC = pearson(Q,R)\nli = genes.index(\\\"LEO1\\\")\nprint(\\\"LEO1-column correlations across query guides (F features, K=1500):\\\")\norder = np.argsort(C[:,li])[::-1]\nfor i in order[:8]:\n    print(f\\\"  {qo[i]:9s} n={qn[qo[i]]:3d} r={C[i,li]:.4f}\\\")\nprint()\nfor gname in (\\\"guide14\\\",\\\"guide32\\\",\\\"guide28\\\",\\\"guide10\\\",\\\"guide23\\\",\\\"guide1\\\"):\n    i = qo.index(gname)\n    o = np.argsort(C[i])[::-1][:6]\n    top = \\\", \\\".join(f\\\"{genes[j]}={C[i,j]:.3f}\\\" for j in o)\n    print(f\\\"{gname:9s} n={qn[gname]:3d}: {top}\\\")\nprint()\nprint(\\\"per-ref-gene best pull (max over query guides):\\\")\npull = C.max(0)\no = np.argsort(pull)[::-1]\nfor j in o:\n    i = int(np.argmax(C[:,j]))\n    print(f\\\"  {genes[j]:7s} pull={pull[j]:.3f} best_guide={qo[i]} (n={qn[qo[i]]})\\\")\nnp.save(\\\"scratch_C.npy\\\", C)\nimport json; json.dump({\\\"qo\\\":qo,\\\"genes\\\":genes,\\\"qn\\\":qn}, open(\\\"scratch_idx.json\\\",\\\"w\\\"))\n'@ | Set-Content -Encoding utf8 scratch_leo.py; python scratch_leo.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
