{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"\"C:\\\\Users\\\\chenyuqiong\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport warnings; warnings.filterwarnings(\\\"ignore\\\")\nimport numpy as np, pandas as pd, anndata as ad\nfrom scipy.optimize import nnls\n\nq = ad.read_h5ad(\\\"inputs/perturb.seq.align.q1.query.h5ad\\\")\nr = ad.read_h5ad(\\\"inputs/perturb.seq.align.q1.ref.h5ad\\\")\ncommon = q.var_names.intersection(r.var_names); q, r = q[:,common].copy(), r[:,common].copy()\ndef log1p_cpm(X):\n    X = np.asarray(X.toarray() if hasattr(X,\\\"toarray\\\") else X, dtype=np.float32)\n    s = X.sum(1); s[s==0]=1\n    return np.log1p(X*(1e4/s[:,None]))\nqX, rX = log1p_cpm(q.X), log1p_cpm(r.X)\nql = q.obs[\\\"guide\\\"].astype(str).values; rl = r.obs[\\\"guide\\\"].astype(str).values\ntg = r.obs[\\\"target_gene\\\"].astype(str).values\nqnt = qX[[s.startswith(\\\"NT\\\") for s in ql]].mean(0)\nrnt = rX[[s.startswith(\\\"NT\\\") for s in rl]].mean(0)\nrs_g = {g: rX[rl==g].mean(0)-rnt for g in pd.unique(rl) if not g.startswith(\\\"NT\\\")}\ngog = dict(zip(rl, tg))\ngenes = sorted(set(tg)-{\\\"NT\\\"})\nrs = {t: np.mean([rs_g[g] for g in rs_g if gog[g]==t],0) for t in genes}\nqs = {g: qX[ql==g].mean(0)-qnt for g in pd.unique(ql) if not g.startswith(\\\"NT\\\")}\nqn = {g: int((ql==g).sum()) for g in qs}\nqo = sorted(qs, key=lambda g:int(g.replace(\\\"guide\\\",\\\"\\\")))\n\nS = np.vstack([rs[t] for t in genes])\nN = np.vstack([rX[(rl==g)].mean(0)-rnt for g in pd.unique(rl) if g.startswith(\\\"NT\\\")])\nf = S.var(0)/(N.var(0)+1e-8)\nfi = np.argsort(f)[::-1][:1500]\nR = np.vstack([rs[t][fi] for t in genes]).T  # features x genes\n\ndef pearson(A,B):\n    A=A-A.mean(1,keepdims=True); B=B-B.mean(1,keepdims=True)\n    return (A/np.linalg.norm(A,axis=1,keepdims=True))@(B/np.linalg.norm(B,axis=1,keepdims=True)).T\nRm = np.vstack([rs[t][fi] for t in genes])\nQ = np.vstack([qs[g][fi] for g in qo])\nC = pearson(Q, Rm)\n\nrows = []\nfor i,g in enumerate(qo):\n    w,_ = nnls(R, qs[g][fi])\n    tot = w.sum()\n    wn = w/tot if tot>0 else w\n    a_nnls = genes[int(np.argmax(wn))]\n    a_pear = genes[int(np.argmax(C[i]))]\n    rows.append((g, qn[g], a_pear, round(float(C[i].max()),3), a_nnls, round(float(wn.max()),3)))\nprint(f\\\"{'guide':9s} {'n':>4s}  {'pearson':22s} {'nnls':22s}\\\")\nfor g,n,ap,rp,an,rn_ in rows:\n    flag = \\\"\\\" if ap==an else \\\"  <-- differ\\\"\n    print(f\\\"{g:9s} {n:4d}  {ap+'='+str(rp):22s} {an+'='+str(rn_):22s}{flag}\\\")\nprint(\\\"\\\\nagreement:\\\", sum(1 for r_ in rows if r_[2]==r_[4]), \\\"/\\\", len(rows))\nfrom collections import Counter\nprint(\\\"nnls multihit:\\\", {g:n for g,n in Counter(r_[4] for r_ in rows).items() if n>1})\nprint(\\\"nnls LEO1 guide:\\\", [r_[0] for r_ in rows if r_[4]==\\\"LEO1\\\"])\nprint(\\\"nnls PABPC1 guide:\\\", [r_[0] for r_ in rows if r_[4]==\\\"PABPC1\\\"])\nprint(\\\"nnls NUDT21 guide:\\\", [r_[0] for r_ in rows if r_[4]==\\\"NUDT21\\\"])\n'@ | Set-Content -Encoding utf8 scratch_nnls.py; python scratch_nnls.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
